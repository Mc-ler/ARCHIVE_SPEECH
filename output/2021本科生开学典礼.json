{
  "source": "output\\2021本科生开学典礼.srt",
  "segments": [
    {
      "id": 1,
      "start": 6.38,
      "end": 7.62,
      "duration": 1.2400000000000002,
      "text": "亲爱的同学们"
    },
    {
      "id": 2,
      "start": 8.36,
      "end": 10.64,
      "duration": 2.280000000000001,
      "text": "各位老师 大家上午好"
    },
    {
      "id": 3,
      "start": 15.88,
      "end": 19.04,
      "duration": 3.1599999999999984,
      "text": "今年是一个不寻常的年份"
    },
    {
      "id": 4,
      "start": 19.84,
      "end": 23.66,
      "duration": 3.8200000000000003,
      "text": "因为今年是我们建党一百周年"
    },
    {
      "id": 5,
      "start": 25.0,
      "end": 31.0,
      "duration": 6.0,
      "text": "也是我们完成第一个百年计划的结束之年"
    },
    {
      "id": 6,
      "start": 31.76,
      "end": 39.66,
      "duration": 7.899999999999995,
      "text": "更是我们迈向新征程 实现民族伟大复兴新征程的起始之年"
    },
    {
      "id": 7,
      "start": 41.14,
      "end": 43.74,
      "duration": 2.6000000000000014,
      "text": "所以在这样一个历史的重要时刻"
    },
    {
      "id": 8,
      "start": 44.3,
      "end": 47.0,
      "duration": 2.700000000000003,
      "text": "你们走进了大学的校门"
    },
    {
      "id": 9,
      "start": 49.04,
      "end": 51.08,
      "duration": 2.039999999999999,
      "text": "这是一个值得纪念的日子"
    },
    {
      "id": 10,
      "start": 52.28,
      "end": 58.6,
      "duration": 6.32,
      "text": "也许在若干年以后 当你们回首往事的时候 会为自己在这样一个重要的时刻"
    },
    {
      "id": 11,
      "start": 58.6,
      "end": 61.26,
      "duration": 2.6599999999999966,
      "text": "进入大学校门而感到自豪"
    },
    {
      "id": 12,
      "start": 61.26,
      "end": 66.87,
      "duration": 5.6100000000000065,
      "text": "但是进入大学以后当如何做"
    },
    {
      "id": 13,
      "start": 68.43,
      "end": 75.15,
      "duration": 6.719999999999999,
      "text": "值得我们大家深刻的思考 大学是做什么的"
    },
    {
      "id": 14,
      "start": 76.19,
      "end": 78.01,
      "duration": 1.8200000000000074,
      "text": "你们进入大学以后"
    },
    {
      "id": 15,
      "start": 78.01,
      "end": 84.47,
      "duration": 6.459999999999994,
      "text": "当如何规划自己未来几年的学习历程"
    },
    {
      "id": 16,
      "start": 86.71,
      "end": 89.91,
      "duration": 3.200000000000003,
      "text": "我们需要共同完成两个任务"
    },
    {
      "id": 17,
      "start": 92.38,
      "end": 98.94,
      "duration": 6.560000000000002,
      "text": "一是孕育学生们的崇高品德"
    },
    {
      "id": 18,
      "start": 101.19,
      "end": 104.75,
      "duration": 3.5600000000000023,
      "text": "二是培育学生们的卓越才华"
    },
    {
      "id": 19,
      "start": 104.75,
      "end": 111.24,
      "duration": 6.489999999999995,
      "text": "这两项任务是需要我们大家共同来完成的"
    },
    {
      "id": 20,
      "start": 111.24,
      "end": 115.74,
      "duration": 4.5,
      "text": "何谓崇高品德"
    },
    {
      "id": 21,
      "start": 115.74,
      "end": 122.99,
      "duration": 7.25,
      "text": "品德是一种使命"
    },
    {
      "id": 22,
      "start": 123.99,
      "end": 131.79,
      "duration": 7.799999999999997,
      "text": "是一种责任 在这样一个重要的历史时刻 你们作为国家民族未来之接班人"
    },
    {
      "id": 23,
      "start": 134.08,
      "end": 136.16,
      "duration": 2.079999999999984,
      "text": "当你们进入校园的时候"
    },
    {
      "id": 24,
      "start": 136.9,
      "end": 139.6,
      "duration": 2.6999999999999886,
      "text": "如何来考虑自己的责任和使命"
    },
    {
      "id": 25,
      "start": 142.92,
      "end": 145.82,
      "duration": 2.9000000000000057,
      "text": "每一个国家 每一个民族都是如此"
    },
    {
      "id": 26,
      "start": 147.42,
      "end": 154.62,
      "duration": 7.200000000000017,
      "text": "当面对这样一个历史时刻 你们作为国家民族的希望 作为同龄人当中的佼佼者"
    },
    {
      "id": 27,
      "start": 154.62,
      "end": 156.28,
      "duration": 1.6599999999999966,
      "text": "你们走入了大学的殿堂"
    },
    {
      "id": 28,
      "start": 157.44,
      "end": 160.18,
      "duration": 2.740000000000009,
      "text": "如果你们忘却了这份使命和责任"
    },
    {
      "id": 29,
      "start": 160.72,
      "end": 163.56,
      "duration": 2.8400000000000034,
      "text": "将失去了未来人生发展的动力"
    },
    {
      "id": 30,
      "start": 165.28,
      "end": 168.28,
      "duration": 3.0,
      "text": "没有这样一份责任 没有这样一份使命"
    },
    {
      "id": 31,
      "start": 168.98,
      "end": 172.18,
      "duration": 3.200000000000017,
      "text": "不可以持久的支持你在人生道路上发展"
    },
    {
      "id": 32,
      "start": 173.02,
      "end": 180.58,
      "duration": 7.560000000000002,
      "text": "每一个成功的人士 无不是怀有这种责任和使命 而激励他一生 为国家为民族为世界"
    },
    {
      "id": 33,
      "start": 180.58,
      "end": 181.94,
      "duration": 1.3599999999999852,
      "text": "做出卓越的贡献"
    },
    {
      "id": 34,
      "start": 183.48,
      "end": 184.9,
      "duration": 1.420000000000016,
      "text": "所以品德"
    },
    {
      "id": 35,
      "start": 185.66,
      "end": 189.58,
      "duration": 3.920000000000016,
      "text": "最重要的是使命感 责任感"
    },
    {
      "id": 36,
      "start": 189.58,
      "end": 193.69,
      "duration": 4.109999999999985,
      "text": "所以在大学四年期间"
    },
    {
      "id": 37,
      "start": 194.35,
      "end": 199.81,
      "duration": 5.460000000000008,
      "text": "你们要不断的孕育 积累自己这种使命感和责任感"
    },
    {
      "id": 38,
      "start": 199.81,
      "end": 206.39,
      "duration": 6.579999999999984,
      "text": "要知道自己是这个民族之一分子 是国家未来民族的希望所在"
    },
    {
      "id": 39,
      "start": 206.39,
      "end": 211.11,
      "duration": 4.720000000000027,
      "text": "无论对自己 对家庭 对国家对民族 乃至对世界"
    },
    {
      "id": 40,
      "start": 211.59,
      "end": 214.99,
      "duration": 3.4000000000000057,
      "text": "都要我们为之而奋斗 做出我们应有的贡献"
    },
    {
      "id": 41,
      "start": 216.81,
      "end": 217.61,
      "duration": 0.8000000000000114,
      "text": "交大"
    },
    {
      "id": 42,
      "start": 218.69,
      "end": 221.59,
      "duration": 2.9000000000000057,
      "text": "《易经》云 天地交则万物通"
    },
    {
      "id": 43,
      "start": 223.17,
      "end": 226.37,
      "duration": 3.200000000000017,
      "text": "交大人应该是顶天立地之人"
    },
    {
      "id": 44,
      "start": 227.39,
      "end": 234.65,
      "duration": 7.260000000000019,
      "text": "应该担负着国家民族的希望 担负着社会未来发展的希望 而今你们走入大学校园"
    },
    {
      "id": 45,
      "start": 234.65,
      "end": 241.93,
      "duration": 7.280000000000001,
      "text": "未来的事业发展 要从今日之开始 你们一定要有这种胸怀 要有这种责任"
    },
    {
      "id": 46,
      "start": 241.93,
      "end": 243.41,
      "duration": 1.4799999999999898,
      "text": "要有这种使命感"
    },
    {
      "id": 47,
      "start": 244.69,
      "end": 251.47,
      "duration": 6.780000000000001,
      "text": "他将激励你们 一生为之而奋斗 激励你书写自己一生之辉煌"
    },
    {
      "id": 48,
      "start": 254.51,
      "end": 257.07,
      "duration": 2.5600000000000023,
      "text": "第二点 品德是什么"
    },
    {
      "id": 49,
      "start": 257.75,
      "end": 259.21,
      "duration": 1.4599999999999795,
      "text": "品德是精神"
    },
    {
      "id": 50,
      "start": 259.97,
      "end": 261.13,
      "duration": 1.1599999999999682,
      "text": "是灵魂"
    },
    {
      "id": 51,
      "start": 262.63,
      "end": 266.95,
      "duration": 4.319999999999993,
      "text": "总书记讲 一个国家一个民族没有灵魂 是没有希望的"
    },
    {
      "id": 52,
      "start": 266.95,
      "end": 273.0,
      "duration": 6.050000000000011,
      "text": "文明之传承 实际上是精神之传承"
    },
    {
      "id": 53,
      "start": 273.6,
      "end": 276.36,
      "duration": 2.759999999999991,
      "text": "文明之传承 灵魂之传承"
    },
    {
      "id": 54,
      "start": 278.34,
      "end": 281.48,
      "duration": 3.140000000000043,
      "text": "一个国家也好 一个民族也好 都是如此"
    },
    {
      "id": 55,
      "start": 282.54,
      "end": 284.48,
      "duration": 1.9399999999999977,
      "text": "一个大学更是如此"
    },
    {
      "id": 56,
      "start": 285.64,
      "end": 289.0,
      "duration": 3.3600000000000136,
      "text": "一个没有灵魂的大学 培养不出卓越的人才"
    },
    {
      "id": 57,
      "start": 291.42,
      "end": 294.82,
      "duration": 3.3999999999999773,
      "text": "所以总书记到我们西安交通大学考察"
    },
    {
      "id": 58,
      "start": 296.16,
      "end": 300.64,
      "duration": 4.479999999999961,
      "text": "深刻地阐述了西迁精神的内涵所在"
    },
    {
      "id": 59,
      "start": 301.34,
      "end": 302.3,
      "duration": 0.9600000000000364,
      "text": "总书记讲"
    },
    {
      "id": 60,
      "start": 302.76,
      "end": 304.02,
      "duration": 1.259999999999991,
      "text": "什么是西迁精神"
    },
    {
      "id": 61,
      "start": 304.5,
      "end": 307.2,
      "duration": 2.6999999999999886,
      "text": "西迁精神的核心是爱国主义"
    },
    {
      "id": 62,
      "start": 308.1,
      "end": 315.14,
      "duration": 7.039999999999964,
      "text": "精髓是听党指挥跟党走 与党和国家民族与人民同呼吸共命运"
    },
    {
      "id": 63,
      "start": 316.52,
      "end": 320.4,
      "duration": 3.8799999999999955,
      "text": "把精神和灵魂阐述的淋漓尽致"
    },
    {
      "id": 64,
      "start": 321.2,
      "end": 324.5,
      "duration": 3.3000000000000114,
      "text": "这是我们交大人创造的习仙精神"
    },
    {
      "id": 65,
      "start": 324.96,
      "end": 327.86,
      "duration": 2.900000000000034,
      "text": "列入了中国共产党精神谱系之一"
    },
    {
      "id": 66,
      "start": 328.56,
      "end": 335.06,
      "duration": 6.5,
      "text": "但同时也是我们在座的所有的老师和同学 我们应该秉承和传承的"
    },
    {
      "id": 67,
      "start": 335.06,
      "end": 337.3,
      "duration": 2.240000000000009,
      "text": "我们学校的灵魂和精神"
    },
    {
      "id": 68,
      "start": 339.24,
      "end": 346.32,
      "duration": 7.079999999999984,
      "text": "没有这样一种深刻的思考 没有这样一种 民族和国家文明之传承"
    },
    {
      "id": 69,
      "start": 347.04,
      "end": 352.76,
      "duration": 5.71999999999997,
      "text": "国家也好 民族也好 包括我们自身的大学也好 都没有希望"
    },
    {
      "id": 70,
      "start": 355.12,
      "end": 362.18,
      "duration": 7.060000000000002,
      "text": "所以在一个国家的历史发展 长河之中 最值得我们珍视的 是这种精神和灵魂"
    },
    {
      "id": 71,
      "start": 362.18,
      "end": 366.82,
      "duration": 4.639999999999986,
      "text": "一个国家之所以富强 也在于这种精神和灵魂"
    },
    {
      "id": 72,
      "start": 366.82,
      "end": 374.21,
      "duration": 7.389999999999986,
      "text": "所以大家一定要牢牢记住 我们的责任 我们的使命"
    },
    {
      "id": 73,
      "start": 374.21,
      "end": 381.57,
      "duration": 7.360000000000014,
      "text": "我们传承的精神 我们应该秉承的 我们民族自相不息的这种精神和灵魂"
    },
    {
      "id": 74,
      "start": 382.91,
      "end": 383.71000000000004,
      "duration": 0.8000000000000114,
      "text": "第二点"
    },
    {
      "id": 75,
      "start": 384.89,
      "end": 388.05,
      "duration": 3.160000000000025,
      "text": "培养卓越人才 卓越才能"
    },
    {
      "id": 76,
      "start": 389.07,
      "end": 390.05,
      "duration": 0.9800000000000182,
      "text": "如何培养"
    },
    {
      "id": 77,
      "start": 391.55,
      "end": 398.65,
      "duration": 7.099999999999966,
      "text": "在学校 主要是通过学习这个手段 来培养同学们的卓越才能"
    },
    {
      "id": 78,
      "start": 399.69,
      "end": 401.35,
      "duration": 1.660000000000025,
      "text": "学习是双向的"
    },
    {
      "id": 79,
      "start": 402.35,
      "end": 403.27,
      "duration": 0.9199999999999591,
      "text": "老师教"
    },
    {
      "id": 80,
      "start": 403.99,
      "end": 405.31,
      "duration": 1.3199999999999932,
      "text": "同学们学"
    },
    {
      "id": 81,
      "start": 406.11,
      "end": 407.97,
      "duration": 1.8600000000000136,
      "text": "但是真正落脚点"
    },
    {
      "id": 82,
      "start": 408.67,
      "end": 411.13,
      "duration": 2.4599999999999795,
      "text": "落脚在我们同学自身身上"
    },
    {
      "id": 83,
      "start": 412.09,
      "end": 416.33,
      "duration": 4.240000000000009,
      "text": "大学与高中不同之处 就在于大学是自立的"
    },
    {
      "id": 84,
      "start": 416.85,
      "end": 418.11,
      "duration": 1.259999999999991,
      "text": "要有自我约束"
    },
    {
      "id": 85,
      "start": 418.91,
      "end": 425.85,
      "duration": 6.939999999999998,
      "text": "所以第一点 学习要主动作为 主动作为"
    },
    {
      "id": 86,
      "start": 425.85,
      "end": 429.99,
      "duration": 4.139999999999986,
      "text": "你才能够深刻体会 学习给你所带来的快乐"
    },
    {
      "id": 87,
      "start": 430.59,
      "end": 433.69,
      "duration": 3.1000000000000227,
      "text": "你才知道为什么学 如何学"
    },
    {
      "id": 88,
      "start": 434.45,
      "end": 441.25,
      "duration": 6.800000000000011,
      "text": "被动的学习 是一件很痛苦的事情 因为他没有目标 没有驱动 不知道方向"
    },
    {
      "id": 89,
      "start": 441.25,
      "end": 444.27,
      "duration": 3.019999999999982,
      "text": "而主动的学习 知道我为什么学"
    },
    {
      "id": 90,
      "start": 445.77,
      "end": 447.27,
      "duration": 1.5,
      "text": "少年毛泽东"
    },
    {
      "id": 91,
      "start": 448.23,
      "end": 449.41,
      "duration": 1.1800000000000068,
      "text": "13岁的时候"
    },
    {
      "id": 92,
      "start": 450.31,
      "end": 452.07,
      "duration": 1.759999999999991,
      "text": "和他的弟弟毛泽民"
    },
    {
      "id": 93,
      "start": 453.07,
      "end": 454.77,
      "duration": 1.6999999999999886,
      "text": "以及一个亲戚家的朋友"
    },
    {
      "id": 94,
      "start": 455.73,
      "end": 457.97,
      "duration": 2.240000000000009,
      "text": "去给长辈拜年"
    },
    {
      "id": 95,
      "start": 460.47,
      "end": 465.55,
      "duration": 5.079999999999984,
      "text": "毛泽东的堂叔 问这三个孩子 你们将来要做什么人"
    },
    {
      "id": 96,
      "start": 465.55,
      "end": 471.76,
      "duration": 6.2099999999999795,
      "text": "他的弟弟和那个 亲戚家的孩子说"
    },
    {
      "id": 97,
      "start": 471.76,
      "end": 473.98,
      "duration": 2.2200000000000273,
      "text": "我要做有钱的人"
    },
    {
      "id": 98,
      "start": 475.48,
      "end": 478.92,
      "duration": 3.4399999999999977,
      "text": "他的弟弟说 我要做不受别人欺负的人"
    },
    {
      "id": 99,
      "start": 481.04,
      "end": 482.6,
      "duration": 1.5600000000000023,
      "text": "少年毛泽东"
    },
    {
      "id": 100,
      "start": 483.28,
      "end": 489.06,
      "duration": 5.78000000000003,
      "text": "说了一句 远远超出他那个年龄 所应该说的话 他说什么"
    },
    {
      "id": 101,
      "start": 490.1,
      "end": 497.22,
      "duration": 7.1200000000000045,
      "text": "我要做惊天动地之人 少年毛泽东"
    },
    {
      "id": 102,
      "start": 497.22,
      "end": 499.82,
      "duration": 2.599999999999966,
      "text": "就有这样一种雄心壮志"
    },
    {
      "id": 103,
      "start": 501.1,
      "end": 503.66,
      "duration": 2.5600000000000023,
      "text": "到他进入师范学院学习的时候"
    },
    {
      "id": 104,
      "start": 504.32,
      "end": 511.42,
      "duration": 7.100000000000023,
      "text": "他和同学定了约法三则 不谈金钱之事"
    },
    {
      "id": 105,
      "start": 512.56,
      "end": 514.44,
      "duration": 1.8800000000001091,
      "text": "不谈男女之事"
    },
    {
      "id": 106,
      "start": 515.36,
      "end": 517.62,
      "duration": 2.259999999999991,
      "text": "不谈琐碎事物之事"
    },
    {
      "id": 107,
      "start": 520.4,
      "end": 521.52,
      "duration": 1.1200000000000045,
      "text": "由此可见"
    },
    {
      "id": 108,
      "start": 522.42,
      "end": 524.76,
      "duration": 2.340000000000032,
      "text": "一个主动作为之人"
    },
    {
      "id": 109,
      "start": 525.58,
      "end": 531.64,
      "duration": 6.059999999999945,
      "text": "对他在学习成长过程当中 所产生的作用是多么重要"
    },
    {
      "id": 110,
      "start": 531.64,
      "end": 536.32,
      "duration": 4.680000000000064,
      "text": "少年毛泽东胸怀大志 进入大学时代"
    },
    {
      "id": 111,
      "start": 536.32,
      "end": 543.22,
      "duration": 6.899999999999977,
      "text": "他仍然严格要求自己主动作为 毛泽东是一个博学多才之人"
    },
    {
      "id": 112,
      "start": 543.22,
      "end": 546.24,
      "duration": 3.019999999999982,
      "text": "博览群书 通经博古"
    },
    {
      "id": 113,
      "start": 546.86,
      "end": 553.95,
      "duration": 7.090000000000032,
      "text": "所以才成为一代领袖 我之所以举这个例子 是让大家知道"
    },
    {
      "id": 114,
      "start": 553.95,
      "end": 559.01,
      "duration": 5.059999999999945,
      "text": "少年当有志 人无志不立 国无志不强"
    },
    {
      "id": 115,
      "start": 560.39,
      "end": 565.17,
      "duration": 4.779999999999973,
      "text": "所以大学学习 是一件主动作为之事"
    },
    {
      "id": 116,
      "start": 565.17,
      "end": 568.71,
      "duration": 3.5400000000000773,
      "text": "而是不是被动的（在）要求下学习"
    },
    {
      "id": 117,
      "start": 569.93,
      "end": 572.67,
      "duration": 2.740000000000009,
      "text": "如果你具备了这种主动进取之心"
    },
    {
      "id": 118,
      "start": 573.43,
      "end": 580.81,
      "duration": 7.3799999999999955,
      "text": "你一定会在学业上卓有成就 你一定会在才能的积累上 打下坚实的基础"
    },
    {
      "id": 119,
      "start": 582.01,
      "end": 588.35,
      "duration": 6.340000000000032,
      "text": "所以学习要主动作为 未来做事也是如此 当主动作为"
    },
    {
      "id": 120,
      "start": 588.35,
      "end": 596.01,
      "duration": 7.659999999999968,
      "text": "不要在别人的要求下 被动的不情愿的去做一些事情 那样毫无意义"
    },
    {
      "id": 121,
      "start": 596.89,
      "end": 604.17,
      "duration": 7.279999999999973,
      "text": "第二点主动作为 能把你学习的东西 深刻的融化在自己的血液之中"
    },
    {
      "id": 122,
      "start": 605.31,
      "end": 606.99,
      "duration": 1.6800000000000637,
      "text": "变成自己的能力"
    },
    {
      "id": 123,
      "start": 608.11,
      "end": 611.85,
      "duration": 3.740000000000009,
      "text": "被动的学习 在你的头脑当中留不下任何印象"
    },
    {
      "id": 124,
      "start": 612.69,
      "end": 615.63,
      "duration": 2.939999999999941,
      "text": "考试完后一切烟消云散"
    },
    {
      "id": 125,
      "start": 616.15,
      "end": 621.71,
      "duration": 5.560000000000059,
      "text": "只有主动作为 才能把所学知识内化为自己的能力"
    },
    {
      "id": 126,
      "start": 622.73,
      "end": 625.97,
      "duration": 3.240000000000009,
      "text": "所以学习第一点 当主动作为"
    },
    {
      "id": 127,
      "start": 627.37,
      "end": 628.17,
      "duration": 0.7999999999999545,
      "text": "第二点"
    },
    {
      "id": 128,
      "start": 629.41,
      "end": 631.49,
      "duration": 2.080000000000041,
      "text": "学习要持之以恒"
    },
    {
      "id": 129,
      "start": 632.85,
      "end": 634.57,
      "duration": 1.7200000000000273,
      "text": "有些人三分钟热度"
    },
    {
      "id": 130,
      "start": 635.63,
      "end": 642.27,
      "duration": 6.639999999999986,
      "text": "跟领导谈一次话 积极性起来了 学习了三天 遇到什么烦心的事 又放弃了学习"
    },
    {
      "id": 131,
      "start": 642.27,
      "end": 643.81,
      "duration": 1.5399999999999636,
      "text": "没有毅力"
    },
    {
      "id": 132,
      "start": 644.99,
      "end": 646.67,
      "duration": 1.67999999999995,
      "text": "不能持久地坚持下去"
    },
    {
      "id": 133,
      "start": 649.6,
      "end": 651.9,
      "duration": 2.2999999999999545,
      "text": "未来不可能达到事业之成功"
    },
    {
      "id": 134,
      "start": 653.58,
      "end": 657.26,
      "duration": 3.67999999999995,
      "text": "所有的成功人士 有一个显著特点 毅力"
    },
    {
      "id": 135,
      "start": 657.88,
      "end": 660.6,
      "duration": 2.7200000000000273,
      "text": "做任何一件事情 都是持之以恒"
    },
    {
      "id": 136,
      "start": 661.3,
      "end": 662.7,
      "duration": 1.400000000000091,
      "text": "学习更是如此"
    },
    {
      "id": 137,
      "start": 663.98,
      "end": 670.7,
      "duration": 6.720000000000027,
      "text": "大学期间 主要任务就是学习 即便是将来大学毕业 走向社会"
    },
    {
      "id": 138,
      "start": 670.7,
      "end": 677.46,
      "duration": 6.759999999999991,
      "text": "你们仍然需要学习 学习是一生的事情 只不过大学学习更重要"
    },
    {
      "id": 139,
      "start": 677.46,
      "end": 679.24,
      "duration": 1.7799999999999727,
      "text": "因为它是打基础的阶段"
    },
    {
      "id": 140,
      "start": 681.74,
      "end": 688.02,
      "duration": 6.279999999999973,
      "text": "所以要持之以恒 尤其是大一的同学们 第一学年千万放松不得"
    },
    {
      "id": 141,
      "start": 689.1,
      "end": 695.14,
      "duration": 6.039999999999964,
      "text": "因为你们久经沙场 经过了历次考试 走进了大学"
    },
    {
      "id": 142,
      "start": 695.14,
      "end": 702.7,
      "duration": 7.560000000000059,
      "text": "无论是同学们老师 甚至是家长 说孩子们总算脱离了苦海 进入了大学"
    },
    {
      "id": 143,
      "start": 702.7,
      "end": 708.38,
      "duration": 5.67999999999995,
      "text": "如果抱有这种思想 那将会耽误你未来之学业 甚至耽误你的一生"
    },
    {
      "id": 144,
      "start": 709.74,
      "end": 716.46,
      "duration": 6.720000000000027,
      "text": "大学之中最重要的是大一 大一要打下坚实的基础 形成良好的学习习惯"
    },
    {
      "id": 145,
      "start": 716.46,
      "end": 723.64,
      "duration": 7.17999999999995,
      "text": "当你主动作为乐于学习 敢于学习 喜欢学习的时候 你会觉得苦中有乐"
    },
    {
      "id": 146,
      "start": 724.4,
      "end": 730.28,
      "duration": 5.8799999999999955,
      "text": "在学习当中 你看到了未来 在学习当中 你看到了社会 在学习当中"
    },
    {
      "id": 147,
      "start": 730.28,
      "end": 732.58,
      "duration": 2.300000000000068,
      "text": "你看到了你未来发展之方向"
    },
    {
      "id": 148,
      "start": 733.34,
      "end": 738.0066666666667,
      "duration": 4.666666666666629,
      "text": "如果没有这样一个进取之心 没有这样一个持之以恒的决心"
    },
    {
      "id": 149,
      "start": 738.0066666666667,
      "end": 740.34,
      "duration": 2.3333333333333712,
      "text": "很难把四年的学业 坚持下来"
    },
    {
      "id": 150,
      "start": 740.96,
      "end": 742.76,
      "duration": 1.7999999999999545,
      "text": "大学的学业是很重的"
    },
    {
      "id": 151,
      "start": 743.26,
      "end": 746.02,
      "duration": 2.759999999999991,
      "text": "也是很苦的 学习的门类也多"
    },
    {
      "id": 152,
      "start": 746.64,
      "end": 753.66,
      "duration": 7.019999999999982,
      "text": "和高中相比 又没有约束 完全在于你自己 所以持之以恒之决心"
    },
    {
      "id": 153,
      "start": 754.12,
      "end": 761.58,
      "duration": 7.460000000000036,
      "text": "对于我们同学们来说 显得尤为重要 这也是做人成功之人 必备的因素之一"
    },
    {
      "id": 154,
      "start": 762.78,
      "end": 768.34,
      "duration": 5.560000000000059,
      "text": "所以我希望同学们从现在开始 就养成这样一个良好之习惯"
    },
    {
      "id": 155,
      "start": 769.0,
      "end": 769.8,
      "duration": 0.7999999999999545,
      "text": "第三点"
    },
    {
      "id": 156,
      "start": 770.24,
      "end": 772.28,
      "duration": 2.0399999999999636,
      "text": "学习要融会贯通"
    },
    {
      "id": 157,
      "start": 772.94,
      "end": 779.28,
      "duration": 6.339999999999918,
      "text": "表面上看你们有很多学科门类 但是相互之间构成一个完整的知识体系"
    },
    {
      "id": 158,
      "start": 779.28,
      "end": 785.4,
      "duration": 6.1200000000000045,
      "text": "你需要知道我为什么要学数学 我为什么要学物理 我为什么要学化学"
    },
    {
      "id": 159,
      "start": 785.4,
      "end": 787.6,
      "duration": 2.2000000000000455,
      "text": "我为什么要学马克思主义理论"
    },
    {
      "id": 160,
      "start": 788.2,
      "end": 793.64,
      "duration": 5.439999999999941,
      "text": "所有这一切构成一个人才未来成长必备的知识之基础"
    },
    {
      "id": 161,
      "start": 795.3,
      "end": 796.72,
      "duration": 1.4200000000000728,
      "text": "相互之间有关联"
    },
    {
      "id": 162,
      "start": 797.38,
      "end": 798.52,
      "duration": 1.1399999999999864,
      "text": "它是一个系统"
    },
    {
      "id": 163,
      "start": 799.48,
      "end": 802.34,
      "duration": 2.8600000000000136,
      "text": "所以你们要知道融会贯通"
    },
    {
      "id": 164,
      "start": 803.04,
      "end": 810.32,
      "duration": 7.280000000000086,
      "text": "如果你们掌握了这一点 你会发现各学科之间有很多相关之要素串联在一起"
    },
    {
      "id": 165,
      "start": 810.88,
      "end": 818.0,
      "duration": 7.1200000000000045,
      "text": "最后构成了一个完整社会的知识体系 尽管所学专业不同 但是大同小异都是如此"
    },
    {
      "id": 166,
      "start": 819.06,
      "end": 824.78,
      "duration": 5.720000000000027,
      "text": "所以学习学会融会贯通 你能知其然并知其所以然"
    },
    {
      "id": 167,
      "start": 824.78,
      "end": 832.22,
      "duration": 7.440000000000055,
      "text": "你能够知道知识背后的真谛所在 知识是社会客观现实现象之积累"
    },
    {
      "id": 168,
      "start": 832.22,
      "end": 839.96,
      "duration": 7.740000000000009,
      "text": "但是你们需要了解的是 通过这种现象来把握背后客观事物发展的内在规律"
    },
    {
      "id": 169,
      "start": 840.86,
      "end": 847.68,
      "duration": 6.819999999999936,
      "text": "如果你达到这一点 那说明你已经完全弄通了 你所学的这门知识"
    },
    {
      "id": 170,
      "start": 847.68,
      "end": 853.88,
      "duration": 6.2000000000000455,
      "text": "而不是简单是记住了 考试考一个高分 那就太平面化了"
    },
    {
      "id": 171,
      "start": 854.66,
      "end": 861.4,
      "duration": 6.740000000000009,
      "text": "真正要把知识变为能力 是把知识吃透 真正内化为自己的能力"
    },
    {
      "id": 172,
      "start": 861.4,
      "end": 863.26,
      "duration": 1.8600000000000136,
      "text": "这才是学知识"
    },
    {
      "id": 173,
      "start": 863.82,
      "end": 871.37,
      "duration": 7.5499999999999545,
      "text": "所以学习第三点很重要 要学会融会贯通 最后一点"
    },
    {
      "id": 174,
      "start": 871.37,
      "end": 873.61,
      "duration": 2.240000000000009,
      "text": "今天学习要学以致用"
    },
    {
      "id": 175,
      "start": 875.15,
      "end": 877.91,
      "duration": 2.759999999999991,
      "text": "学完知识 不知道所为何学"
    },
    {
      "id": 176,
      "start": 879.69,
      "end": 881.15,
      "duration": 1.4599999999999227,
      "text": "学完以后干什么"
    },
    {
      "id": 177,
      "start": 881.81,
      "end": 882.61,
      "duration": 0.8000000000000682,
      "text": "茫然"
    },
    {
      "id": 178,
      "start": 883.43,
      "end": 885.03,
      "duration": 1.6000000000000227,
      "text": "失去了学习之动力"
    },
    {
      "id": 179,
      "start": 886.25,
      "end": 893.37,
      "duration": 7.1200000000000045,
      "text": "每一门知识 都是前人的知识积累 必定为我们未来的发展 奠定坚实的基础"
    },
    {
      "id": 180,
      "start": 893.37,
      "end": 900.31,
      "duration": 6.939999999999941,
      "text": "你学每一门知识 都会找到在客观现实当中 它未来的应用场景"
    },
    {
      "id": 181,
      "start": 901.45,
      "end": 906.99,
      "duration": 5.539999999999964,
      "text": "如果你把这些融化在你的学习之中 你的学习一定会学得非常深入"
    },
    {
      "id": 182,
      "start": 908.07,
      "end": 910.93,
      "duration": 2.8599999999999,
      "text": "如果只是死记硬背 不是真学"
    },
    {
      "id": 183,
      "start": 912.68,
      "end": 918.2,
      "duration": 5.5200000000000955,
      "text": "所以要知道每一门知识 在社会未来之发展 都会有应用之处"
    },
    {
      "id": 184,
      "start": 918.2,
      "end": 925.68,
      "duration": 7.4799999999999045,
      "text": "要知道未来应用一定对现在的知识 还有更高的需求 这就是你们未来创新之处"
    },
    {
      "id": 185,
      "start": 926.84,
      "end": 933.88,
      "duration": 7.039999999999964,
      "text": "学校会给你们提供很多的场景 很多的场所 很多的机会 让你们把所学知识"
    },
    {
      "id": 186,
      "start": 933.88,
      "end": 937.84,
      "duration": 3.9600000000000364,
      "text": "和目前稍许简单的应用 具体结合起来"
    },
    {
      "id": 187,
      "start": 938.32,
      "end": 943.96,
      "duration": 5.639999999999986,
      "text": "让你们在自己的发明创造之中 去品尝知识给你们带来的快乐"
    },
    {
      "id": 188,
      "start": 943.96,
      "end": 949.08,
      "duration": 5.1200000000000045,
      "text": "去检验你们是否真正学懂弄通 老师教给你们的知识"
    },
    {
      "id": 189,
      "start": 949.6,
      "end": 956.74,
      "duration": 7.139999999999986,
      "text": "所以学习要主动作为 学习要持之以恒 学习要融会贯通 学习要学以致用"
    },
    {
      "id": 190,
      "start": 957.84,
      "end": 964.14,
      "duration": 6.2999999999999545,
      "text": "如果你们做到这一点 我相信你们 未来一定是一个成功之才"
    },
    {
      "id": 191,
      "start": 965.14,
      "end": 966.54,
      "duration": 1.3999999999999773,
      "text": "请大家记住"
    },
    {
      "id": 192,
      "start": 967.6,
      "end": 970.52,
      "duration": 2.919999999999959,
      "text": "品格也罢 才能也罢"
    },
    {
      "id": 193,
      "start": 971.1,
      "end": 976.68,
      "duration": 5.579999999999927,
      "text": "归结到最后 是一个人的整体素质 是一个人的整体的品格"
    },
    {
      "id": 194,
      "start": 976.68,
      "end": 982.08,
      "duration": 5.400000000000091,
      "text": "是一个德才兼备之人 所应该必备的之要素"
    },
    {
      "id": 195,
      "start": 983.28,
      "end": 988.9,
      "duration": 5.6200000000000045,
      "text": "忘却什么都可以 不能忘却祖国 这是我们生命之本"
    },
    {
      "id": 196,
      "start": 989.38,
      "end": 993.2,
      "duration": 3.82000000000005,
      "text": "是我们这个国家 这个民族 赖于生存之本"
    },
    {
      "id": 197,
      "start": 995.31,
      "end": 997.11,
      "duration": 1.8000000000000682,
      "text": "丢掉什么都可以"
    },
    {
      "id": 198,
      "start": 997.91,
      "end": 999.65,
      "duration": 1.740000000000009,
      "text": "但是不能丢掉事业"
    },
    {
      "id": 199,
      "start": 1000.57,
      "end": 1004.49,
      "duration": 3.919999999999959,
      "text": "事业是书写你人生未来之辉煌之载体"
    },
    {
      "id": 200,
      "start": 1005.87,
      "end": 1011.13,
      "duration": 5.259999999999991,
      "text": "你未来的无悔人生 将在你一生的事业当中得以彰显"
    },
    {
      "id": 201,
      "start": 1012.95,
      "end": 1016.15,
      "duration": 3.199999999999932,
      "text": "没有什么都可以 但是不能没有志气"
    },
    {
      "id": 202,
      "start": 1017.21,
      "end": 1023.27,
      "duration": 6.059999999999945,
      "text": "没有志气的个人 是不可能称才的 没有志气的国家 一定是趋于灭亡"
    },
    {
      "id": 203,
      "start": 1023.89,
      "end": 1027.61,
      "duration": 3.7199999999999136,
      "text": "所以总书记才强调 我们国家要自立自强"
    },
    {
      "id": 204,
      "start": 1028.75,
      "end": 1034.93,
      "duration": 6.180000000000064,
      "text": "所以真正一个成才之人 无论是一个个体 一个国家 一个群体 都是如此"
    },
    {
      "id": 205,
      "start": 1034.93,
      "end": 1039.71,
      "duration": 4.779999999999973,
      "text": "由此才推动了整个人类社会 有序的健康的持续的发展"
    },
    {
      "id": 206,
      "start": 1040.37,
      "end": 1042.37,
      "duration": 2.0,
      "text": "所以我希望同学们记住"
    },
    {
      "id": 207,
      "start": 1043.29,
      "end": 1046.31,
      "duration": 3.019999999999982,
      "text": "交大人是顶天立地之人"
    },
    {
      "id": 208,
      "start": 1046.77,
      "end": 1054.71,
      "duration": 7.940000000000055,
      "text": "交大人是西迁精神之传人 交大人是国家民族之脊梁 未来之希望"
    },
    {
      "id": 209,
      "start": 1054.71,
      "end": 1060.55,
      "duration": 5.839999999999918,
      "text": "今天你们作为新生 从今日之开始 要秉承这种理念"
    },
    {
      "id": 210,
      "start": 1061.21,
      "end": 1067.69,
      "duration": 6.480000000000018,
      "text": "坚守这种信心 我相信在未来 国家民族复兴的征途上"
    },
    {
      "id": 211,
      "start": 1067.69,
      "end": 1072.3566666666668,
      "duration": 4.6666666666667425,
      "text": "一定有你们闪光的地方 一定有你们创造的业绩"
    },
    {
      "id": 212,
      "start": 1072.3566666666668,
      "end": 1075.69,
      "duration": 3.3333333333332575,
      "text": "书写在共和国历史的发展进程之中"
    },
    {
      "id": 213,
      "start": 1075.69,
      "end": 1078.37,
      "duration": 2.6799999999998363,
      "text": "我由衷的祝福大家 谢谢同学们！"
    }
  ]
