{
  "source": "output\\2022本科生毕业演讲.srt",
  "segments": [
    {
      "id": 1,
      "start": 5.58,
      "end": 8.06,
      "duration": 2.4800000000000004,
      "text": "我还是站在这儿讲"
    },
    {
      "id": 2,
      "start": 15.56,
      "end": 20.89,
      "duration": 5.33,
      "text": "今天毕业典礼开始前我就问"
    },
    {
      "id": 3,
      "start": 21.49,
      "end": 25.61,
      "duration": 4.120000000000001,
      "text": "我说时间能不能稍微短一点"
    },
    {
      "id": 4,
      "start": 26.19,
      "end": 31.81,
      "duration": 5.619999999999997,
      "text": "我怕太阳出来晒大家 晒得很难耐"
    },
    {
      "id": 5,
      "start": 33.17,
      "end": 34.91,
      "duration": 1.7399999999999949,
      "text": "但是我特别高兴"
    },
    {
      "id": 6,
      "start": 36.15,
      "end": 42.48,
      "duration": 6.329999999999998,
      "text": "面对我们新一届的交大毕业生 老天都来帮忙"
    },
    {
      "id": 7,
      "start": 44.59,
      "end": 46.25,
      "duration": 1.6599999999999966,
      "text": "今天是阴"
    },
    {
      "id": 8,
      "start": 47.09,
      "end": 52.04,
      "duration": 4.949999999999996,
      "text": "略有小雨 想起一句诗"
    },
    {
      "id": 9,
      "start": 53.02,
      "end": 56.12,
      "duration": 3.0999999999999943,
      "text": "天若有情 天亦老"
    },
    {
      "id": 10,
      "start": 56.94,
      "end": 62.82,
      "duration": 5.880000000000003,
      "text": "我想是 人若有情 天也悲 天都哭了"
    },
    {
      "id": 11,
      "start": 62.82,
      "end": 66.68,
      "duration": 3.8600000000000065,
      "text": "抱着一份眷恋之情"
    },
    {
      "id": 12,
      "start": 68.32,
      "end": 69.92,
      "duration": 1.6000000000000085,
      "text": "在毕业之际"
    },
    {
      "id": 13,
      "start": 71.3,
      "end": 73.16,
      "duration": 1.8599999999999994,
      "text": "流下了幸福的眼泪"
    },
    {
      "id": 14,
      "start": 73.92,
      "end": 75.74,
      "duration": 1.8199999999999932,
      "text": "流下了激动的眼泪"
    },
    {
      "id": 15,
      "start": 78.26,
      "end": 85.26,
      "duration": 7.0,
      "text": "昨天晚上我看了一个新闻联播 心情久久难以平静"
    },
    {
      "id": 16,
      "start": 85.26,
      "end": 90.28,
      "duration": 5.019999999999996,
      "text": "昨天是一个值得纪念的日子"
    },
    {
      "id": 17,
      "start": 91.78,
      "end": 98.38,
      "duration": 6.599999999999994,
      "text": "是我们香港回归祖国25周年纪念日"
    },
    {
      "id": 18,
      "start": 98.38,
      "end": 104.48,
      "duration": 6.1000000000000085,
      "text": "我看到一个网友他的留言"
    },
    {
      "id": 19,
      "start": 106.2,
      "end": 108.42,
      "duration": 2.219999999999999,
      "text": "他说当国歌响起的时候"
    },
    {
      "id": 20,
      "start": 109.38,
      "end": 110.62,
      "duration": 1.240000000000009,
      "text": "我流泪了"
    },
    {
      "id": 21,
      "start": 113.62,
      "end": 114.74,
      "duration": 1.1199999999999903,
      "text": "你们小"
    },
    {
      "id": 22,
      "start": 115.34,
      "end": 116.48,
      "duration": 1.1400000000000006,
      "text": "你们可能还"
    },
    {
      "id": 23,
      "start": 117.1,
      "end": 119.58,
      "duration": 2.480000000000004,
      "text": "不知道当年香港回归的时候"
    },
    {
      "id": 24,
      "start": 120.4,
      "end": 122.22,
      "duration": 1.8199999999999932,
      "text": "那个令人激动的时刻"
    },
    {
      "id": 25,
      "start": 123.76,
      "end": 126.74,
      "duration": 2.9799999999999898,
      "text": "在帝国列强的欺辱下 我们国家"
    },
    {
      "id": 26,
      "start": 127.42,
      "end": 132.42,
      "duration": 4.999999999999986,
      "text": "饱经风霜 支离破碎"
    },
    {
      "id": 27,
      "start": 135.18,
      "end": 142.05,
      "duration": 6.8700000000000045,
      "text": "我们的国土被别人所霸占 但如今我们国家强盛了"
    },
    {
      "id": 28,
      "start": 142.71,
      "end": 148.1,
      "duration": 5.389999999999986,
      "text": "我们站起来了 被分割的国土"
    },
    {
      "id": 29,
      "start": 148.62,
      "end": 156.07,
      "duration": 7.449999999999989,
      "text": "一块又一块的 回到祖国的怀抱 当你经历这个风霜的时候"
    },
    {
      "id": 30,
      "start": 156.07,
      "end": 157.99,
      "duration": 1.920000000000016,
      "text": "你的感悟是不一样的"
    },
    {
      "id": 31,
      "start": 160.26,
      "end": 166.48,
      "duration": 6.219999999999999,
      "text": "25年的时间过去了 那是一段往事、一段经历"
    },
    {
      "id": 32,
      "start": 167.74,
      "end": 171.34,
      "duration": 3.5999999999999943,
      "text": "值得我们去缅怀 值得我们去回忆 值得我们去总结"
    },
    {
      "id": 33,
      "start": 172.16,
      "end": 174.84,
      "duration": 2.680000000000007,
      "text": "但是今天我想和同学们说的是"
    },
    {
      "id": 34,
      "start": 176.3,
      "end": 178.34,
      "duration": 2.039999999999992,
      "text": "我们来做一个约定"
    },
    {
      "id": 35,
      "start": 181.05,
      "end": 182.21,
      "duration": 1.1599999999999966,
      "text": "25年后"
    },
    {
      "id": 36,
      "start": 183.53,
      "end": 184.77,
      "duration": 1.240000000000009,
      "text": "我们再交大"
    },
    {
      "id": 37,
      "start": 185.29,
      "end": 186.33,
      "duration": 1.0400000000000205,
      "text": "再相聚"
    },
    {
      "id": 38,
      "start": 188.37,
      "end": 189.81,
      "duration": 1.4399999999999977,
      "text": "又一个25年"
    },
    {
      "id": 39,
      "start": 191.51,
      "end": 197.49,
      "duration": 5.980000000000018,
      "text": "这个25年你们将是亲历者 因为25年后"
    },
    {
      "id": 40,
      "start": 198.17,
      "end": 202.67,
      "duration": 4.5,
      "text": "正是实现我们中华民族 伟大复兴的日子"
    },
    {
      "id": 41,
      "start": 208.49,
      "end": 209.83,
      "duration": 1.3400000000000034,
      "text": "到本世纪中叶"
    },
    {
      "id": 42,
      "start": 210.99,
      "end": 216.53,
      "duration": 5.539999999999992,
      "text": "我们将实现第二个 百年目标 中华民族之伟大复兴"
    },
    {
      "id": 43,
      "start": 216.53,
      "end": 220.55,
      "duration": 4.02000000000001,
      "text": "也许是历史的巧合"
    },
    {
      "id": 44,
      "start": 221.93,
      "end": 226.07,
      "duration": 4.139999999999986,
      "text": "让这两个25年 在今天交汇在一起"
    },
    {
      "id": 45,
      "start": 227.53,
      "end": 229.17,
      "duration": 1.6399999999999864,
      "text": "我特别期待着"
    },
    {
      "id": 46,
      "start": 229.75,
      "end": 231.01,
      "duration": 1.259999999999991,
      "text": "二十五年后"
    },
    {
      "id": 47,
      "start": 231.71,
      "end": 233.13,
      "duration": 1.4199999999999875,
      "text": "在校园里头"
    },
    {
      "id": 48,
      "start": 233.71,
      "end": 238.87,
      "duration": 5.159999999999997,
      "text": "再见到那个你 你们想过吗"
    },
    {
      "id": 49,
      "start": 240.21,
      "end": 241.77,
      "duration": 1.5600000000000023,
      "text": "二十五年后的你"
    },
    {
      "id": 50,
      "start": 242.47,
      "end": 243.83,
      "duration": 1.3600000000000136,
      "text": "是一个什么样子"
    },
    {
      "id": 51,
      "start": 245.17,
      "end": 248.29,
      "duration": 3.1200000000000045,
      "text": "我之所以和大家 做这样一个约定"
    },
    {
      "id": 52,
      "start": 249.75,
      "end": 251.25,
      "duration": 1.5,
      "text": "是希望大家"
    },
    {
      "id": 53,
      "start": 252.77,
      "end": 254.11,
      "duration": 1.3400000000000034,
      "text": "仰望星空"
    },
    {
      "id": 54,
      "start": 255.57,
      "end": 256.89,
      "duration": 1.3199999999999932,
      "text": "追逐梦想"
    },
    {
      "id": 55,
      "start": 257.91,
      "end": 264.9,
      "duration": 6.989999999999952,
      "text": "心中有理想、有目标、有追求 人不可无知"
    },
    {
      "id": 56,
      "start": 265.78,
      "end": 273.32,
      "duration": 7.5400000000000205,
      "text": "人不能没有追求 没有追求就丧失了前进之动力"
    },
    {
      "id": 57,
      "start": 273.94,
      "end": 276.02,
      "duration": 2.079999999999984,
      "text": "失去了生命之价值"
    },
    {
      "id": 58,
      "start": 277.54,
      "end": 279.06,
      "duration": 1.5199999999999818,
      "text": "我特别欣赏"
    },
    {
      "id": 59,
      "start": 280.1,
      "end": 285.7,
      "duration": 5.599999999999966,
      "text": "我们中国有一个著名诗人 汪国真先生 他写的一首诗"
    },
    {
      "id": 60,
      "start": 285.7,
      "end": 289.44,
      "duration": 3.740000000000009,
      "text": "名字叫做《热爱生命》"
    },
    {
      "id": 61,
      "start": 289.44,
      "end": 293.82,
      "duration": 4.3799999999999955,
      "text": "他其中有一段是这样讲的"
    },
    {
      "id": 62,
      "start": 295.36,
      "end": 299.22,
      "duration": 3.8600000000000136,
      "text": "我不去想，是否能够成功"
    },
    {
      "id": 63,
      "start": 299.22,
      "end": 304.25,
      "duration": 5.029999999999973,
      "text": "既然选择了远方"
    },
    {
      "id": 64,
      "start": 305.23,
      "end": 308.13,
      "duration": 2.8999999999999773,
      "text": "我只顾风雨兼程"
    },
    {
      "id": 65,
      "start": 310.23,
      "end": 311.41,
      "duration": 1.1800000000000068,
      "text": "诗句很美"
    },
    {
      "id": 66,
      "start": 312.79,
      "end": 315.49,
      "duration": 2.6999999999999886,
      "text": "道出了生命的价值真谛"
    },
    {
      "id": 67,
      "start": 316.91,
      "end": 318.93,
      "duration": 2.019999999999982,
      "text": "生命的价值在于什么地方"
    },
    {
      "id": 68,
      "start": 319.75,
      "end": 321.61,
      "duration": 1.8600000000000136,
      "text": "不在于成功的那一刻"
    },
    {
      "id": 69,
      "start": 322.17,
      "end": 326.47,
      "duration": 4.300000000000011,
      "text": "而在于未成功而奋斗的历程之中"
    },
    {
      "id": 70,
      "start": 328.63,
      "end": 330.59,
      "duration": 1.9599999999999795,
      "text": "我们今天做一个约定"
    },
    {
      "id": 71,
      "start": 331.61,
      "end": 334.27,
      "duration": 2.659999999999968,
      "text": "25年后我们再相聚"
    },
    {
      "id": 72,
      "start": 335.41,
      "end": 341.23,
      "duration": 5.819999999999993,
      "text": "但真正的你们的生命价值 恰恰是在这25年的奋斗之中"
    },
    {
      "id": 73,
      "start": 341.23,
      "end": 345.85,
      "duration": 4.6200000000000045,
      "text": "在你们参与社会实践之中 所体现出来的奋斗"
    },
    {
      "id": 74,
      "start": 346.67,
      "end": 349.47,
      "duration": 2.8000000000000114,
      "text": "这是生命价值真谛之所在"
    },
    {
      "id": 75,
      "start": 350.95,
      "end": 354.45,
      "duration": 3.5,
      "text": "我希望大家记住这个约定"
    },
    {
      "id": 76,
      "start": 355.31,
      "end": 359.25,
      "duration": 3.9399999999999977,
      "text": "尽管那个时候 我可能已是90岁的老人了"
    },
    {
      "id": 77,
      "start": 360.09,
      "end": 363.77,
      "duration": 3.680000000000007,
      "text": "但是我特别期待着 那个时候不一样的你"
    },
    {
      "id": 78,
      "start": 365.25,
      "end": 367.31,
      "duration": 2.0600000000000023,
      "text": "那个时候你们恰入中年"
    },
    {
      "id": 79,
      "start": 368.57,
      "end": 375.51,
      "duration": 6.939999999999998,
      "text": "但是你们所经历的历程 是任何一代人所不可比拟的 因为在你们手中"
    },
    {
      "id": 80,
      "start": 375.51,
      "end": 378.67,
      "duration": 3.160000000000025,
      "text": "将会实现中华民族伟大复兴"
    },
    {
      "id": 81,
      "start": 380.81,
      "end": 382.89,
      "duration": 2.079999999999984,
      "text": "这样一个使命不可谓不伟大"
    },
    {
      "id": 82,
      "start": 385.71,
      "end": 388.47,
      "duration": 2.7600000000000477,
      "text": "但是前进的道路不会平坦"
    },
    {
      "id": 83,
      "start": 389.65,
      "end": 393.91,
      "duration": 4.260000000000048,
      "text": "所以我想说的第二件事 就是脚踏实地"
    },
    {
      "id": 84,
      "start": 396.58,
      "end": 400.96,
      "duration": 4.3799999999999955,
      "text": "遥望星空是心中有目标 有理想、有追求"
    },
    {
      "id": 85,
      "start": 402.4,
      "end": 405.52,
      "duration": 3.1200000000000045,
      "text": "脚踏实地 这说的是我们的行为"
    },
    {
      "id": 86,
      "start": 406.68,
      "end": 409.58,
      "duration": 2.8999999999999773,
      "text": "没有一个目标 是不经过奋斗而得来的"
    },
    {
      "id": 87,
      "start": 411.04,
      "end": 414.0,
      "duration": 2.9599999999999795,
      "text": "如何面对这样一个伟大的使命和目标"
    },
    {
      "id": 88,
      "start": 414.6,
      "end": 417.56,
      "duration": 2.9599999999999795,
      "text": "我们面对众多的挑战和困难"
    },
    {
      "id": 89,
      "start": 418.4,
      "end": 420.28,
      "duration": 1.8799999999999955,
      "text": "百年未遇之大变局"
    },
    {
      "id": 90,
      "start": 421.54,
      "end": 422.42,
      "duration": 0.8799999999999955,
      "text": "大家看到"
    },
    {
      "id": 91,
      "start": 423.38,
      "end": 429.86,
      "duration": 6.480000000000018,
      "text": "未来世界之发展 新技术革命之发展 给我们提出了前所未有的新变局"
    },
    {
      "id": 92,
      "start": 431.14,
      "end": 433.2,
      "duration": 2.0600000000000023,
      "text": "这个时代是一个伟大的时代"
    },
    {
      "id": 93,
      "start": 433.86,
      "end": 438.4,
      "duration": 4.539999999999964,
      "text": "这个时代一切一切都在重构 它是一个质的飞跃"
    },
    {
      "id": 94,
      "start": 439.34,
      "end": 445.78,
      "duration": 6.439999999999998,
      "text": "从自然科学的角度讲 我们在原来三维物理空间 有扩展到四维空间"
    },
    {
      "id": 95,
      "start": 446.46,
      "end": 448.1,
      "duration": 1.6400000000000432,
      "text": "增加了一个数字空间"
    },
    {
      "id": 96,
      "start": 448.84,
      "end": 454.72,
      "duration": 5.880000000000052,
      "text": "使得我们对自然科学的研究 更加微观 我们可以深入到微观世界"
    },
    {
      "id": 97,
      "start": 455.4,
      "end": 458.44,
      "duration": 3.0400000000000205,
      "text": "我们可以深入太空 进入宏观世界"
    },
    {
      "id": 98,
      "start": 459.22,
      "end": 460.76,
      "duration": 1.5399999999999636,
      "text": "我们的思路更开阔"
    },
    {
      "id": 99,
      "start": 461.48,
      "end": 464.42,
      "duration": 2.9399999999999977,
      "text": "所有这一切 使得各个国家骚动起来"
    },
    {
      "id": 100,
      "start": 464.9,
      "end": 471.26,
      "duration": 6.360000000000014,
      "text": "大家看到新的产业形态 不断涌现 新的秩序不断涌现 需要我们进行重构"
    },
    {
      "id": 101,
      "start": 471.26,
      "end": 473.48,
      "duration": 2.2200000000000273,
      "text": "一切都在变动之中"
    },
    {
      "id": 102,
      "start": 473.98,
      "end": 476.92,
      "duration": 2.9399999999999977,
      "text": "孕育着一个新的时代的来临"
    },
    {
      "id": 103,
      "start": 477.82,
      "end": 481.38,
      "duration": 3.5600000000000023,
      "text": "而这一切都是需要经过奋斗来实现"
    },
    {
      "id": 104,
      "start": 482.56,
      "end": 485.02,
      "duration": 2.4599999999999795,
      "text": "我不知道25年以后是一个什么样子"
    },
    {
      "id": 105,
      "start": 485.6,
      "end": 492.34,
      "duration": 6.739999999999952,
      "text": "我很难预测未来25年 我们的国家乃至世界 会变成一个什么样的新的形象"
    },
    {
      "id": 106,
      "start": 493.48,
      "end": 498.32,
      "duration": 4.839999999999975,
      "text": "但无论如何 任何未来的目标是在你们手中实现的"
    },
    {
      "id": 107,
      "start": 499.46,
      "end": 504.66,
      "duration": 5.2000000000000455,
      "text": "你们将把你们的青春年华和这个伟大的时代同步进行"
    },
    {
      "id": 108,
      "start": 505.68,
      "end": 510.9,
      "duration": 5.21999999999997,
      "text": "所以我特别期待的同志们、同学们 当你们走向社会"
    },
    {
      "id": 109,
      "start": 511.7,
      "end": 517.38,
      "duration": 5.680000000000007,
      "text": "你们一定要经得起困难、挑战与挫折"
    },
    {
      "id": 110,
      "start": 518.84,
      "end": 521.6,
      "duration": 2.759999999999991,
      "text": "任何目标的实现都不是轻而易举的"
    },
    {
      "id": 111,
      "start": 522.5,
      "end": 525.34,
      "duration": 2.840000000000032,
      "text": "当面对困难的时候 你如何应对"
    },
    {
      "id": 112,
      "start": 525.86,
      "end": 528.5,
      "duration": 2.6399999999999864,
      "text": "当面对挑战的时候 你什么心态"
    },
    {
      "id": 113,
      "start": 529.62,
      "end": 532.52,
      "duration": 2.8999999999999773,
      "text": "当面对挫折的时候 你是否败下阵来"
    },
    {
      "id": 114,
      "start": 533.04,
      "end": 536.04,
      "duration": 3.0,
      "text": "一切一切都在你们眼前"
    },
    {
      "id": 115,
      "start": 538.12,
      "end": 540.08,
      "duration": 1.9600000000000364,
      "text": "你们必须要有充分的准备"
    },
    {
      "id": 116,
      "start": 542.37,
      "end": 543.31,
      "duration": 0.9399999999999409,
      "text": "困难是什么"
    },
    {
      "id": 117,
      "start": 544.13,
      "end": 545.33,
      "duration": 1.2000000000000455,
      "text": "挑战是什么"
    },
    {
      "id": 118,
      "start": 545.93,
      "end": 548.17,
      "duration": 2.240000000000009,
      "text": "挫折是什么 不要惧怕"
    },
    {
      "id": 119,
      "start": 548.95,
      "end": 553.69,
      "duration": 4.740000000000009,
      "text": "人的一生 就是伴随着困难 挑战与挫折前行的"
    },
    {
      "id": 120,
      "start": 554.87,
      "end": 556.89,
      "duration": 2.019999999999982,
      "text": "没有一个人不经历这一切"
    },
    {
      "id": 121,
      "start": 557.75,
      "end": 560.23,
      "duration": 2.480000000000018,
      "text": "有些人倒下了 那是弱者"
    },
    {
      "id": 122,
      "start": 560.93,
      "end": 562.61,
      "duration": 1.6800000000000637,
      "text": "有些人继续前行"
    },
    {
      "id": 123,
      "start": 563.03,
      "end": 564.11,
      "duration": 1.080000000000041,
      "text": "那是强者"
    },
    {
      "id": 124,
      "start": 565.53,
      "end": 567.47,
      "duration": 1.9400000000000546,
      "text": "挫折、困难、挑战"
    },
    {
      "id": 125,
      "start": 568.13,
      "end": 569.91,
      "duration": 1.7799999999999727,
      "text": "对强者是一种历练"
    },
    {
      "id": 126,
      "start": 571.35,
      "end": 573.09,
      "duration": 1.740000000000009,
      "text": "对弱者是一种击垮"
    },
    {
      "id": 127,
      "start": 574.43,
      "end": 576.47,
      "duration": 2.0400000000000773,
      "text": "很多人在困难挑战面前"
    },
    {
      "id": 128,
      "start": 577.37,
      "end": 579.59,
      "duration": 2.2200000000000273,
      "text": "败下阵来 成为失败者"
    },
    {
      "id": 129,
      "start": 580.57,
      "end": 583.47,
      "duration": 2.8999999999999773,
      "text": "很多人把困难、挑战"
    },
    {
      "id": 130,
      "start": 584.53,
      "end": 587.35,
      "duration": 2.82000000000005,
      "text": "乃至挫折 变成自己的力量"
    },
    {
      "id": 131,
      "start": 588.13,
      "end": 589.73,
      "duration": 1.6000000000000227,
      "text": "我不知道大家想过没有"
    },
    {
      "id": 132,
      "start": 590.99,
      "end": 593.09,
      "duration": 2.1000000000000227,
      "text": "你知道自己有多大潜能吗"
    },
    {
      "id": 133,
      "start": 594.35,
      "end": 596.15,
      "duration": 1.7999999999999545,
      "text": "可能你自己未必知道"
    },
    {
      "id": 134,
      "start": 598.5,
      "end": 601.94,
      "duration": 3.4400000000000546,
      "text": "人的潜能什么时候 才能够真正地爆发出来"
    },
    {
      "id": 135,
      "start": 602.58,
      "end": 609.92,
      "duration": 7.339999999999918,
      "text": "恰恰是在经历困难 经历挑战 乃至挫折的时候 得到了极大的激发和释放"
    },
    {
      "id": 136,
      "start": 611.38,
      "end": 619.22,
      "duration": 7.840000000000032,
      "text": "你仔细去品味 人的才能 人的潜能 恰恰是在应对这种困难 挫折与挑战的时候"
    },
    {
      "id": 137,
      "start": 619.22,
      "end": 621.56,
      "duration": 2.339999999999918,
      "text": "得到了极大的激发与释放"
    },
    {
      "id": 138,
      "start": 622.36,
      "end": 625.54,
      "duration": 3.17999999999995,
      "text": "从某种意义上说 人的潜能是无限的"
    },
    {
      "id": 139,
      "start": 626.12,
      "end": 633.04,
      "duration": 6.919999999999959,
      "text": "就看你敢不敢于面对困难 面对挫折、面对挑战 直面它、并且战胜它"
    },
    {
      "id": 140,
      "start": 635.29,
      "end": 637.79,
      "duration": 2.5,
      "text": "所以我说要相信自己"
    },
    {
      "id": 141,
      "start": 638.53,
      "end": 642.01,
      "duration": 3.480000000000018,
      "text": "要正确地认识困难、挫折与挑战"
    },
    {
      "id": 142,
      "start": 642.83,
      "end": 650.27,
      "duration": 7.439999999999941,
      "text": "要客观地分析困难、挫折与挑战 要及时的总结 你所经历的困难"
    },
    {
      "id": 143,
      "start": 650.27,
      "end": 658.09,
      "duration": 7.82000000000005,
      "text": "挫折与挑战 所带给你们真正的 内在的财富 那就是一种能力的融合"
    },
    {
      "id": 144,
      "start": 660.49,
      "end": 665.99,
      "duration": 5.5,
      "text": "把经历的这一切 经过反思 内化为自己的能力"
    },
    {
      "id": 145,
      "start": 666.85,
      "end": 670.05,
      "duration": 3.199999999999932,
      "text": "所以我希望同学们 有所准备"
    },
    {
      "id": 146,
      "start": 670.75,
      "end": 678.49,
      "duration": 7.740000000000009,
      "text": "增强自信 敢于面对困难 挫折与挑战 在未来实现民族复兴的"
    },
    {
      "id": 147,
      "start": 678.49,
      "end": 681.41,
      "duration": 2.919999999999959,
      "text": "伟大征程中去展示 你们的才华"
    },
    {
      "id": 148,
      "start": 683.04,
      "end": 684.82,
      "duration": 1.7800000000000864,
      "text": "如何能做到这一点"
    },
    {
      "id": 149,
      "start": 686.14,
      "end": 687.36,
      "duration": 1.2200000000000273,
      "text": "我和大家讲"
    },
    {
      "id": 150,
      "start": 688.26,
      "end": 690.34,
      "duration": 2.080000000000041,
      "text": "一个人要善于反思"
    },
    {
      "id": 151,
      "start": 691.02,
      "end": 693.22,
      "duration": 2.2000000000000455,
      "text": "有些人在 一个地方摔倒了"
    },
    {
      "id": 152,
      "start": 693.78,
      "end": 696.72,
      "duration": 2.9400000000000546,
      "text": "在同一个地方又摔倒了 为什么"
    },
    {
      "id": 153,
      "start": 697.24,
      "end": 705.14,
      "duration": 7.899999999999977,
      "text": "因为他没有总结失败之经验教训 毛主席 说过一句话 我希望大家深刻的理解"
    },
    {
      "id": 154,
      "start": 705.92,
      "end": 710.82,
      "duration": 4.900000000000091,
      "text": "“错误和挫折教训了我们 使得我们变得更加聪明起来”"
    },
    {
      "id": 155,
      "start": 711.58,
      "end": 713.04,
      "duration": 1.4599999999999227,
      "text": "讲的就是这个道理"
    },
    {
      "id": 156,
      "start": 713.68,
      "end": 716.96,
      "duration": 3.2800000000000864,
      "text": "吃一堑长一智 讲的也是这个道理"
    },
    {
      "id": 157,
      "start": 717.52,
      "end": 718.98,
      "duration": 1.4600000000000364,
      "text": "要善于反思自己"
    },
    {
      "id": 158,
      "start": 719.56,
      "end": 722.84,
      "duration": 3.2800000000000864,
      "text": "人总是要犯错的 没有不犯错误之人"
    },
    {
      "id": 159,
      "start": 723.3,
      "end": 729.58,
      "duration": 6.280000000000086,
      "text": "最可怕之处 他犯了错误不觉 再犯第二次错误 而且是犯的同样的错误"
    },
    {
      "id": 160,
      "start": 730.56,
      "end": 733.72,
      "duration": 3.160000000000082,
      "text": "所以人的经历挫折 是一件好事"
    },
    {
      "id": 161,
      "start": 734.18,
      "end": 737.92,
      "duration": 3.740000000000009,
      "text": "激发你的潜能 让你变得更睿智、更聪明"
    },
    {
      "id": 162,
      "start": 738.66,
      "end": 745.2,
      "duration": 6.540000000000077,
      "text": "但是可怕之处 就是犯了错不觉 还以为自己是对的 甚至明知有错"
    },
    {
      "id": 163,
      "start": 745.2,
      "end": 749.3,
      "duration": 4.099999999999909,
      "text": "还掩盖自己的错误 那你注定会成为一个失败者"
    },
    {
      "id": 164,
      "start": 750.48,
      "end": 755.5,
      "duration": 5.019999999999982,
      "text": "我希望同学们 做生命之中强者 热爱生命"
    },
    {
      "id": 165,
      "start": 755.98,
      "end": 758.28,
      "duration": 2.2999999999999545,
      "text": "就像汪国真先生诗中所讲"
    },
    {
      "id": 166,
      "start": 758.82,
      "end": 761.04,
      "duration": 2.2199999999999136,
      "text": "我不去想是否能够成功"
    },
    {
      "id": 167,
      "start": 761.64,
      "end": 765.74,
      "duration": 4.100000000000023,
      "text": "既然选择了远方 便只顾风雨兼行"
    },
    {
      "id": 168,
      "start": 766.38,
      "end": 769.66,
      "duration": 3.2799999999999727,
      "text": "生命的价值 就存在于奋斗之中"
    },
    {
      "id": 169,
      "start": 770.66,
      "end": 771.54,
      "duration": 0.8799999999999955,
      "text": "我希望"
    },
    {
      "id": 170,
      "start": 772.28,
      "end": 773.72,
      "duration": 1.4400000000000546,
      "text": "25年后的你们"
    },
    {
      "id": 171,
      "start": 774.52,
      "end": 780.26,
      "duration": 5.740000000000009,
      "text": "再回校园 大家相聚 回首你们过往的25年"
    },
    {
      "id": 172,
      "start": 780.8,
      "end": 788.42,
      "duration": 7.6200000000000045,
      "text": "总结你们走过的历程 向老师汇报 你们为这个梦想 所做出的杰出的贡献"
    },
    {
      "id": 173,
      "start": 788.42,
      "end": 790.2,
      "duration": 1.7800000000000864,
      "text": "和努力（挥）洒的汗水"
    },
    {
      "id": 174,
      "start": 790.88,
      "end": 791.68,
      "duration": 0.7999999999999545,
      "text": "我知道"
    },
    {
      "id": 175,
      "start": 791.86,
      "end": 798.92,
      "duration": 7.059999999999945,
      "text": "那个时刻 一定是幸福的 因为在民族复兴的道路上 有你们的汗水"
    },
    {
      "id": 176,
      "start": 798.92,
      "end": 801.6,
      "duration": 2.6800000000000637,
      "text": "有你们的贡献 有你们的业绩"
    },
    {
      "id": 177,
      "start": 802.24,
      "end": 805.06,
      "duration": 2.8199999999999363,
      "text": "那个时候 你们可以自豪地说"
    },
    {
      "id": 178,
      "start": 806.54,
      "end": 808.28,
      "duration": 1.740000000000009,
      "text": "我无愧于社会"
    },
    {
      "id": 179,
      "start": 808.84,
      "end": 810.48,
      "duration": 1.6399999999999864,
      "text": "我无愧于祖国"
    },
    {
      "id": 180,
      "start": 811.04,
      "end": 812.64,
      "duration": 1.6000000000000227,
      "text": "我无愧于母校"
    },
    {
      "id": 181,
      "start": 813.24,
      "end": 815.12,
      "duration": 1.8799999999999955,
      "text": "我无愧于生命"
    },
    {
      "id": 182,
      "start": 816.58,
      "end": 819.36,
      "duration": 2.7799999999999727,
      "text": "我是真正的交大人"
    },
    {
      "id": 183,
      "start": 819.86,
      "end": 824.7,
      "duration": 4.840000000000032,
      "text": "由衷地祝福大家 二十五年后 我们再相聚 谢谢大家！"
    }
  ]
}