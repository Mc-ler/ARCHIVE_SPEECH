{
  "source": "output\\2020年研究生开学典礼.srt",
  "segments": [
    {
      "id": 1,
      "start": 7.31,
      "end": 12.31,
      "duration": 5.000000000000001,
      "text": "我还是站在这儿讲更好一点"
    },
    {
      "id": 2,
      "start": 13.61,
      "end": 16.25,
      "duration": 2.6400000000000006,
      "text": "因为站在这儿大家就看不到我了"
    },
    {
      "id": 3,
      "start": 20.82,
      "end": 22.19,
      "duration": 1.370000000000001,
      "text": "我非常高兴"
    },
    {
      "id": 4,
      "start": 24.51,
      "end": 30.64,
      "duration": 6.129999999999999,
      "text": "一早走来我看到那么多年轻的面庞 我就非常激动"
    },
    {
      "id": 5,
      "start": 30.64,
      "end": 35.77,
      "duration": 5.130000000000003,
      "text": "刚才我们的新生代表"
    },
    {
      "id": 6,
      "start": 36.93,
      "end": 40.15,
      "duration": 3.219999999999999,
      "text": "他说来来自于北大的本科"
    },
    {
      "id": 7,
      "start": 42.19,
      "end": 48.75,
      "duration": 6.560000000000002,
      "text": "大家有一点点骚动 比前几年强多了"
    },
    {
      "id": 8,
      "start": 48.75,
      "end": 55.09,
      "duration": 6.340000000000003,
      "text": "前几年新生代表说 我来自于清华 大家就哇 就这样"
    },
    {
      "id": 9,
      "start": 57.14,
      "end": 59.1,
      "duration": 1.9600000000000009,
      "text": "但是我也期待着有一天"
    },
    {
      "id": 10,
      "start": 59.78,
      "end": 66.34,
      "duration": 6.560000000000002,
      "text": "你们站在北大新生代表的讲台上 说我来自于西安交大 大家说哇 这样"
    },
    {
      "id": 11,
      "start": 66.34,
      "end": 72.045,
      "duration": 5.704999999999998,
      "text": "这是一个非"
    },
    {
      "id": 12,
      "start": 72.045,
      "end": 77.75,
      "duration": 5.704999999999998,
      "text": "常好的现象"
    },
    {
      "id": 13,
      "start": 77.75,
      "end": 82.47,
      "duration": 4.719999999999999,
      "text": "因为它是多个学校 不同文化的交流"
    },
    {
      "id": 14,
      "start": 83.85,
      "end": 89.05,
      "duration": 5.200000000000003,
      "text": "它是一个国家大学健康成长的 一个良好的趋势"
    },
    {
      "id": 15,
      "start": 90.19,
      "end": 93.75,
      "duration": 3.5600000000000023,
      "text": "每一个大学都有它独特的文化"
    },
    {
      "id": 16,
      "start": 94.61,
      "end": 96.93,
      "duration": 2.3200000000000074,
      "text": "每一个大学都有自己的历史"
    },
    {
      "id": 17,
      "start": 97.87,
      "end": 101.41,
      "duration": 3.539999999999992,
      "text": "北大如此 清华如此 交大也是如此"
    },
    {
      "id": 18,
      "start": 101.41,
      "end": 107.0,
      "duration": 5.590000000000003,
      "text": "所以我们应该珍惜自己的文化"
    },
    {
      "id": 19,
      "start": 107.0,
      "end": 114.34,
      "duration": 7.340000000000003,
      "text": "更应该努力地去促进 不同文化的交流 交叉与融合"
    },
    {
      "id": 20,
      "start": 116.64,
      "end": 119.02,
      "duration": 2.3799999999999955,
      "text": "今天是新生开学典礼"
    },
    {
      "id": 21,
      "start": 122.25,
      "end": 124.91,
      "duration": 2.6599999999999966,
      "text": "讲些什么 我还是动了一些脑筋"
    },
    {
      "id": 22,
      "start": 126.43,
      "end": 131.54,
      "duration": 5.109999999999985,
      "text": "始终没有清晰的思路 刚才听完了"
    },
    {
      "id": 23,
      "start": 132.6,
      "end": 134.02,
      "duration": 1.420000000000016,
      "text": "我们老师代表"
    },
    {
      "id": 24,
      "start": 135.1,
      "end": 136.32,
      "duration": 1.2199999999999989,
      "text": "老生代表"
    },
    {
      "id": 25,
      "start": 137.2,
      "end": 141.08,
      "duration": 3.880000000000024,
      "text": "我们的教工代表 还有我们新生代表的发言"
    },
    {
      "id": 26,
      "start": 141.76,
      "end": 144.28,
      "duration": 2.5200000000000102,
      "text": "我的思路相对比较清晰（了）"
    },
    {
      "id": 27,
      "start": 144.28,
      "end": 150.88,
      "duration": 6.599999999999994,
      "text": "刚才代表教师发言的 郗平教授"
    },
    {
      "id": 28,
      "start": 152.3,
      "end": 154.12,
      "duration": 1.8199999999999932,
      "text": "大家看上去很年轻"
    },
    {
      "id": 29,
      "start": 154.12,
      "end": 160.46,
      "duration": 6.340000000000003,
      "text": "但他是一个做基础数学研究的人"
    },
    {
      "id": 30,
      "start": 164.04,
      "end": 166.2,
      "duration": 2.1599999999999966,
      "text": "很长一段时间默默无闻"
    },
    {
      "id": 31,
      "start": 166.2,
      "end": 173.29,
      "duration": 7.090000000000003,
      "text": "但他是一个主动进取的人"
    },
    {
      "id": 32,
      "start": 174.35,
      "end": 176.65,
      "duration": 2.3000000000000114,
      "text": "他深爱着自己的研究领域"
    },
    {
      "id": 33,
      "start": 180.39,
      "end": 187.73,
      "duration": 7.340000000000003,
      "text": "所以不明则已，一鸣惊人 他在基础学科领域取得了重大突破"
    },
    {
      "id": 34,
      "start": 188.57,
      "end": 191.83,
      "duration": 3.2600000000000193,
      "text": "在数学国际顶级的学术期刊上"
    },
    {
      "id": 35,
      "start": 192.59,
      "end": 197.23,
      "duration": 4.639999999999986,
      "text": "刊发了长达65页的学术论文"
    },
    {
      "id": 36,
      "start": 203.47,
      "end": 208.23,
      "duration": 4.759999999999991,
      "text": "在国际数学界引起了很大的反响"
    },
    {
      "id": 37,
      "start": 209.63,
      "end": 213.29,
      "duration": 3.6599999999999966,
      "text": "基础数学非常之枯燥"
    },
    {
      "id": 38,
      "start": 213.29,
      "end": 217.91,
      "duration": 4.6200000000000045,
      "text": "郗平老师为什么能坚持下去"
    },
    {
      "id": 39,
      "start": 218.87,
      "end": 222.13,
      "duration": 3.259999999999991,
      "text": "就像他所说的 心中有梦想"
    },
    {
      "id": 40,
      "start": 222.87,
      "end": 227.48,
      "duration": 4.609999999999985,
      "text": "有追求 所以我们交大"
    },
    {
      "id": 41,
      "start": 228.88,
      "end": 234.84,
      "duration": 5.960000000000008,
      "text": "是一个放飞梦想的地方 是一个追逐梦想的地方"
    },
    {
      "id": 42,
      "start": 236.79,
      "end": 238.87,
      "duration": 2.0800000000000125,
      "text": "是一个文化传承的地方"
    },
    {
      "id": 43,
      "start": 240.43,
      "end": 242.29,
      "duration": 1.8599999999999852,
      "text": "是一个有灵魂的地方"
    },
    {
      "id": 44,
      "start": 244.59,
      "end": 246.67,
      "duration": 2.079999999999984,
      "text": "所以我说的第一点是"
    },
    {
      "id": 45,
      "start": 247.97,
      "end": 249.61,
      "duration": 1.6400000000000148,
      "text": "大学要有灵魂"
    },
    {
      "id": 46,
      "start": 250.53,
      "end": 255.03,
      "duration": 4.5,
      "text": "我们每一个同学 要做一个有灵魂的人"
    },
    {
      "id": 47,
      "start": 255.03,
      "end": 260.48,
      "duration": 5.450000000000017,
      "text": "总书记多次强调 一个国家"
    },
    {
      "id": 48,
      "start": 261.06,
      "end": 263.2,
      "duration": 2.1399999999999864,
      "text": "一个民族不能没有灵魂"
    },
    {
      "id": 49,
      "start": 264.02,
      "end": 268.84,
      "duration": 4.819999999999993,
      "text": "一个没有灵魂 没有灵魂的国家和民族 是注定要消亡的"
    },
    {
      "id": 50,
      "start": 270.34,
      "end": 271.76,
      "duration": 1.420000000000016,
      "text": "灵魂是什么"
    },
    {
      "id": 51,
      "start": 272.72,
      "end": 274.04,
      "duration": 1.3199999999999932,
      "text": "灵魂是精神"
    },
    {
      "id": 52,
      "start": 275.04,
      "end": 276.44,
      "duration": 1.3999999999999773,
      "text": "是家国情怀"
    },
    {
      "id": 53,
      "start": 278.1,
      "end": 281.42,
      "duration": 3.319999999999993,
      "text": "总书记今年4月22号 到学校来视察"
    },
    {
      "id": 54,
      "start": 282.82,
      "end": 287.52,
      "duration": 4.699999999999989,
      "text": "明确地点出了这一点 说西迁精神的核心"
    },
    {
      "id": 55,
      "start": 288.72,
      "end": 289.82,
      "duration": 1.099999999999966,
      "text": "爱国主义"
    },
    {
      "id": 56,
      "start": 291.12,
      "end": 291.98,
      "duration": 0.8600000000000136,
      "text": "精髓"
    },
    {
      "id": 57,
      "start": 292.98,
      "end": 299.62,
      "duration": 6.639999999999986,
      "text": "听党指挥跟党走 与党和国家 民族和人民 同呼吸共命运"
    },
    {
      "id": 58,
      "start": 300.12,
      "end": 303.08,
      "duration": 2.9599999999999795,
      "text": "这就是精神 这就是灵魂"
    },
    {
      "id": 59,
      "start": 305.52,
      "end": 310.74,
      "duration": 5.220000000000027,
      "text": "最近我看到一条消息 我还是非常非常震撼"
    },
    {
      "id": 60,
      "start": 313.56,
      "end": 315.32,
      "duration": 1.759999999999991,
      "text": "美国总统特朗普先生"
    },
    {
      "id": 61,
      "start": 316.76,
      "end": 322.16,
      "duration": 5.400000000000034,
      "text": "最近说 要加强美国学生的爱国主义教育"
    },
    {
      "id": 62,
      "start": 323.92,
      "end": 326.14,
      "duration": 2.2199999999999704,
      "text": "每个国家都是如此"
    },
    {
      "id": 63,
      "start": 327.76,
      "end": 331.3,
      "duration": 3.5400000000000205,
      "text": "一个不爱自己国家 不爱自己民族的人"
    },
    {
      "id": 64,
      "start": 331.92,
      "end": 334.12,
      "duration": 2.1999999999999886,
      "text": "注定会被时代所抛弃"
    },
    {
      "id": 65,
      "start": 336.43,
      "end": 337.77,
      "duration": 1.339999999999975,
      "text": "你们是年轻人"
    },
    {
      "id": 66,
      "start": 338.41,
      "end": 341.67,
      "duration": 3.259999999999991,
      "text": "是这个社会的未来 是国家和民族的希望"
    },
    {
      "id": 67,
      "start": 343.51,
      "end": 346.95,
      "duration": 3.4399999999999977,
      "text": "所以一定要叮嘱自己 不要丢掉灵魂"
    },
    {
      "id": 68,
      "start": 348.05,
      "end": 350.27,
      "duration": 2.2199999999999704,
      "text": "要做一个有家国情怀的人"
    },
    {
      "id": 69,
      "start": 351.83,
      "end": 356.99,
      "duration": 5.160000000000025,
      "text": "因为我们是我们这个国家 这个民族的一份子 我们有责任有义务"
    },
    {
      "id": 70,
      "start": 357.61,
      "end": 362.45,
      "duration": 4.839999999999975,
      "text": "为了这个国家 这个民族未来之兴旺 做出我们应有的贡献"
    },
    {
      "id": 71,
      "start": 363.03,
      "end": 364.49,
      "duration": 1.4600000000000364,
      "text": "我们既是参与者"
    },
    {
      "id": 72,
      "start": 364.99,
      "end": 367.59,
      "duration": 2.599999999999966,
      "text": "也是贡献者 也是分享者"
    },
    {
      "id": 73,
      "start": 369.22,
      "end": 371.5,
      "duration": 2.2799999999999727,
      "text": "所以大家千万不要忘记"
    },
    {
      "id": 74,
      "start": 372.22,
      "end": 373.22,
      "duration": 1.0,
      "text": "家国情怀"
    },
    {
      "id": 75,
      "start": 374.38,
      "end": 380.52,
      "duration": 6.139999999999986,
      "text": "将是你一生进步进取不竭的动力"
    },
    {
      "id": 76,
      "start": 381.62,
      "end": 388.32,
      "duration": 6.699999999999989,
      "text": "很多同学问我说 王老师 听完你一次讲话 我好几天都学习的劲头特别大"
    },
    {
      "id": 77,
      "start": 388.32,
      "end": 393.58,
      "duration": 5.259999999999991,
      "text": "但是几天过去以后 我又回去了 又觉得很乏味"
    },
    {
      "id": 78,
      "start": 394.36,
      "end": 395.68,
      "duration": 1.3199999999999932,
      "text": "到底是什么原因"
    },
    {
      "id": 79,
      "start": 397.02,
      "end": 400.18,
      "duration": 3.160000000000025,
      "text": "我说你不是听我讲话以后如何如何"
    },
    {
      "id": 80,
      "start": 401.32,
      "end": 408.65,
      "duration": 7.329999999999984,
      "text": "是要把那种家国情怀深深地扎在心里 然后你时刻不忘"
    },
    {
      "id": 81,
      "start": 408.65,
      "end": 412.57,
      "duration": 3.920000000000016,
      "text": "我是这个民族的一分子 我是这个社会之脊梁"
    },
    {
      "id": 82,
      "start": 413.33,
      "end": 420.89,
      "duration": 7.560000000000002,
      "text": "我有责任为这个国家 这个民族的复兴 做出我应有的贡献 如果你有了这个坚强的信念"
    },
    {
      "id": 83,
      "start": 421.73,
      "end": 423.35,
      "duration": 1.6200000000000045,
      "text": "将会支撑你一生"
    },
    {
      "id": 84,
      "start": 423.95,
      "end": 425.63,
      "duration": 1.6800000000000068,
      "text": "孜孜不倦地去追求"
    },
    {
      "id": 85,
      "start": 426.19,
      "end": 427.13,
      "duration": 0.9399999999999977,
      "text": "去奋斗"
    },
    {
      "id": 86,
      "start": 430.94,
      "end": 438.9,
      "duration": 7.9599999999999795,
      "text": "所以有些人半途而废 有些人知难而退 往往是这种情怀"
    },
    {
      "id": 87,
      "start": 439.76,
      "end": 442.96,
      "duration": 3.1999999999999886,
      "text": "没有牢固地在心里树立起来"
    },
    {
      "id": 88,
      "start": 443.68,
      "end": 444.74,
      "duration": 1.0600000000000023,
      "text": "所以同学们"
    },
    {
      "id": 89,
      "start": 445.42,
      "end": 447.72,
      "duration": 2.3000000000000114,
      "text": "你们一定要做一个有灵魂的人"
    },
    {
      "id": 90,
      "start": 448.38,
      "end": 450.34,
      "duration": 1.9599999999999795,
      "text": "做一个有家国情怀的人"
    },
    {
      "id": 91,
      "start": 450.94,
      "end": 452.54,
      "duration": 1.6000000000000227,
      "text": "他将让你的一生"
    },
    {
      "id": 92,
      "start": 453.58,
      "end": 456.48,
      "duration": 2.900000000000034,
      "text": "绽放绚烂的光彩"
    },
    {
      "id": 93,
      "start": 460.12,
      "end": 462.46,
      "duration": 2.339999999999975,
      "text": "第二点 大家要做一个"
    },
    {
      "id": 94,
      "start": 463.32,
      "end": 464.96,
      "duration": 1.6399999999999864,
      "text": "走在时间前面的人"
    },
    {
      "id": 95,
      "start": 466.1,
      "end": 467.22,
      "duration": 1.1200000000000045,
      "text": "我们很幸运"
    },
    {
      "id": 96,
      "start": 468.06,
      "end": 470.14,
      "duration": 2.079999999999984,
      "text": "我们赶上了一个伟大的时代"
    },
    {
      "id": 97,
      "start": 471.86,
      "end": 475.14,
      "duration": 3.2799999999999727,
      "text": "很多世界著名的政治家"
    },
    {
      "id": 98,
      "start": 475.7,
      "end": 478.0,
      "duration": 2.3000000000000114,
      "text": "学者都在讲"
    },
    {
      "id": 99,
      "start": 478.72,
      "end": 486.1,
      "duration": 7.3799999999999955,
      "text": "我们遇到了一个 百年未遇之大变局 第四次工业革命"
    },
    {
      "id": 100,
      "start": 487.16,
      "end": 488.22,
      "duration": 1.0600000000000023,
      "text": "扑面而来"
    },
    {
      "id": 101,
      "start": 489.54,
      "end": 492.06,
      "duration": 2.519999999999982,
      "text": "深刻地改变着这个社会"
    },
    {
      "id": 102,
      "start": 494.07,
      "end": 496.51,
      "duration": 2.4399999999999977,
      "text": "每一个人 每一个角落"
    },
    {
      "id": 103,
      "start": 497.59,
      "end": 499.85,
      "duration": 2.2600000000000477,
      "text": "都在经受着这次巨大的改变"
    },
    {
      "id": 104,
      "start": 501.11,
      "end": 504.77,
      "duration": 3.659999999999968,
      "text": "而我们是亲身经历者 又是参与着"
    },
    {
      "id": 105,
      "start": 506.15,
      "end": 512.77,
      "duration": 6.6200000000000045,
      "text": "第四次工业革命 不同于以往任何一次革命 它是一个全方位的 多领域的"
    },
    {
      "id": 106,
      "start": 512.77,
      "end": 517.21,
      "duration": 4.440000000000055,
      "text": "几乎社会的每一个角落 都受到影响和冲击的"
    },
    {
      "id": 107,
      "start": 517.67,
      "end": 520.27,
      "duration": 2.6000000000000227,
      "text": "这样一次新的技术革命"
    },
    {
      "id": 108,
      "start": 521.69,
      "end": 525.11,
      "duration": 3.419999999999959,
      "text": "它将改变人类社会 未来的发展形态"
    },
    {
      "id": 109,
      "start": 526.81,
      "end": 527.85,
      "duration": 1.0400000000000773,
      "text": "如何改变"
    },
    {
      "id": 110,
      "start": 528.51,
      "end": 531.43,
      "duration": 2.919999999999959,
      "text": "现在还没有一个人 能说得清楚"
    },
    {
      "id": 111,
      "start": 532.23,
      "end": 533.77,
      "duration": 1.5399999999999636,
      "text": "但是我们感受到了"
    },
    {
      "id": 112,
      "start": 534.27,
      "end": 538.07,
      "duration": 3.800000000000068,
      "text": "每时每刻 这个社会都在发生着变革"
    },
    {
      "id": 113,
      "start": 539.6,
      "end": 541.12,
      "duration": 1.5199999999999818,
      "text": "技术在进步"
    },
    {
      "id": 114,
      "start": 541.72,
      "end": 543.1,
      "duration": 1.3799999999999955,
      "text": "思想在进步"
    },
    {
      "id": 115,
      "start": 543.54,
      "end": 549.1616216216216,
      "duration": 5.621621621621671,
      "text": "社会的形态 在每时每刻的发生着改变 我们在不断地适应"
    },
    {
      "id": 116,
      "start": 549.1616216216216,
      "end": 551.54,
      "duration": 2.378378378378329,
      "text": "节奏之快超出我们的想象"
    },
    {
      "id": 117,
      "start": 552.96,
      "end": 554.42,
      "duration": 1.4599999999999227,
      "text": "而恰恰在这个时候"
    },
    {
      "id": 118,
      "start": 555.3,
      "end": 558.0,
      "duration": 2.7000000000000455,
      "text": "你们迈入了西安交通大学"
    },
    {
      "id": 119,
      "start": 559.38,
      "end": 563.48,
      "duration": 4.100000000000023,
      "text": "你们将会亲身在这样一个背景下 去学习去奋斗"
    },
    {
      "id": 120,
      "start": 566.83,
      "end": 568.47,
      "duration": 1.6399999999999864,
      "text": "时间对于我们来说"
    },
    {
      "id": 121,
      "start": 569.19,
      "end": 570.17,
      "duration": 0.9799999999999045,
      "text": "太宝贵了"
    },
    {
      "id": 122,
      "start": 571.75,
      "end": 575.43,
      "duration": 3.67999999999995,
      "text": "我坦率地跟大家讲 这个社会发展是不平静的"
    },
    {
      "id": 123,
      "start": 576.83,
      "end": 578.41,
      "duration": 1.5799999999999272,
      "text": "在第四次工业革命"
    },
    {
      "id": 124,
      "start": 578.95,
      "end": 586.31,
      "duration": 7.3599999999999,
      "text": "大力推动下整个社会在向前 向好的方向在进步 但同时正是由于这种改变"
    },
    {
      "id": 125,
      "start": 586.31,
      "end": 588.41,
      "duration": 2.1000000000000227,
      "text": "带来了各种思潮的冲击"
    },
    {
      "id": 126,
      "start": 591.42,
      "end": 592.44,
      "duration": 1.0200000000000955,
      "text": "单边主义"
    },
    {
      "id": 127,
      "start": 594.71,
      "end": 597.87,
      "duration": 3.159999999999968,
      "text": "脱离社会群体的现象 也频频发生"
    },
    {
      "id": 128,
      "start": 599.61,
      "end": 603.51,
      "duration": 3.8999999999999773,
      "text": "大家忘记了 人类文明真正的价值所在"
    },
    {
      "id": 129,
      "start": 604.01,
      "end": 610.3,
      "duration": 6.289999999999964,
      "text": "是互相关爱 忘记了人类赖以生存的价值基础"
    },
    {
      "id": 130,
      "start": 613.04,
      "end": 615.98,
      "duration": 2.9400000000000546,
      "text": "所以在这样一个背景下 我们当如何"
    },
    {
      "id": 131,
      "start": 616.72,
      "end": 620.58,
      "duration": 3.8600000000000136,
      "text": "我们的国家向何处去 整个世界向何处去"
    },
    {
      "id": 132,
      "start": 621.32,
      "end": 624.64,
      "duration": 3.3199999999999363,
      "text": "尽管这个问题在我们面前显得如此之宏大"
    },
    {
      "id": 133,
      "start": 624.64,
      "end": 629.62,
      "duration": 4.980000000000018,
      "text": "但是它和我们每一个人所做的研究工作都密切相关"
    },
    {
      "id": 134,
      "start": 632.59,
      "end": 634.31,
      "duration": 1.7199999999999136,
      "text": "我们期待着人类和平"
    },
    {
      "id": 135,
      "start": 635.15,
      "end": 637.17,
      "duration": 2.019999999999982,
      "text": "期待着人类有序发展"
    },
    {
      "id": 136,
      "start": 638.41,
      "end": 641.01,
      "duration": 2.6000000000000227,
      "text": "所以今天我看到有很多国际学生"
    },
    {
      "id": 137,
      "start": 641.61,
      "end": 648.47,
      "duration": 6.860000000000014,
      "text": "和你们一样 也是我们的同学 也在今天的新生开幕式上 我很高兴"
    },
    {
      "id": 138,
      "start": 651.35,
      "end": 657.67,
      "duration": 6.319999999999936,
      "text": "因为21世纪无论有（多少）各种思潮的诞生 但人类发展的趋势 谁也不能阻挡"
    },
    {
      "id": 139,
      "start": 657.67,
      "end": 662.73,
      "duration": 5.060000000000059,
      "text": "它一定是走向人类文明 更加文明的这样一个方向"
    },
    {
      "id": 140,
      "start": 663.25,
      "end": 667.49,
      "duration": 4.240000000000009,
      "text": "它一定是社会充满爱 这是人类真正的价值所在"
    },
    {
      "id": 141,
      "start": 668.57,
      "end": 670.13,
      "duration": 1.5599999999999454,
      "text": "所以从这个角度讲"
    },
    {
      "id": 142,
      "start": 670.69,
      "end": 678.33,
      "duration": 7.639999999999986,
      "text": "我们希望 在各种思潮博弈的过程当中 尽快地把新的技术 新的理念"
    },
    {
      "id": 143,
      "start": 678.33,
      "end": 683.55,
      "duration": 5.219999999999914,
      "text": "新的思想 尽快地确立起来 成为人类社会发展之主流"
    },
    {
      "id": 144,
      "start": 684.93,
      "end": 687.01,
      "duration": 2.080000000000041,
      "text": "所以我们在和时间赛跑"
    },
    {
      "id": 145,
      "start": 688.51,
      "end": 690.57,
      "duration": 2.060000000000059,
      "text": "我们要做走在时间前面的人"
    },
    {
      "id": 146,
      "start": 692.39,
      "end": 695.03,
      "duration": 2.6399999999999864,
      "text": "我们中华民族从来没有像今天这样"
    },
    {
      "id": 147,
      "start": 697.28,
      "end": 699.86,
      "duration": 2.580000000000041,
      "text": "距离一次新的工业革命如此之近"
    },
    {
      "id": 148,
      "start": 700.54,
      "end": 701.78,
      "duration": 1.240000000000009,
      "text": "我们参与其中"
    },
    {
      "id": 149,
      "start": 702.44,
      "end": 704.9,
      "duration": 2.4599999999999227,
      "text": "甚至在某些领域我们走在了前面"
    },
    {
      "id": 150,
      "start": 706.99,
      "end": 714.57,
      "duration": 7.580000000000041,
      "text": "但是一旦被错误思潮 影响了这次新的人类技术革命 那将会倒向错误的方向"
    },
    {
      "id": 151,
      "start": 714.57,
      "end": 718.31,
      "duration": 3.7399999999998954,
      "text": "将会给人类社会造成伤害 甚至是灾难"
    },
    {
      "id": 152,
      "start": 719.97,
      "end": 726.1414285714286,
      "duration": 6.171428571428578,
      "text": "所以你们要身处其中 要深刻感悟到 时间对于我们所有的人"
    },
    {
      "id": 153,
      "start": 726.1414285714286,
      "end": 727.97,
      "duration": 1.828571428571422,
      "text": "尤其对于你们来讲"
    },
    {
      "id": 154,
      "start": 727.97,
      "end": 729.47,
      "duration": 1.5,
      "text": "是如此之宝贵"
    },
    {
      "id": 155,
      "start": 730.25,
      "end": 734.7176923076922,
      "duration": 4.467692307692232,
      "text": "第四次工业革命的进程 节奏如此之快 稍不留神"
    },
    {
      "id": 156,
      "start": 734.7176923076922,
      "end": 738.17,
      "duration": 3.452307692307727,
      "text": "你会被这个时代所抛弃 你会被边缘化"
    },
    {
      "id": 157,
      "start": 738.93,
      "end": 739.7299999999999,
      "duration": 0.7999999999999545,
      "text": "大家看到"
    },
    {
      "id": 158,
      "start": 740.13,
      "end": 742.23,
      "duration": 2.1000000000000227,
      "text": "新的技术革命 新的产业形态"
    },
    {
      "id": 159,
      "start": 742.81,
      "end": 745.69,
      "duration": 2.880000000000109,
      "text": "新的经济发展理念 在不断的推出"
    },
    {
      "id": 160,
      "start": 746.71,
      "end": 750.4330769230769,
      "duration": 3.72307692307686,
      "text": "我们可能现在学习的东西 转瞬间就变成落后的了"
    },
    {
      "id": 161,
      "start": 750.4330769230769,
      "end": 753.31,
      "duration": 2.876923076923049,
      "text": "很多传统的 在世界卓有影响的大企业"
    },
    {
      "id": 162,
      "start": 753.31,
      "end": 754.79,
      "duration": 1.4800000000000182,
      "text": "转瞬之间倒闭了"
    },
    {
      "id": 163,
      "start": 756.86,
      "end": 761.16,
      "duration": 4.2999999999999545,
      "text": "恰恰是这种动乱 这种看似波涛汹涌"
    },
    {
      "id": 164,
      "start": 761.68,
      "end": 767.46,
      "duration": 5.780000000000086,
      "text": "预示着人类将会产生一个质的飞跃 进入到一个新的人类文明时代"
    },
    {
      "id": 165,
      "start": 768.02,
      "end": 774.66,
      "duration": 6.639999999999986,
      "text": "尤其是这次疫情的冲击 大家看到了 给全世界各个国家 带来了多么大的警醒"
    },
    {
      "id": 166,
      "start": 776.04,
      "end": 780.34,
      "duration": 4.300000000000068,
      "text": "任何一个国家 任何一个个体 都不能独立于社会之存在"
    },
    {
      "id": 167,
      "start": 780.8,
      "end": 785.92,
      "duration": 5.1200000000000045,
      "text": "大家需要互相帮助 才能够共同战胜 大自然给我们带来的伤害"
    },
    {
      "id": 168,
      "start": 786.4,
      "end": 790.72,
      "duration": 4.32000000000005,
      "text": "同时我们也警醒到 我们人类需要和大自然和谐相处"
    },
    {
      "id": 169,
      "start": 791.3,
      "end": 795.96,
      "duration": 4.660000000000082,
      "text": "我们需要共帮共助 共同来建设一个美好的未来的明天"
    },
    {
      "id": 170,
      "start": 796.68,
      "end": 800.56,
      "duration": 3.8799999999999955,
      "text": "但有些人不这样想 有些人把自己摆在最前面"
    },
    {
      "id": 171,
      "start": 801.98,
      "end": 803.06,
      "duration": 1.0799999999999272,
      "text": "这是不应该的"
    },
    {
      "id": 172,
      "start": 804.0,
      "end": 805.7,
      "duration": 1.7000000000000455,
      "text": "你们每一个个体也是如此"
    },
    {
      "id": 173,
      "start": 806.34,
      "end": 808.82,
      "duration": 2.480000000000018,
      "text": "当你身处一个团队 一个集体当中"
    },
    {
      "id": 174,
      "start": 810.14,
      "end": 811.72,
      "duration": 1.580000000000041,
      "text": "什么都是以我为中心"
    },
    {
      "id": 175,
      "start": 812.52,
      "end": 815.24,
      "duration": 2.7200000000000273,
      "text": "这不是人类文明价值之所在"
    },
    {
      "id": 176,
      "start": 816.22,
      "end": 818.48,
      "duration": 2.259999999999991,
      "text": "大家应该互相关爱 互相帮助"
    },
    {
      "id": 177,
      "start": 819.46,
      "end": 822.86,
      "duration": 3.3999999999999773,
      "text": "因为这是人类文明 真正之价值所在"
    },
    {
      "id": 178,
      "start": 823.32,
      "end": 830.04,
      "duration": 6.719999999999914,
      "text": "我们既要走在时代的前面 走在时间的前面 去引领这个社会 向着一个正确的方向发展"
    },
    {
      "id": 179,
      "start": 830.04,
      "end": 836.6,
      "duration": 6.560000000000059,
      "text": "同时要用我们自身的聪明才智 来贡献这个社会 成为这个社会的参与者奉献者"
    },
    {
      "id": 180,
      "start": 836.6,
      "end": 840.28,
      "duration": 3.67999999999995,
      "text": "你才无愧于说 我是这个社会发展的栋梁"
    },
    {
      "id": 181,
      "start": 843.84,
      "end": 844.68,
      "duration": 0.8399999999999181,
      "text": "第三点"
    },
    {
      "id": 182,
      "start": 845.48,
      "end": 850.02,
      "duration": 4.539999999999964,
      "text": "我们学校是一个追逐梦想 放飞梦想的地方"
    },
    {
      "id": 183,
      "start": 850.96,
      "end": 853.88,
      "duration": 2.919999999999959,
      "text": "你们需要有创新的精神"
    },
    {
      "id": 184,
      "start": 855.32,
      "end": 858.0,
      "duration": 2.67999999999995,
      "text": "这个时代给了我们这样一个机会"
    },
    {
      "id": 185,
      "start": 858.56,
      "end": 860.94,
      "duration": 2.380000000000109,
      "text": "尤其给了年轻人这样一个机会"
    },
    {
      "id": 186,
      "start": 861.78,
      "end": 863.7,
      "duration": 1.9200000000000728,
      "text": "很多年轻人脱颖而出"
    },
    {
      "id": 187,
      "start": 866.23,
      "end": 867.95,
      "duration": 1.7200000000000273,
      "text": "我们学校有一位副教授"
    },
    {
      "id": 188,
      "start": 869.25,
      "end": 872.27,
      "duration": 3.019999999999982,
      "text": "社会给他起了个绰号 叫饭盒教授"
    },
    {
      "id": 189,
      "start": 875.47,
      "end": 877.01,
      "duration": 1.5399999999999636,
      "text": "他不要科研经费"
    },
    {
      "id": 190,
      "start": 879.39,
      "end": 881.75,
      "duration": 2.3600000000000136,
      "text": "没有任何物质利益的所求"
    },
    {
      "id": 191,
      "start": 884.52,
      "end": 885.76,
      "duration": 1.240000000000009,
      "text": "自己带着饭盒"
    },
    {
      "id": 192,
      "start": 886.56,
      "end": 888.42,
      "duration": 1.8600000000000136,
      "text": "默默地在为社会服务"
    },
    {
      "id": 193,
      "start": 890.88,
      "end": 893.52,
      "duration": 2.6399999999999864,
      "text": "他在遥远的边疆省份云南"
    },
    {
      "id": 194,
      "start": 895.56,
      "end": 897.3,
      "duration": 1.740000000000009,
      "text": "利用大数据的技术"
    },
    {
      "id": 195,
      "start": 898.2,
      "end": 899.86,
      "duration": 1.6599999999999682,
      "text": "来造福于一方社会"
    },
    {
      "id": 196,
      "start": 901.91,
      "end": 907.23,
      "duration": 5.32000000000005,
      "text": "他用他的大数据技术 有效地组织了贩毒的猖獗"
    },
    {
      "id": 197,
      "start": 908.45,
      "end": 912.29,
      "duration": 3.839999999999918,
      "text": "他又用他的大数据技术 第一个在全国"
    },
    {
      "id": 198,
      "start": 912.77,
      "end": 914.51,
      "duration": 1.740000000000009,
      "text": "推出了迎接"
    },
    {
      "id": 199,
      "start": 914.97,
      "end": 919.07,
      "duration": 4.100000000000023,
      "text": "对付新冠肺炎疫情的健康码"
    },
    {
      "id": 200,
      "start": 921.03,
      "end": 927.99,
      "duration": 6.960000000000036,
      "text": "大家现在见怪不怪 到处都有健康码 但是第一个 率先在国内实行的 是在云南"
    },
    {
      "id": 201,
      "start": 927.99,
      "end": 929.59,
      "duration": 1.6000000000000227,
      "text": "而这个发起者"
    },
    {
      "id": 202,
      "start": 930.83,
      "end": 933.87,
      "duration": 3.0399999999999636,
      "text": "是我们的一位 默默无闻的副教授"
    },
    {
      "id": 203,
      "start": 936.98,
      "end": 938.6,
      "duration": 1.6200000000000045,
      "text": "他的行动 他的精神"
    },
    {
      "id": 204,
      "start": 940.22,
      "end": 947.53,
      "duration": 7.309999999999945,
      "text": "他的业绩感动了社会 他被相关部门"
    },
    {
      "id": 205,
      "start": 948.67,
      "end": 950.03,
      "duration": 1.3600000000000136,
      "text": "评为英雄模范人"
    },
    {
      "id": 206,
      "start": 952.55,
      "end": 954.25,
      "duration": 1.7000000000000455,
      "text": "云南省一次给他"
    },
    {
      "id": 207,
      "start": 955.23,
      "end": 956.69,
      "duration": 1.4600000000000364,
      "text": "数千万的经费"
    },
    {
      "id": 208,
      "start": 957.25,
      "end": 958.49,
      "duration": 1.240000000000009,
      "text": "来让他组建"
    },
    {
      "id": 209,
      "start": 959.11,
      "end": 964.37,
      "duration": 5.259999999999991,
      "text": "未来社会发展当中 大数据的研究中心"
    },
    {
      "id": 210,
      "start": 967.41,
      "end": 968.77,
      "duration": 1.3600000000000136,
      "text": "这就是我们交大人"
    },
    {
      "id": 211,
      "start": 969.77,
      "end": 975.07,
      "duration": 5.300000000000068,
      "text": "他知道自己的价值所在 他知道自己的追求所在 他深入社会"
    },
    {
      "id": 212,
      "start": 975.67,
      "end": 977.93,
      "duration": 2.259999999999991,
      "text": "他去了解社会发展之需求"
    },
    {
      "id": 213,
      "start": 981.28,
      "end": 988.22,
      "duration": 6.940000000000055,
      "text": "在解决这种需求的过程当中 把自己的聪明才智 得到了淋漓尽致的发挥"
    },
    {
      "id": 214,
      "start": 991.16,
      "end": 992.34,
      "duration": 1.1800000000000637,
      "text": "这就是人的价值"
    },
    {
      "id": 215,
      "start": 994.82,
      "end": 996.34,
      "duration": 1.5199999999999818,
      "text": "所以我跟同学们讲"
    },
    {
      "id": 216,
      "start": 997.48,
      "end": 998.28,
      "duration": 0.7999999999999545,
      "text": "科学"
    },
    {
      "id": 217,
      "start": 998.72,
      "end": 1002.78,
      "duration": 4.059999999999945,
      "text": "社会进步 真正的来源 真正的动力"
    },
    {
      "id": 218,
      "start": 1003.22,
      "end": 1006.54,
      "duration": 3.3199999999999363,
      "text": "来源于社会实践 来源于社会之需求"
    },
    {
      "id": 219,
      "start": 1010.43,
      "end": 1014.35,
      "duration": 3.9200000000000728,
      "text": "所以在你所学的专业 所学的领域 所研究的方向"
    },
    {
      "id": 220,
      "start": 1014.87,
      "end": 1020.11,
      "duration": 5.240000000000009,
      "text": "你看一看你的方向 所服务的领域 服务的社会 未来有哪些需求"
    },
    {
      "id": 221,
      "start": 1020.11,
      "end": 1024.75,
      "duration": 4.639999999999986,
      "text": "你就会发现若干问题"
    },
    {
      "id": 222,
      "start": 1027.27,
      "end": 1032.93,
      "duration": 5.660000000000082,
      "text": "总书记刚刚开完了 和科技工作者的座谈会 提出了四个面向"
    },
    {
      "id": 223,
      "start": 1033.99,
      "end": 1040.59,
      "duration": 6.599999999999909,
      "text": "叫面向世界科技前沿 面向经济社会主战场 面向国家重大需求"
    },
    {
      "id": 224,
      "start": 1040.59,
      "end": 1043.19,
      "duration": 2.6000000000001364,
      "text": "面向人民生命健康"
    },
    {
      "id": 225,
      "start": 1045.61,
      "end": 1050.57,
      "duration": 4.960000000000036,
      "text": "所有这四个面向 如果你不深入社会 你没有切身的感受"
    },
    {
      "id": 226,
      "start": 1051.81,
      "end": 1059.21,
      "duration": 7.400000000000091,
      "text": "当你深入社会 了解社会 你突然发现充满了激发你 灵感的社会需求"
    },
    {
      "id": 227,
      "start": 1062.54,
      "end": 1063.96,
      "duration": 1.4200000000000728,
      "text": "所以实践"
    },
    {
      "id": 228,
      "start": 1064.52,
      "end": 1067.7,
      "duration": 3.1800000000000637,
      "text": "是推动 真理发展的唯一动力"
    },
    {
      "id": 229,
      "start": 1068.4,
      "end": 1072.32,
      "duration": 3.9199999999998454,
      "text": "也是检验 真理的唯一的环节"
    },
    {
      "id": 230,
      "start": 1074.46,
      "end": 1078.62,
      "duration": 4.1599999999998545,
      "text": "所以我们每一个人的劳动 最后的结果 是服务于社会"
    },
    {
      "id": 231,
      "start": 1079.3,
      "end": 1082.0,
      "duration": 2.7000000000000455,
      "text": "所以不了解社会 不深入社会"
    },
    {
      "id": 232,
      "start": 1082.52,
      "end": 1085.42,
      "duration": 2.900000000000091,
      "text": "会逐渐被社会所淘汰 所边缘化"
    },
    {
      "id": 233,
      "start": 1087.44,
      "end": 1090.44,
      "duration": 3.0,
      "text": "刚才的郗平教授研究基础数学"
    },
    {
      "id": 234,
      "start": 1091.58,
      "end": 1092.66,
      "duration": 1.0800000000001546,
      "text": "他还知道"
    },
    {
      "id": 235,
      "start": 1093.2,
      "end": 1100.86,
      "duration": 7.6599999999998545,
      "text": "基础数学 对社会未来的发展 将会产生哪些作用 所以大家看到"
    },
    {
      "id": 236,
      "start": 1101.56,
      "end": 1102.36,
      "duration": 0.7999999999999545,
      "text": "我们的"
    },
    {
      "id": 237,
      "start": 1103.92,
      "end": 1106.34,
      "duration": 2.4199999999998454,
      "text": "民族之骄傲的企业 华为"
    },
    {
      "id": 238,
      "start": 1108.3,
      "end": 1115.28,
      "duration": 6.980000000000018,
      "text": "它在引领着5G通讯技术的发展 充满了变数"
    },
    {
      "id": 239,
      "start": 1117.21,
      "end": 1119.33,
      "duration": 2.119999999999891,
      "text": "他们现在的技术人员"
    },
    {
      "id": 240,
      "start": 1119.99,
      "end": 1121.63,
      "duration": 1.6400000000001,
      "text": "所研究的技术"
    },
    {
      "id": 241,
      "start": 1123.46,
      "end": 1125.94,
      "duration": 2.480000000000018,
      "text": "他们的水平 他们的投入"
    },
    {
      "id": 242,
      "start": 1127.48,
      "end": 1135.06,
      "duration": 7.579999999999927,
      "text": "远远超出一个国家 而我们在校的学生"
    },
    {
      "id": 243,
      "start": 1135.66,
      "end": 1137.3,
      "duration": 1.6399999999998727,
      "text": "如果不了解这一切"
    },
    {
      "id": 244,
      "start": 1139.22,
      "end": 1144.64,
      "duration": 5.420000000000073,
      "text": "我们就会被固有的 传统的思想所束缚 跟不上时代发展的步伐"
    },
    {
      "id": 245,
      "start": 1146.27,
      "end": 1149.49,
      "duration": 3.2200000000000273,
      "text": "我明确地告诉大家 社会在若干领域"
    },
    {
      "id": 246,
      "start": 1150.03,
      "end": 1151.95,
      "duration": 1.9200000000000728,
      "text": "已经走在了我们的前面"
    },
    {
      "id": 247,
      "start": 1153.21,
      "end": 1159.31,
      "duration": 6.099999999999909,
      "text": "我们的大学 如果再不深入社会 再不了解社会 再不和社会深度融合"
    },
    {
      "id": 248,
      "start": 1161.44,
      "end": 1163.2,
      "duration": 1.759999999999991,
      "text": "将会被社会所抛弃"
    },
    {
      "id": 249,
      "start": 1164.83,
      "end": 1166.93,
      "duration": 2.1000000000001364,
      "text": "我们为什么构建创新港"
    },
    {
      "id": 250,
      "start": 1167.61,
      "end": 1170.99,
      "duration": 3.380000000000109,
      "text": "我们为什么构建这样一个 和社会深度融合的环境"
    },
    {
      "id": 251,
      "start": 1171.83,
      "end": 1175.75,
      "duration": 3.9200000000000728,
      "text": "我们是希望看到 在第四次工业革命背景下"
    },
    {
      "id": 252,
      "start": 1176.27,
      "end": 1179.19,
      "duration": 2.9200000000000728,
      "text": "我们的大学也需要自身变革"
    },
    {
      "id": 253,
      "start": 1179.89,
      "end": 1185.67,
      "duration": 5.779999999999973,
      "text": "这个大学的变革不是一句口号 是来自于我们的老师 我们的同学"
    },
    {
      "id": 254,
      "start": 1185.67,
      "end": 1192.99,
      "duration": 7.319999999999936,
      "text": "主动地投身于社会实践之中 了解社会 预测社会 你才真正能够成为一个"
    },
    {
      "id": 255,
      "start": 1192.99,
      "end": 1195.15,
      "duration": 2.160000000000082,
      "text": "未来去引领社会的人"
    },
    {
      "id": 256,
      "start": 1196.62,
      "end": 1198.84,
      "duration": 2.2200000000000273,
      "text": "所以我说的第三点就是"
    },
    {
      "id": 257,
      "start": 1199.34,
      "end": 1204.9,
      "duration": 5.560000000000173,
      "text": "大家一定要主动地 了解社会之需求 主动地融入之社会"
    },
    {
      "id": 258,
      "start": 1204.9,
      "end": 1207.82,
      "duration": 2.9199999999998454,
      "text": "然后你的眼界才能更开阔"
    },
    {
      "id": 259,
      "start": 1207.82,
      "end": 1214.39,
      "duration": 6.570000000000164,
      "text": "最后我想对我们国际学生说几句"
    },
    {
      "id": 260,
      "start": 1215.21,
      "end": 1219.59,
      "duration": 4.379999999999882,
      "text": "我非常高兴 你们也成为西安交通大学的一员"
    },
    {
      "id": 261,
      "start": 1221.01,
      "end": 1224.85,
      "duration": 3.839999999999918,
      "text": "人类最终不变的价值所在是爱"
    },
    {
      "id": 262,
      "start": 1225.95,
      "end": 1230.19,
      "duration": 4.240000000000009,
      "text": "我们都需要向这个社会奉献我们的爱"
    },
    {
      "id": 263,
      "start": 1230.93,
      "end": 1236.99,
      "duration": 6.059999999999945,
      "text": "你们走到这里肩负着非常大的使命 第一你们看到了一个古老的城市西安"
    },
    {
      "id": 264,
      "start": 1236.99,
      "end": 1240.39,
      "duration": 3.400000000000091,
      "text": "它承载着中华民族几千年的文明史"
    },
    {
      "id": 265,
      "start": 1240.91,
      "end": 1246.89,
      "duration": 5.980000000000018,
      "text": "你们要深入的了解 第二你们都有各自的专业 奉献你们的聪明才智"
    },
    {
      "id": 266,
      "start": 1246.89,
      "end": 1254.57,
      "duration": 7.679999999999836,
      "text": "将来以后报效你们的国家 奉献这个社会 第三 把你们所在国家的文明文化"
    },
    {
      "id": 267,
      "start": 1254.57,
      "end": 1261.55,
      "duration": 6.980000000000018,
      "text": "也带过来 大家相互交融 我特别期待看到的是 这个社会充满爱"
    },
    {
      "id": 268,
      "start": 1261.55,
      "end": 1264.31,
      "duration": 2.759999999999991,
      "text": "而你们将会是爱的使者"
    },
    {
      "id": 269,
      "start": 1266.52,
      "end": 1273.94,
      "duration": 7.420000000000073,
      "text": "交大是一个包容的交大 交大是一个世界的交大 我们这个创新港 就是面向世界开放的"
    },
    {
      "id": 270,
      "start": 1273.94,
      "end": 1276.9,
      "duration": 2.9600000000000364,
      "text": "一个充满梦想 放飞梦想"
    },
    {
      "id": 271,
      "start": 1277.64,
      "end": 1278.64,
      "duration": 1.0,
      "text": "这样一个地方"
    },
    {
      "id": 272,
      "start": 1279.2,
      "end": 1286.16,
      "duration": 6.960000000000036,
      "text": "我希望我们所有的人 所有的年轻人 为了这个世界的未来 我们大家携起手来"
    },
    {
      "id": 273,
      "start": 1286.16,
      "end": 1294.1,
      "duration": 7.939999999999827,
      "text": "互相帮助 互相关爱 把我们的聪明才智 把我们的精神财富 奉献给这个未来"
    },
    {
      "id": 274,
      "start": 1294.1,
      "end": 1301.18,
      "duration": 7.080000000000155,
      "text": "承载我们的社会 也希望通过我们的努力 让这个社会 未来变得更加美好"
    },
    {
      "id": 275,
      "start": 1301.18,
      "end": 1307.62,
      "duration": 6.439999999999827,
      "text": "非常抱歉 我原来想用英语跟你们讲 我一看我们的保安人员都讲英语"
    },
    {
      "id": 276,
      "start": 1307.62,
      "end": 1309.1,
      "duration": 1.4800000000000182,
      "text": "（但是）我还是讲汉语吧"
    },
    {
      "id": 277,
      "start": 1309.74,
      "end": 1316.66,
      "duration": 6.920000000000073,
      "text": "也希望你们来到这里 能够多多学习一些汉语 让我们交流起来更方便"
    },
    {
      "id": 278,
      "start": 1316.66,
      "end": 1324.56,
      "duration": 7.899999999999864,
      "text": "我也希望我们中国的学生 多学一些外语 便于和外国朋友更多的交往"
    },
    {
      "id": 279,
      "start": 1324.56,
      "end": 1329.8,
      "duration": 5.240000000000009,
      "text": "这是一个人类文明文化 相互交融的必然趋势"
    },
    {
      "id": 280,
      "start": 1330.46,
      "end": 1337.98,
      "duration": 7.519999999999982,
      "text": "我由衷的祝福大家 在这个放飞梦想 追逐梦想充满爱的地方 让我们携起手来"
    },
    {
      "id": 281,
      "start": 1337.98,
      "end": 1343.3,
      "duration": 5.319999999999936,
      "text": "共同为21世纪 人类未来更美好的明天"
    },
    {
      "id": 282,
      "start": 1343.3,
      "end": 1351.26,
      "duration": 7.960000000000036,
      "text": "去树立真正的科学的价值观 去树立真正的科学的爱之所在"
    },
    {
      "id": 283,
      "start": 1351.26,
      "end": 1358.2,
      "duration": 6.940000000000055,
      "text": "让“为世界之光”成为我们的具体行动 由衷的祝福大家 谢谢各位！"
    }
  ]
}