{
  "source": "output\\2020本科生毕业演讲.srt",
  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 3.48,
      "duration": 3.48,
      "text": "在求学期间 所思所想"
    },
    {
      "id": 2,
      "start": 4.34,
      "end": 12.14,
      "duration": 7.800000000000001,
      "text": "与大家共同分享 看到我们的校友 邱院士"
    },
    {
      "id": 3,
      "start": 12.14,
      "end": 16.59,
      "duration": 4.449999999999999,
      "text": "把他这一生的感悟"
    },
    {
      "id": 4,
      "start": 18.01,
      "end": 19.19,
      "duration": 1.1799999999999997,
      "text": "以及对你们"
    },
    {
      "id": 5,
      "start": 19.97,
      "end": 21.59,
      "duration": 1.620000000000001,
      "text": "未来的期许"
    },
    {
      "id": 6,
      "start": 22.93,
      "end": 25.23,
      "duration": 2.3000000000000007,
      "text": "语重心长 娓娓道来"
    },
    {
      "id": 7,
      "start": 27.82,
      "end": 29.86,
      "duration": 2.039999999999999,
      "text": "也看到我们的家长代表"
    },
    {
      "id": 8,
      "start": 31.81,
      "end": 33.29,
      "duration": 1.4800000000000004,
      "text": "也是我们的校友"
    },
    {
      "id": 9,
      "start": 34.47,
      "end": 36.79,
      "duration": 2.3200000000000003,
      "text": "把自己对学校的情怀"
    },
    {
      "id": 10,
      "start": 38.01,
      "end": 42.9,
      "duration": 4.890000000000001,
      "text": "对未来的期许 由衷地表述"
    },
    {
      "id": 11,
      "start": 45.38,
      "end": 46.6,
      "duration": 1.2199999999999989,
      "text": "让我感动不已"
    },
    {
      "id": 12,
      "start": 49.21,
      "end": 55.63,
      "duration": 6.420000000000002,
      "text": "大家都知道 今年是一个特殊的年份 所以我们在我们的体育场"
    },
    {
      "id": 13,
      "start": 56.97,
      "end": 60.31,
      "duration": 3.3400000000000034,
      "text": "举行了这样一次 特殊的毕业典礼"
    },
    {
      "id": 14,
      "start": 63.0,
      "end": 65.26,
      "duration": 2.260000000000005,
      "text": "我想在大家一生当中"
    },
    {
      "id": 15,
      "start": 66.52,
      "end": 69.36,
      "duration": 2.8400000000000034,
      "text": "都不会忘记这个时刻 因为大家都知道"
    },
    {
      "id": 16,
      "start": 70.0,
      "end": 76.44,
      "duration": 6.439999999999998,
      "text": "当今世界正面临着 百年未遇之大变局 而这次疫情"
    },
    {
      "id": 17,
      "start": 77.38,
      "end": 83.41,
      "duration": 6.030000000000001,
      "text": "又加剧了这种变局 在这个多变的世界"
    },
    {
      "id": 18,
      "start": 84.63,
      "end": 86.61,
      "duration": 1.980000000000004,
      "text": "发生急剧变化的时刻"
    },
    {
      "id": 19,
      "start": 88.45,
      "end": 90.93,
      "duration": 2.480000000000004,
      "text": "你们将进入到 人生下一个阶段"
    },
    {
      "id": 20,
      "start": 93.16,
      "end": 94.8,
      "duration": 1.6400000000000006,
      "text": "如何面对这种挑战"
    },
    {
      "id": 21,
      "start": 97.54,
      "end": 99.48,
      "duration": 1.9399999999999977,
      "text": "如何走好你未来的路"
    },
    {
      "id": 22,
      "start": 103.24,
      "end": 104.52,
      "duration": 1.2800000000000011,
      "text": "老师们也罢"
    },
    {
      "id": 23,
      "start": 105.5,
      "end": 106.96,
      "duration": 1.4599999999999937,
      "text": "你们的同学也罢"
    },
    {
      "id": 24,
      "start": 108.14,
      "end": 114.12,
      "duration": 5.980000000000004,
      "text": "都谈了自己的思考 但是我想告诉大家"
    },
    {
      "id": 25,
      "start": 115.76,
      "end": 117.16,
      "duration": 1.3999999999999915,
      "text": "最重要的"
    },
    {
      "id": 26,
      "start": 118.82,
      "end": 121.04,
      "duration": 2.220000000000013,
      "text": "支撑你一生发展的"
    },
    {
      "id": 27,
      "start": 121.72,
      "end": 123.1,
      "duration": 1.3799999999999955,
      "text": "不竭的动力"
    },
    {
      "id": 28,
      "start": 124.06,
      "end": 125.6,
      "duration": 1.539999999999992,
      "text": "就是家国情怀"
    },
    {
      "id": 29,
      "start": 129.76,
      "end": 131.8,
      "duration": 2.0400000000000205,
      "text": "如果人一生"
    },
    {
      "id": 30,
      "start": 132.76,
      "end": 134.74,
      "duration": 1.9800000000000182,
      "text": "没有这样一个动力支撑"
    },
    {
      "id": 31,
      "start": 136.1,
      "end": 137.94,
      "duration": 1.8400000000000034,
      "text": "他很难完美的"
    },
    {
      "id": 32,
      "start": 138.58,
      "end": 139.7,
      "duration": 1.1199999999999761,
      "text": "持续的"
    },
    {
      "id": 33,
      "start": 140.36,
      "end": 142.32,
      "duration": 1.9599999999999795,
      "text": "去书写他辉煌的一生"
    },
    {
      "id": 34,
      "start": 142.32,
      "end": 149.68,
      "duration": 7.360000000000014,
      "text": "总书记讲过 一个国家"
    },
    {
      "id": 35,
      "start": 150.5,
      "end": 151.66,
      "duration": 1.1599999999999966,
      "text": "一个民族"
    },
    {
      "id": 36,
      "start": 152.38,
      "end": 153.74,
      "duration": 1.3600000000000136,
      "text": "不能没有灵魂"
    },
    {
      "id": 37,
      "start": 155.28,
      "end": 158.64,
      "duration": 3.359999999999985,
      "text": "一个没有灵魂的民族 注定是没有希望的"
    },
    {
      "id": 38,
      "start": 161.27,
      "end": 163.17,
      "duration": 1.8999999999999773,
      "text": "所以我们要知道"
    },
    {
      "id": 39,
      "start": 163.67,
      "end": 167.11,
      "duration": 3.440000000000026,
      "text": "什么是一个国家 一个民族的灵魂"
    },
    {
      "id": 40,
      "start": 168.48,
      "end": 170.76,
      "duration": 2.280000000000001,
      "text": "总书记来校视察的时候"
    },
    {
      "id": 41,
      "start": 171.56,
      "end": 173.96,
      "duration": 2.4000000000000057,
      "text": "已经给了我们清晰的答案"
    },
    {
      "id": 42,
      "start": 174.64,
      "end": 177.34,
      "duration": 2.700000000000017,
      "text": "那就是西迁精神的核心"
    },
    {
      "id": 43,
      "start": 178.3,
      "end": 185.35,
      "duration": 7.049999999999983,
      "text": "就是爱国主义 这就是我们应该秉持的家国情怀"
    },
    {
      "id": 44,
      "start": 186.67,
      "end": 188.43,
      "duration": 1.7600000000000193,
      "text": "当你有了这份情怀"
    },
    {
      "id": 45,
      "start": 189.49,
      "end": 191.07,
      "duration": 1.579999999999984,
      "text": "无论你何时何地"
    },
    {
      "id": 46,
      "start": 192.17,
      "end": 198.67,
      "duration": 6.5,
      "text": "无论你遇到什么艰难困苦 你都不会塌下来"
    },
    {
      "id": 47,
      "start": 201.04,
      "end": 202.84,
      "duration": 1.8000000000000114,
      "text": "你都会坚持下去"
    },
    {
      "id": 48,
      "start": 204.06,
      "end": 207.9,
      "duration": 3.8400000000000034,
      "text": "你都会勇敢地去越个 一个又一个的沟坎"
    },
    {
      "id": 49,
      "start": 210.78,
      "end": 211.58,
      "duration": 0.8000000000000114,
      "text": "为什么"
    },
    {
      "id": 50,
      "start": 212.22,
      "end": 218.66,
      "duration": 6.439999999999998,
      "text": "你心中有家国 心中有动力 你知道这个社会的未来"
    },
    {
      "id": 51,
      "start": 218.66,
      "end": 220.38,
      "duration": 1.7199999999999989,
      "text": "有你一份责任"
    },
    {
      "id": 52,
      "start": 221.4,
      "end": 223.82,
      "duration": 2.4199999999999875,
      "text": "你主动的来承担这份责任"
    },
    {
      "id": 53,
      "start": 225.08,
      "end": 229.9,
      "duration": 4.819999999999993,
      "text": "这种情怀 是支撑你一生发展的不竭动力"
    },
    {
      "id": 54,
      "start": 232.74,
      "end": 236.3,
      "duration": 3.5600000000000023,
      "text": "一个没有情怀的人 他的人生的辉煌是短暂的"
    },
    {
      "id": 55,
      "start": 237.96,
      "end": 239.56,
      "duration": 1.5999999999999943,
      "text": "你看到那些为社会"
    },
    {
      "id": 56,
      "start": 240.14,
      "end": 243.32,
      "duration": 3.180000000000007,
      "text": "为国家 为民族做出贡献的人"
    },
    {
      "id": 57,
      "start": 243.94,
      "end": 248.54,
      "duration": 4.599999999999994,
      "text": "能够为世人所记载的 那些辉煌的业绩的人"
    },
    {
      "id": 58,
      "start": 249.82,
      "end": 253.22,
      "duration": 3.4000000000000057,
      "text": "无一不是具有浓厚的家国情怀"
    },
    {
      "id": 59,
      "start": 254.52,
      "end": 255.7,
      "duration": 1.1799999999999784,
      "text": "要做到这一点"
    },
    {
      "id": 60,
      "start": 256.36,
      "end": 258.0,
      "duration": 1.6399999999999864,
      "text": "你才能够高瞻远瞩"
    },
    {
      "id": 61,
      "start": 258.68,
      "end": 261.4,
      "duration": 2.7199999999999704,
      "text": "你才能够纵观世界发展之风云"
    },
    {
      "id": 62,
      "start": 262.1,
      "end": 265.04,
      "duration": 2.9399999999999977,
      "text": "你才能够看清未来发展之方向"
    },
    {
      "id": 63,
      "start": 265.6,
      "end": 273.2,
      "duration": 7.599999999999966,
      "text": "你才能够把国家、民族乃至社会发展之未来 与自己的本职岗位的工作紧密的结合起来"
    },
    {
      "id": 64,
      "start": 275.18,
      "end": 282.56,
      "duration": 7.3799999999999955,
      "text": "你才知道自己人生的价值在哪里 你才知道自己为什么要这样做 为什么活着"
    },
    {
      "id": 65,
      "start": 282.56,
      "end": 284.06,
      "duration": 1.5,
      "text": "活着的意义在哪里"
    },
    {
      "id": 66,
      "start": 285.16,
      "end": 289.6164102564103,
      "duration": 4.4564102564102654,
      "text": "所以这种不解的动力 是支撑一个国家 一个民族"
    },
    {
      "id": 67,
      "start": 289.6164102564103,
      "end": 293.06,
      "duration": 3.443589743589712,
      "text": "乃至每一个个体 永续发展的不竭动力"
    },
    {
      "id": 68,
      "start": 295.89,
      "end": 299.73,
      "duration": 3.840000000000032,
      "text": "所以在这样一个情怀的支撑下 你有了全局思维"
    },
    {
      "id": 69,
      "start": 300.75,
      "end": 302.53,
      "duration": 1.7799999999999727,
      "text": "你关心世界的发展"
    },
    {
      "id": 70,
      "start": 303.37,
      "end": 305.29,
      "duration": 1.920000000000016,
      "text": "你关心大国的风云"
    },
    {
      "id": 71,
      "start": 305.95,
      "end": 313.49,
      "duration": 7.5400000000000205,
      "text": "你关心科技革命的进展 你也知道我所做的岗位 如何和未来紧密地联系起来"
    },
    {
      "id": 72,
      "start": 314.77,
      "end": 319.19105263157894,
      "duration": 4.421052631578959,
      "text": "你才有了底线思维 你知道未来发展是不平坦的"
    },
    {
      "id": 73,
      "start": 319.19105263157894,
      "end": 322.77,
      "duration": 3.5789473684210407,
      "text": "还会遇到若干的 这样那样的艰难困苦"
    },
    {
      "id": 74,
      "start": 322.77,
      "end": 324.11,
      "duration": 1.3400000000000318,
      "text": "你早做准备"
    },
    {
      "id": 75,
      "start": 324.67,
      "end": 326.49,
      "duration": 1.8199999999999932,
      "text": "为什么 你有眼光"
    },
    {
      "id": 76,
      "start": 327.13,
      "end": 334.58,
      "duration": 7.449999999999989,
      "text": "你有情怀 你有底线 这是第一点"
    },
    {
      "id": 77,
      "start": 336.38,
      "end": 339.1,
      "duration": 2.7200000000000273,
      "text": "第二点 优秀的品格"
    },
    {
      "id": 78,
      "start": 340.58,
      "end": 344.3,
      "duration": 3.7200000000000273,
      "text": "是支撑你 人生辉煌的基础"
    },
    {
      "id": 79,
      "start": 344.3,
      "end": 350.26,
      "duration": 5.9599999999999795,
      "text": "中国古语云"
    },
    {
      "id": 80,
      "start": 350.26,
      "end": 357.41,
      "duration": 7.150000000000034,
      "text": "有德无才 德不足以促其成"
    },
    {
      "id": 81,
      "start": 358.91,
      "end": 360.39,
      "duration": 1.4799999999999613,
      "text": "有才无德"
    },
    {
      "id": 82,
      "start": 361.93,
      "end": 363.51,
      "duration": 1.579999999999984,
      "text": "才必助其奸"
    },
    {
      "id": 83,
      "start": 365.09,
      "end": 365.91,
      "duration": 0.82000000000005,
      "text": "什么意思"
    },
    {
      "id": 84,
      "start": 367.51,
      "end": 370.15,
      "duration": 2.6399999999999864,
      "text": "一个没有道德品行的人"
    },
    {
      "id": 85,
      "start": 371.03,
      "end": 372.71,
      "duration": 1.6800000000000068,
      "text": "纵使他有才华"
    },
    {
      "id": 86,
      "start": 374.08,
      "end": 377.06,
      "duration": 2.980000000000018,
      "text": "也是社会所摒弃的害虫"
    },
    {
      "id": 87,
      "start": 377.62,
      "end": 380.04,
      "duration": 2.420000000000016,
      "text": "只能给这个社会带来灾难"
    },
    {
      "id": 88,
      "start": 382.19,
      "end": 387.05,
      "duration": 4.860000000000014,
      "text": "只有德才兼备的人 才能够成为这个社会发展的脊梁"
    },
    {
      "id": 89,
      "start": 387.05,
      "end": 392.84,
      "duration": 5.789999999999964,
      "text": "（所以）德才兼备 得为先"
    },
    {
      "id": 90,
      "start": 394.54,
      "end": 396.22,
      "duration": 1.6800000000000068,
      "text": "所以优秀的品格"
    },
    {
      "id": 91,
      "start": 396.86,
      "end": 399.8,
      "duration": 2.9399999999999977,
      "text": "是你一生辉煌之基础"
    },
    {
      "id": 92,
      "start": 400.64,
      "end": 402.82,
      "duration": 2.180000000000007,
      "text": "无论你将来会在什么岗位上"
    },
    {
      "id": 93,
      "start": 404.42,
      "end": 409.63,
      "duration": 5.2099999999999795,
      "text": "都是这样 要做到这一点 说起来容易"
    },
    {
      "id": 94,
      "start": 410.15,
      "end": 412.39,
      "duration": 2.240000000000009,
      "text": "做起来并不那么简单"
    },
    {
      "id": 95,
      "start": 412.93,
      "end": 420.88,
      "duration": 7.949999999999989,
      "text": "大到家国情怀 小到个人作为 都是如此 在这样一个疫情面前"
    },
    {
      "id": 96,
      "start": 420.88,
      "end": 421.78,
      "duration": 0.8999999999999773,
      "text": "大家看到了"
    },
    {
      "id": 97,
      "start": 422.28,
      "end": 424.84,
      "duration": 2.5600000000000023,
      "text": "有些人表现非常优秀"
    },
    {
      "id": 98,
      "start": 425.54,
      "end": 427.1,
      "duration": 1.5600000000000023,
      "text": "令国人感动"
    },
    {
      "id": 99,
      "start": 428.08,
      "end": 433.96,
      "duration": 5.8799999999999955,
      "text": "因为在这样一个危难时期 他们摒弃了个人的安危 而走向了最前线"
    },
    {
      "id": 100,
      "start": 434.96,
      "end": 437.96,
      "duration": 3.0,
      "text": "他们把自己奉献于这个社会"
    },
    {
      "id": 101,
      "start": 438.92,
      "end": 444.34,
      "duration": 5.419999999999959,
      "text": "为这个社会的安定 做出了不朽的贡献 为后人所记载"
    },
    {
      "id": 102,
      "start": 445.48,
      "end": 448.18,
      "duration": 2.6999999999999886,
      "text": "但也有些人 为社会所不齿"
    },
    {
      "id": 103,
      "start": 449.6,
      "end": 454.14,
      "duration": 4.539999999999964,
      "text": "在这样疫情面前 把个人的贪欲 个人的私欲"
    },
    {
      "id": 104,
      "start": 454.94,
      "end": 455.94,
      "duration": 1.0,
      "text": "暴露无遗"
    },
    {
      "id": 105,
      "start": 457.92,
      "end": 460.84,
      "duration": 2.919999999999959,
      "text": "不管他人 以我为中心"
    },
    {
      "id": 106,
      "start": 462.38,
      "end": 466.16,
      "duration": 3.7800000000000296,
      "text": "造成了社会之分裂 造成了文化之分裂"
    },
    {
      "id": 107,
      "start": 467.46,
      "end": 469.0,
      "duration": 1.5400000000000205,
      "text": "这是社会之逆流"
    },
    {
      "id": 108,
      "start": 469.94,
      "end": 475.12,
      "duration": 5.180000000000007,
      "text": "尽管是个别的 少数的 所以这次疫情是一次大考验"
    },
    {
      "id": 109,
      "start": 476.1,
      "end": 481.62,
      "duration": 5.519999999999982,
      "text": "考验了人类社会 考验了各个国家 也考验了我们每一个个体"
    },
    {
      "id": 110,
      "start": 484.13,
      "end": 488.39,
      "duration": 4.259999999999991,
      "text": "将来以后大家走向社会 无论在什么岗位上"
    },
    {
      "id": 111,
      "start": 489.17,
      "end": 494.41,
      "duration": 5.240000000000009,
      "text": "品格 优秀的品格 是你未来发展之基础"
    },
    {
      "id": 112,
      "start": 495.45,
      "end": 501.65,
      "duration": 6.199999999999989,
      "text": "要涵养自己的品格 要知道 人类命运共同体 才是当今社会"
    },
    {
      "id": 113,
      "start": 501.65,
      "end": 504.13,
      "duration": 2.480000000000018,
      "text": "社会文明之核心所在"
    },
    {
      "id": 114,
      "start": 504.83,
      "end": 506.81,
      "duration": 1.9800000000000182,
      "text": "你中有我 我中有他"
    },
    {
      "id": 115,
      "start": 507.29,
      "end": 513.39,
      "duration": 6.099999999999966,
      "text": "整个社会 大家命运相关 国家与国家如此 个人与个人也是如此"
    },
    {
      "id": 116,
      "start": 513.39,
      "end": 520.55,
      "duration": 7.159999999999968,
      "text": "当你融入这个群体当中 你才能感受到 我们这个人类文明之真正价值所在"
    },
    {
      "id": 117,
      "start": 520.55,
      "end": 525.85,
      "duration": 5.300000000000068,
      "text": "它是支撑社会 支撑人类 赖以持续发展的最根本的源泉"
    },
    {
      "id": 118,
      "start": 527.7,
      "end": 533.62,
      "duration": 5.919999999999959,
      "text": "如果我们没有这样的思考 没有这样的思维 没有这样的品格养成"
    },
    {
      "id": 119,
      "start": 533.62,
      "end": 538.76,
      "duration": 5.139999999999986,
      "text": "我们很难在世界上生存下去 很难持续生存下去"
    },
    {
      "id": 120,
      "start": 541.83,
      "end": 549.51,
      "duration": 7.67999999999995,
      "text": "所以这次疫情 带给了我们很多的思考 我们应该从中学到什么 悟到什么"
    },
    {
      "id": 121,
      "start": 549.51,
      "end": 552.59,
      "duration": 3.080000000000041,
      "text": "融入我们未来的事业发展之中"
    },
    {
      "id": 122,
      "start": 553.97,
      "end": 555.83,
      "duration": 1.8600000000000136,
      "text": "第三点，要主动作为"
    },
    {
      "id": 123,
      "start": 558.73,
      "end": 561.17,
      "duration": 2.439999999999941,
      "text": "这个社会不怜悯可怜人"
    },
    {
      "id": 124,
      "start": 561.17,
      "end": 567.16,
      "duration": 5.990000000000009,
      "text": "不要把自己未来的事业"
    },
    {
      "id": 125,
      "start": 567.16,
      "end": 569.56,
      "duration": 2.3999999999999773,
      "text": "寄托于别人的帮助之上"
    },
    {
      "id": 126,
      "start": 570.72,
      "end": 575.46,
      "duration": 4.740000000000009,
      "text": "要主动作为 做帮助别人的人 做有作为的人"
    },
    {
      "id": 127,
      "start": 577.2,
      "end": 582.64,
      "duration": 5.439999999999941,
      "text": "如果你把一切未来之希望 都是寄托于别人的帮助 可能吗"
    },
    {
      "id": 128,
      "start": 584.54,
      "end": 590.68,
      "duration": 6.139999999999986,
      "text": "一个国家是如此 如果你想富强 想民族之复兴 要靠我们自己"
    },
    {
      "id": 129,
      "start": 592.06,
      "end": 596.58,
      "duration": 4.5200000000000955,
      "text": "我们希望别人的帮助 但是我们不依赖别人的帮助"
    },
    {
      "id": 130,
      "start": 597.68,
      "end": 603.3,
      "duration": 5.6200000000000045,
      "text": "只有这样 当别人给予你帮助的时候 你才能够铭记在心"
    },
    {
      "id": 131,
      "start": 603.9,
      "end": 610.46,
      "duration": 6.560000000000059,
      "text": "你才能够有感恩的情怀 你才知道这份帮助来之不易 这份帮助是有价值的"
    },
    {
      "id": 132,
      "start": 612.89,
      "end": 614.23,
      "duration": 1.3400000000000318,
      "text": "如果没有这样一个"
    },
    {
      "id": 133,
      "start": 614.79,
      "end": 617.21,
      "duration": 2.4200000000000728,
      "text": "主动作为的进取之心"
    },
    {
      "id": 134,
      "start": 619.36,
      "end": 624.42,
      "duration": 5.059999999999945,
      "text": "不可能实现民族之富强 也不可能实现你个人未来之梦想"
    },
    {
      "id": 135,
      "start": 624.42,
      "end": 627.93,
      "duration": 3.509999999999991,
      "text": "所以主动作为"
    },
    {
      "id": 136,
      "start": 628.83,
      "end": 634.61,
      "duration": 5.779999999999973,
      "text": "是一个个体 一个国家走向成功的必由之路"
    },
    {
      "id": 137,
      "start": 636.25,
      "end": 641.81,
      "duration": 5.559999999999945,
      "text": "有些人不然 总是希望别人帮助"
    },
    {
      "id": 138,
      "start": 642.93,
      "end": 644.63,
      "duration": 1.7000000000000455,
      "text": "寄希望于别人帮助"
    },
    {
      "id": 139,
      "start": 645.47,
      "end": 647.49,
      "duration": 2.019999999999982,
      "text": "最终不可能持续走下去"
    },
    {
      "id": 140,
      "start": 648.09,
      "end": 650.77,
      "duration": 2.67999999999995,
      "text": "尤其对年轻的同学们 你们走向社会"
    },
    {
      "id": 141,
      "start": 651.25,
      "end": 653.99,
      "duration": 2.740000000000009,
      "text": "面临着很多挑战 面临着很多困难"
    },
    {
      "id": 142,
      "start": 655.61,
      "end": 658.01,
      "duration": 2.3999999999999773,
      "text": "一定要知道这其中的道理"
    },
    {
      "id": 143,
      "start": 659.29,
      "end": 661.31,
      "duration": 2.019999999999982,
      "text": "不要总以为我年轻"
    },
    {
      "id": 144,
      "start": 662.17,
      "end": 663.59,
      "duration": 1.4200000000000728,
      "text": "你们应该帮助我"
    },
    {
      "id": 145,
      "start": 664.69,
      "end": 665.87,
      "duration": 1.17999999999995,
      "text": "我涉世不深"
    },
    {
      "id": 146,
      "start": 666.39,
      "end": 667.91,
      "duration": 1.5199999999999818,
      "text": "社会应该帮助我"
    },
    {
      "id": 147,
      "start": 669.17,
      "end": 672.13,
      "duration": 2.9600000000000364,
      "text": "我工作做得不好 责任在别人"
    },
    {
      "id": 148,
      "start": 673.45,
      "end": 677.05,
      "duration": 3.599999999999909,
      "text": "如果这样想 那是一个没有长大的巨婴"
    },
    {
      "id": 149,
      "start": 678.53,
      "end": 680.19,
      "duration": 1.6600000000000819,
      "text": "你们不应该这样"
    },
    {
      "id": 150,
      "start": 681.01,
      "end": 688.53,
      "duration": 7.519999999999982,
      "text": "你们也不是这样 刚才我从几个学生代表的发言当中 看到了那种自强自利的精神"
    },
    {
      "id": 151,
      "start": 689.59,
      "end": 694.91,
      "duration": 5.319999999999936,
      "text": "看到了那种渴望 成为社会脊梁 社会栋梁的雏形"
    },
    {
      "id": 152,
      "start": 696.05,
      "end": 697.31,
      "duration": 1.259999999999991,
      "text": "所以我相信你（们）"
    },
    {
      "id": 153,
      "start": 698.91,
      "end": 704.77,
      "duration": 5.860000000000014,
      "text": "一个把自己未来希望 寄托于别人帮助之上的人 是没有希望的"
    },
    {
      "id": 154,
      "start": 706.34,
      "end": 711.94,
      "duration": 5.600000000000023,
      "text": "所以我希望大家记住 靠我们自己 但是当我们成功的时候"
    },
    {
      "id": 155,
      "start": 711.94,
      "end": 714.48,
      "duration": 2.5399999999999636,
      "text": "我们乐于奉献去帮助别人"
    },
    {
      "id": 156,
      "start": 716.53,
      "end": 718.63,
      "duration": 2.1000000000000227,
      "text": "这就是这个社会的发展规律"
    },
    {
      "id": 157,
      "start": 719.85,
      "end": 726.55,
      "duration": 6.699999999999932,
      "text": "当你不寄希望于别人帮助的时候 别人肯定会施以援手帮助你 因为这个社会的关爱"
    },
    {
      "id": 158,
      "start": 726.55,
      "end": 732.95,
      "duration": 6.400000000000091,
      "text": "是推动这个社会发展的不竭动力 只有到那个时候 你才真正体会到社会之温暖"
    },
    {
      "id": 159,
      "start": 733.47,
      "end": 734.73,
      "duration": 1.259999999999991,
      "text": "母校之温暖"
    },
    {
      "id": 160,
      "start": 735.55,
      "end": 741.5725641025641,
      "duration": 6.022564102564161,
      "text": "朋友之温暖 同学之温暖 你会铭记在心 你也会相应地给予他人之回报"
    },
    {
      "id": 161,
      "start": 741.5725641025641,
      "end": 742.89,
      "duration": 1.317435897435871,
      "text": "给予社会之回报"
    },
    {
      "id": 162,
      "start": 746.04,
      "end": 751.5,
      "duration": 5.460000000000036,
      "text": "所以这三点 我希望同学们记住 在这样一个多变的世界"
    },
    {
      "id": 163,
      "start": 752.02,
      "end": 756.98,
      "duration": 4.960000000000036,
      "text": "在这样一个多变之秋 我们举行了这样一次特殊的毕业典礼"
    },
    {
      "id": 164,
      "start": 757.5,
      "end": 762.78,
      "duration": 5.279999999999973,
      "text": "我希望同学们把它 作为未来发展之经验，体悟之所得"
    },
    {
      "id": 165,
      "start": 763.36,
      "end": 771.16,
      "duration": 7.7999999999999545,
      "text": "为你们未来的发展 奠定坚实的思想基础 品格基础 也希望你们把它融入"
    },
    {
      "id": 166,
      "start": 771.16,
      "end": 774.32,
      "duration": 3.160000000000082,
      "text": "未来的行动之中 我期待着"
    },
    {
      "id": 167,
      "start": 774.8,
      "end": 775.76,
      "duration": 0.9600000000000364,
      "text": "我也相信"
    },
    {
      "id": 168,
      "start": 776.38,
      "end": 777.18,
      "duration": 0.7999999999999545,
      "text": "你们"
    },
    {
      "id": 169,
      "start": 777.48,
      "end": 785.1,
      "duration": 7.6200000000000045,
      "text": "我们交大人 注定是未来支撑社会持续发展的社会栋梁 谢谢大家！"
    }
  ]
}