{
  "source": "output\\2023本科生毕业演讲.srt",
  "segments": [
    {
      "id": 1,
      "start": 0.69,
      "end": 2.03,
      "duration": 1.3399999999999999,
      "text": "亲爱的同学们"
    },
    {
      "id": 2,
      "start": 3.07,
      "end": 4.37,
      "duration": 1.3000000000000003,
      "text": "大家上午好"
    },
    {
      "id": 3,
      "start": 4.37,
      "end": 8.504999999999999,
      "duration": 4.134999999999999,
      "text": "今天我非常高"
    },
    {
      "id": 4,
      "start": 8.504999999999999,
      "end": 12.64,
      "duration": 4.135000000000002,
      "text": "兴也非常激动"
    },
    {
      "id": 5,
      "start": 12.64,
      "end": 16.0,
      "duration": 3.3599999999999994,
      "text": "因为昨天预报说今天有雨"
    },
    {
      "id": 6,
      "start": 17.26,
      "end": 24.3,
      "duration": 7.039999999999999,
      "text": "早晨我看到阳光明媚 我又担心太阳照射大家，太热"
    },
    {
      "id": 7,
      "start": 24.9,
      "end": 30.62,
      "duration": 5.720000000000002,
      "text": "但是当我走在路上的时候 然后老天知道我们要举行毕业典礼"
    },
    {
      "id": 8,
      "start": 30.62,
      "end": 38.26,
      "duration": 7.639999999999997,
      "text": "然后淡淡的云，就遮住了阳光 让我们今天在相对比较舒适的环境下"
    },
    {
      "id": 9,
      "start": 38.26,
      "end": 42.38,
      "duration": 4.1200000000000045,
      "text": "来举行我们这个庄严的毕业典礼"
    },
    {
      "id": 10,
      "start": 43.36,
      "end": 48.32,
      "duration": 4.960000000000001,
      "text": "我也非常感谢学校的各位老师 各位家长朋友"
    },
    {
      "id": 11,
      "start": 48.88,
      "end": 55.02,
      "duration": 6.140000000000001,
      "text": "还有我们那么多可敬可爱的校友 还有来自于社会各界的朋友"
    },
    {
      "id": 12,
      "start": 55.02,
      "end": 59.72,
      "duration": 4.699999999999996,
      "text": "来一起参加这样一个盛大的毕业典礼"
    },
    {
      "id": 13,
      "start": 59.72,
      "end": 67.2,
      "duration": 7.480000000000004,
      "text": "刚才我们的学生代表 校友代表 教师代表"
    },
    {
      "id": 14,
      "start": 67.2,
      "end": 74.0,
      "duration": 6.799999999999997,
      "text": "都对大家未来如何之发展 谈了他们的感悟"
    },
    {
      "id": 15,
      "start": 74.0,
      "end": 77.4,
      "duration": 3.4000000000000057,
      "text": "谈了他们的希望 谈了他们的寄托"
    },
    {
      "id": 16,
      "start": 77.4,
      "end": 84.36,
      "duration": 6.959999999999994,
      "text": "我们的书记也向大家做了一个非常全面的致辞"
    },
    {
      "id": 17,
      "start": 85.6,
      "end": 92.26,
      "duration": 6.660000000000011,
      "text": "把对未来你们成长道路上 所应该思考的问题"
    },
    {
      "id": 18,
      "start": 92.26,
      "end": 94.66,
      "duration": 2.3999999999999915,
      "text": "做了全面的阐释"
    },
    {
      "id": 19,
      "start": 95.3,
      "end": 98.88,
      "duration": 3.5799999999999983,
      "text": "并给予了深厚的深情的寄语"
    },
    {
      "id": 20,
      "start": 100.18,
      "end": 105.14,
      "duration": 4.959999999999994,
      "text": "留给我讲话的空间实在太小了"
    },
    {
      "id": 21,
      "start": 105.88,
      "end": 111.4,
      "duration": 5.52000000000001,
      "text": "因为我想讲的话 我突然发现，他们都讲到了"
    },
    {
      "id": 22,
      "start": 111.4,
      "end": 116.52,
      "duration": 5.11999999999999,
      "text": "但是我还是想说一点"
    },
    {
      "id": 23,
      "start": 117.24,
      "end": 118.24,
      "duration": 1.0,
      "text": "说点什么"
    },
    {
      "id": 24,
      "start": 119.64,
      "end": 125.24,
      "duration": 5.599999999999994,
      "text": "说点对人生的所思所想 所感所悟"
    },
    {
      "id": 25,
      "start": 125.24,
      "end": 130.97,
      "duration": 5.730000000000004,
      "text": "或许未来 你们在成长的历程当中"
    },
    {
      "id": 26,
      "start": 130.97,
      "end": 134.27,
      "duration": 3.3000000000000114,
      "text": "会和我有同样的感受"
    },
    {
      "id": 27,
      "start": 135.19,
      "end": 141.97,
      "duration": 6.780000000000001,
      "text": "也许今天我们的探讨 会对未来的你 能有那么点滴的帮助"
    },
    {
      "id": 28,
      "start": 142.89,
      "end": 150.15,
      "duration": 7.260000000000019,
      "text": "或许25年后 当你们再返回母校的时候 想起当年 曾经有个王老师"
    },
    {
      "id": 29,
      "start": 150.15,
      "end": 158.07,
      "duration": 7.9199999999999875,
      "text": "所讲的一切 在你的人生历程当中 也得到了践行 也得到了同样的实践"
    },
    {
      "id": 30,
      "start": 158.07,
      "end": 165.13,
      "duration": 7.060000000000002,
      "text": "甚至你们比我有更深刻的感悟 那个时候你们会像我一样"
    },
    {
      "id": 31,
      "start": 165.13,
      "end": 169.53,
      "duration": 4.400000000000006,
      "text": "站在这个舞台上 向下面的学弟学妹们讲"
    },
    {
      "id": 32,
      "start": 169.53,
      "end": 173.17,
      "duration": 3.6399999999999864,
      "text": "当年我是如何一路走来"
    },
    {
      "id": 33,
      "start": 173.17,
      "end": 180.3,
      "duration": 7.130000000000024,
      "text": "今天我想讲三点感悟 第一点 情怀"
    },
    {
      "id": 34,
      "start": 182.12,
      "end": 184.58,
      "duration": 2.460000000000008,
      "text": "人的一生不能没有情怀"
    },
    {
      "id": 35,
      "start": 185.56,
      "end": 189.54,
      "duration": 3.9799999999999898,
      "text": "什么是最大的情怀 家国情怀"
    },
    {
      "id": 36,
      "start": 190.88,
      "end": 196.0,
      "duration": 5.1200000000000045,
      "text": "这个话题我讲过若干次 为什么今天我还要讲"
    },
    {
      "id": 37,
      "start": 196.86,
      "end": 203.76,
      "duration": 6.899999999999977,
      "text": "因为家国情怀 是支撑一个人 一生事业之基础"
    },
    {
      "id": 38,
      "start": 205.88,
      "end": 207.88,
      "duration": 2.0,
      "text": "没有这个情怀"
    },
    {
      "id": 39,
      "start": 208.82,
      "end": 213.32,
      "duration": 4.5,
      "text": "任何一个个体 都难以成事，成大事"
    },
    {
      "id": 40,
      "start": 214.14,
      "end": 220.28,
      "duration": 6.140000000000015,
      "text": "没有这个情怀 你无法在人生的道路上 一路走得顺畅"
    },
    {
      "id": 41,
      "start": 221.02,
      "end": 226.84,
      "duration": 5.819999999999993,
      "text": "没有这个情怀 你将会失去灵魂 茫然 无所应对"
    },
    {
      "id": 42,
      "start": 226.84,
      "end": 229.04,
      "duration": 2.1999999999999886,
      "text": "不知人生的方向在哪里"
    },
    {
      "id": 43,
      "start": 230.48,
      "end": 237.24,
      "duration": 6.760000000000019,
      "text": "大家说，老师你说的情怀 离我们太遥远了 太高大上了"
    },
    {
      "id": 44,
      "start": 237.24,
      "end": 242.24,
      "duration": 5.0,
      "text": "我们如何来体会这种情怀 践行这种情怀"
    },
    {
      "id": 45,
      "start": 242.98,
      "end": 246.88,
      "duration": 3.9000000000000057,
      "text": "但实际上 情怀就在我们身边"
    },
    {
      "id": 46,
      "start": 249.06,
      "end": 250.38,
      "duration": 1.3199999999999932,
      "text": "我们的老一辈"
    },
    {
      "id": 47,
      "start": 251.7,
      "end": 254.56,
      "duration": 2.8600000000000136,
      "text": "从黄浦江畔来到渭水之滨"
    },
    {
      "id": 48,
      "start": 256.18,
      "end": 263.14,
      "duration": 6.9599999999999795,
      "text": "他们为了什么 为了这个国家 为了这个民族 他们就在你们身边"
    },
    {
      "id": 49,
      "start": 263.74,
      "end": 266.62,
      "duration": 2.8799999999999955,
      "text": "他们为此而奉献了他们的一生"
    },
    {
      "id": 50,
      "start": 267.84,
      "end": 275.14,
      "duration": 7.300000000000011,
      "text": "舍弃了他们很多很多东西 而只是为了我是老师 我是民族一分子"
    },
    {
      "id": 51,
      "start": 275.14,
      "end": 281.16,
      "duration": 6.020000000000039,
      "text": "我应该在我这个岗位上 为国培育更多的人才 仅此而已"
    },
    {
      "id": 52,
      "start": 281.16,
      "end": 283.96,
      "duration": 2.7999999999999545,
      "text": "但这是一个伟大的情怀"
    },
    {
      "id": 53,
      "start": 285.12,
      "end": 287.94,
      "duration": 2.819999999999993,
      "text": "我多次讲过那个山村的张老师"
    },
    {
      "id": 54,
      "start": 288.9,
      "end": 296.25,
      "duration": 7.350000000000023,
      "text": "今年我看到他所培养的学生 全部中榜 她为了什么"
    },
    {
      "id": 55,
      "start": 297.71,
      "end": 301.07,
      "duration": 3.3600000000000136,
      "text": "论官衔她没有职位 论财富"
    },
    {
      "id": 56,
      "start": 301.91,
      "end": 304.89,
      "duration": 2.9799999999999613,
      "text": "她是很微薄很微薄的收入"
    },
    {
      "id": 57,
      "start": 306.75,
      "end": 311.09,
      "duration": 4.339999999999975,
      "text": "但是她情怀 感动了亿万人民"
    },
    {
      "id": 58,
      "start": 313.46,
      "end": 319.2,
      "duration": 5.740000000000009,
      "text": "她把山村的女孩子 能够送入大学的校门 谈何容易"
    },
    {
      "id": 59,
      "start": 320.48,
      "end": 328.1,
      "duration": 7.6200000000000045,
      "text": "她有才能吗 可能就学术水平来讲 她和别人无法相比 但是她博大的胸怀"
    },
    {
      "id": 60,
      "start": 328.1,
      "end": 330.4,
      "duration": 2.2999999999999545,
      "text": "深深的家国情怀"
    },
    {
      "id": 61,
      "start": 330.84,
      "end": 332.48,
      "duration": 1.6400000000000432,
      "text": "让我们亿万人民"
    },
    {
      "id": 62,
      "start": 333.48,
      "end": 335.66,
      "duration": 2.180000000000007,
      "text": "对她称赞不已"
    },
    {
      "id": 63,
      "start": 337.04,
      "end": 342.32,
      "duration": 5.279999999999973,
      "text": "他那个柔弱的身躯 在人民心中显得是那么伟大"
    },
    {
      "id": 64,
      "start": 343.48,
      "end": 344.6,
      "duration": 1.1200000000000045,
      "text": "这是情怀"
    },
    {
      "id": 65,
      "start": 346.17,
      "end": 352.55,
      "duration": 6.3799999999999955,
      "text": "我们的老院士 陶文铨教授 八十多岁的高龄"
    },
    {
      "id": 66,
      "start": 352.55,
      "end": 358.27,
      "duration": 5.71999999999997,
      "text": "至今仍然在讲台上 为大家讲授本科生的课程"
    },
    {
      "id": 67,
      "start": 359.96,
      "end": 361.46,
      "duration": 1.5,
      "text": "他功成名就"
    },
    {
      "id": 68,
      "start": 362.88,
      "end": 364.7,
      "duration": 1.8199999999999932,
      "text": "他弟子满天下"
    },
    {
      "id": 69,
      "start": 365.3,
      "end": 366.82,
      "duration": 1.5199999999999818,
      "text": "他由何所求"
    },
    {
      "id": 70,
      "start": 367.5,
      "end": 375.1,
      "duration": 7.600000000000023,
      "text": "情怀 我是交大一分子 我应该在这个舞台上 为国家培养更多的优秀人才"
    },
    {
      "id": 71,
      "start": 376.04,
      "end": 379.5,
      "duration": 3.4599999999999795,
      "text": "所以情怀就在我们身边"
    },
    {
      "id": 72,
      "start": 380.5,
      "end": 383.62,
      "duration": 3.1200000000000045,
      "text": "情怀就在我们一言一行之中"
    },
    {
      "id": 73,
      "start": 384.9,
      "end": 391.04,
      "duration": 6.140000000000043,
      "text": "关键是我们是否 把这份情怀 深深地置根于我们的心底"
    },
    {
      "id": 74,
      "start": 391.72,
      "end": 398.02,
      "duration": 6.2999999999999545,
      "text": "让我们的所思所想 一言一行 都饱含着这份深情的外焰"
    },
    {
      "id": 75,
      "start": 398.92,
      "end": 402.64,
      "duration": 3.7199999999999704,
      "text": "这是一个人 整体品格的基础"
    },
    {
      "id": 76,
      "start": 404.5,
      "end": 411.52,
      "duration": 7.019999999999982,
      "text": "一个人没有这份情怀 他不是一个完整的 独立的人格 一个人没有这份情怀"
    },
    {
      "id": 77,
      "start": 411.52,
      "end": 418.78,
      "duration": 7.259999999999991,
      "text": "他不会感动身边的人 一个人没有这份情怀 他在事业上 不会孜孜不倦地追求"
    },
    {
      "id": 78,
      "start": 418.78,
      "end": 426.7,
      "duration": 7.920000000000016,
      "text": "一个人没有这份情怀 他会迷失前进的方向 感觉人生毫无意义 大家刚才听到了吗"
    },
    {
      "id": 79,
      "start": 426.7,
      "end": 433.14,
      "duration": 6.439999999999998,
      "text": "我们的校友 贵越生校友 他说了两句话 我不知道大家是否有所感悟"
    },
    {
      "id": 80,
      "start": 433.14,
      "end": 438.98,
      "duration": 5.840000000000032,
      "text": "当我们的老校友返回母校 站在我们老校长的墓前 致敬的时候"
    },
    {
      "id": 81,
      "start": 439.66,
      "end": 443.1,
      "duration": 3.4399999999999977,
      "text": "说出了发自他们内心的话 叫做"
    },
    {
      "id": 82,
      "start": 443.8,
      "end": 450.94,
      "duration": 7.139999999999986,
      "text": "我们要书写 无悔人生 我们要书写 无愧人生"
    },
    {
      "id": 83,
      "start": 452.36,
      "end": 459.44,
      "duration": 7.079999999999984,
      "text": "如果我们想实现 无悔人生和无愧人生 没有浓厚的家国情怀 不足以去实现"
    },
    {
      "id": 84,
      "start": 459.44,
      "end": 460.66,
      "duration": 1.2200000000000273,
      "text": "这个人生之目标"
    },
    {
      "id": 85,
      "start": 462.4,
      "end": 463.88,
      "duration": 1.4800000000000182,
      "text": "第二点感悟"
    },
    {
      "id": 86,
      "start": 464.98,
      "end": 465.78000000000003,
      "duration": 0.8000000000000114,
      "text": "毅力"
    },
    {
      "id": 87,
      "start": 467.32,
      "end": 473.58,
      "duration": 6.259999999999991,
      "text": "刚才我们的同学 在发言之中 已经表达了他们在学习之中"
    },
    {
      "id": 88,
      "start": 473.58,
      "end": 475.9,
      "duration": 2.319999999999993,
      "text": "所遇到的各种各样的困难"
    },
    {
      "id": 89,
      "start": 476.5,
      "end": 482.9,
      "duration": 6.399999999999977,
      "text": "我们那位携笔从戎的同学 在部队锻炼的时候 也经受了深刻的磨练"
    },
    {
      "id": 90,
      "start": 482.9,
      "end": 486.7876923076923,
      "duration": 3.887692307692305,
      "text": "这些都比他们日常生活 所能够忍耐的限度"
    },
    {
      "id": 91,
      "start": 486.7876923076923,
      "end": 490.88,
      "duration": 4.092307692307713,
      "text": "大大超越 但是他们坚持下来了 靠的是什么"
    },
    {
      "id": 92,
      "start": 490.88,
      "end": 491.9,
      "duration": 1.0199999999999818,
      "text": "毅力"
    },
    {
      "id": 93,
      "start": 492.48,
      "end": 497.7553846153846,
      "duration": 5.27538461538461,
      "text": "一个没有毅力的人 不足以长期地走下去 一个没有毅力的人"
    },
    {
      "id": 94,
      "start": 497.7553846153846,
      "end": 500.1,
      "duration": 2.3446153846153948,
      "text": "不足以完成一项伟大的事业"
    },
    {
      "id": 95,
      "start": 500.1,
      "end": 505.04,
      "duration": 4.939999999999998,
      "text": "一个没有毅力的人 不足以书写自己的无悔人生"
    },
    {
      "id": 96,
      "start": 506.0,
      "end": 511.78,
      "duration": 5.779999999999973,
      "text": "做事要靠毅力 但是没有困难是不可能的 没有挑战是不可能的"
    },
    {
      "id": 97,
      "start": 511.78,
      "end": 515.9,
      "duration": 4.1200000000000045,
      "text": "人的一生就是伴随着困难挑战一路走来"
    },
    {
      "id": 98,
      "start": 517.48,
      "end": 523.58,
      "duration": 6.100000000000023,
      "text": "我们生活的价值 大概就是如此吧 我们要不断地面对新问题 解决新问题"
    },
    {
      "id": 99,
      "start": 523.58,
      "end": 531.5,
      "duration": 7.919999999999959,
      "text": "然后又产生新问题 一路走来 所以大家幻想、梦想 一路顺风"
    },
    {
      "id": 100,
      "start": 531.5,
      "end": 537.96,
      "duration": 6.460000000000036,
      "text": "那只是一个良好的祝愿 当你们走向社会的时候 一定会遇到若干的"
    },
    {
      "id": 101,
      "start": 537.96,
      "end": 545.58,
      "duration": 7.6200000000000045,
      "text": "你们未曾想过的困难 会遇到若干个 你们未曾遇到的问题 你们需要真诚地面对"
    },
    {
      "id": 102,
      "start": 545.58,
      "end": 551.68,
      "duration": 6.099999999999909,
      "text": "需要直面这些问题 勇敢地面对它 去解决它 你们有这个能力"
    },
    {
      "id": 103,
      "start": 552.94,
      "end": 560.62,
      "duration": 7.67999999999995,
      "text": "但问题是你们有这份坚韧不拔的毅力没有？ 如果没有这份毅力 遇到困难你会退缩"
    },
    {
      "id": 104,
      "start": 560.62,
      "end": 568.26,
      "duration": 7.639999999999986,
      "text": "遇到问题你会绕行 久而久之 你会，被社会所边缘化 久而久之"
    },
    {
      "id": 105,
      "start": 568.26,
      "end": 575.92,
      "duration": 7.659999999999968,
      "text": "你无法再书写你的无愧人生 因为你不敢面对现实 不管面对世界"
    },
    {
      "id": 106,
      "start": 575.92,
      "end": 579.06,
      "duration": 3.1399999999999864,
      "text": "不敢面对问题 不敢面对挑战"
    },
    {
      "id": 107,
      "start": 580.02,
      "end": 582.04,
      "duration": 2.019999999999982,
      "text": "你的人生将一事无成"
    },
    {
      "id": 108,
      "start": 582.84,
      "end": 589.34,
      "duration": 6.5,
      "text": "面对问题和困难 是一个常态 不是一次两次 而是伴随你一生"
    },
    {
      "id": 109,
      "start": 589.96,
      "end": 597.42,
      "duration": 7.459999999999923,
      "text": "一定要有这样的心理准备 它不可怕 每个人都是如此 无论是成功的 还是平凡的人"
    },
    {
      "id": 110,
      "start": 597.42,
      "end": 604.8,
      "duration": 7.3799999999999955,
      "text": "都是如此 在这个问题上 没有高低贵贱之分 问题是我们如何正确地面对它"
    },
    {
      "id": 111,
      "start": 604.8,
      "end": 610.38,
      "duration": 5.580000000000041,
      "text": "从而使得我们越过一个又一个的困难 解决一个又一个的问题"
    },
    {
      "id": 112,
      "start": 610.38,
      "end": 615.62,
      "duration": 5.240000000000009,
      "text": "使我们成为真正的交大人 成为被社会所尊敬的人"
    },
    {
      "id": 113,
      "start": 615.62,
      "end": 622.34,
      "duration": 6.720000000000027,
      "text": "成为为我们国家民族的复兴 做出贡献的人 这是我们需要深刻思考的问题"
    },
    {
      "id": 114,
      "start": 623.78,
      "end": 625.94,
      "duration": 2.160000000000082,
      "text": "第三点就是创新"
    },
    {
      "id": 115,
      "start": 627.08,
      "end": 634.36,
      "duration": 7.279999999999973,
      "text": "这个时代是一个变化的时代 是一个转折的时代 新技术之发展"
    },
    {
      "id": 116,
      "start": 634.36,
      "end": 640.8,
      "duration": 6.439999999999941,
      "text": "超出我们的想象 整个社会在重构 整个知识在重构"
    },
    {
      "id": 117,
      "start": 640.8,
      "end": 647.26,
      "duration": 6.460000000000036,
      "text": "整个体系结构都在重构 这个社会 这个时代 是一个多变的时代"
    },
    {
      "id": 118,
      "start": 648.78,
      "end": 654.98,
      "duration": 6.2000000000000455,
      "text": "（也）正是因为这样 所以才给了你们 施展才能的无限空间"
    },
    {
      "id": 119,
      "start": 656.06,
      "end": 658.08,
      "duration": 2.0200000000000955,
      "text": "你们赶上了一个好时代"
    },
    {
      "id": 120,
      "start": 659.32,
      "end": 661.84,
      "duration": 2.519999999999982,
      "text": "这个时代 具有无限之可能"
    },
    {
      "id": 121,
      "start": 663.14,
      "end": 669.98,
      "duration": 6.840000000000032,
      "text": "关键看你们 能否在新的赛道上 把握住机遇 勇立潮头"
    },
    {
      "id": 122,
      "start": 669.98,
      "end": 672.5,
      "duration": 2.519999999999982,
      "text": "总书记到陕西来"
    },
    {
      "id": 123,
      "start": 673.28,
      "end": 678.76,
      "duration": 5.480000000000018,
      "text": "参加中亚五国首脑峰会 给陕西的寄语是什么"
    },
    {
      "id": 124,
      "start": 679.38,
      "end": 682.06,
      "duration": 2.67999999999995,
      "text": "你们要永立潮头"
    },
    {
      "id": 125,
      "start": 684.16,
      "end": 686.66,
      "duration": 2.5,
      "text": "永立潮头不是跟行别人"
    },
    {
      "id": 126,
      "start": 687.34,
      "end": 691.52,
      "duration": 4.17999999999995,
      "text": "踏着别人的脚印走 固然很顺畅 很省力气"
    },
    {
      "id": 127,
      "start": 692.02,
      "end": 694.84,
      "duration": 2.82000000000005,
      "text": "但是你永远会跟在别人的后面"
    },
    {
      "id": 128,
      "start": 695.34,
      "end": 698.98,
      "duration": 3.6399999999999864,
      "text": "而真正走在别人前面的人 是勇者"
    },
    {
      "id": 129,
      "start": 699.8,
      "end": 706.38,
      "duration": 6.580000000000041,
      "text": "但是恰恰是因为他们的存在 使得我们的社会 不断地向前发展进步 你们"
    },
    {
      "id": 130,
      "start": 707.1,
      "end": 713.66,
      "duration": 6.559999999999945,
      "text": "作为交大人 无论在任何岗位上 都要具备这种创新的精神"
    },
    {
      "id": 131,
      "start": 714.2,
      "end": 721.18,
      "duration": 6.9799999999999045,
      "text": "你不敢去探索 不敢去创新 你永远生活在 别人的身影之后"
    },
    {
      "id": 132,
      "start": 722.18,
      "end": 725.8,
      "duration": 3.6200000000000045,
      "text": "（当然）创新不是猛干 创新不是蛮干"
    },
    {
      "id": 133,
      "start": 726.34,
      "end": 732.62,
      "duration": 6.279999999999973,
      "text": "创新是科学的思维 是把握事物的发展规律 是有独到之见解"
    },
    {
      "id": 134,
      "start": 732.62,
      "end": 737.44,
      "duration": 4.82000000000005,
      "text": "是站在了时代的前列 去引领这个时代发展的潮流"
    },
    {
      "id": 135,
      "start": 737.44,
      "end": 744.36,
      "duration": 6.919999999999959,
      "text": "在这个问题上 不分高低贵贱 不分职务大小"
    },
    {
      "id": 136,
      "start": 745.18,
      "end": 750.52,
      "duration": 5.340000000000032,
      "text": "一个具有创新思想的人 在任何一个岗位上 都会闪烁光芒"
    },
    {
      "id": 137,
      "start": 751.32,
      "end": 758.04,
      "duration": 6.719999999999914,
      "text": "我到我们扶贫的乡镇去 看到我们扶贫的老师和年轻的学生"
    },
    {
      "id": 138,
      "start": 758.04,
      "end": 765.36,
      "duration": 7.32000000000005,
      "text": "他们用他们所学 为那个乡村做了很多 让我深感吃惊的事情"
    },
    {
      "id": 139,
      "start": 765.36,
      "end": 770.96,
      "duration": 5.600000000000023,
      "text": "他们把现代技术与乡村经济 紧密地结合起来"
    },
    {
      "id": 140,
      "start": 771.54,
      "end": 779.16,
      "duration": 7.6200000000000045,
      "text": "他们形成了一个很好的小系统的产业 而造福于当地的老百姓 这就是我们的学生"
    },
    {
      "id": 141,
      "start": 780.76,
      "end": 782.58,
      "duration": 1.82000000000005,
      "text": "他们敢闯敢干"
    },
    {
      "id": 142,
      "start": 783.08,
      "end": 786.56,
      "duration": 3.4799999999999045,
      "text": "你们看到了吗 我们一位年轻的学子"
    },
    {
      "id": 143,
      "start": 787.12,
      "end": 792.82,
      "duration": 5.7000000000000455,
      "text": "被华为录取为天才少年 当记者问他的时候 他说什么"
    },
    {
      "id": 144,
      "start": 793.38,
      "end": 797.44,
      "duration": 4.060000000000059,
      "text": "你为什么要到华为来 他说我不是为了高薪"
    },
    {
      "id": 145,
      "start": 798.0,
      "end": 800.26,
      "duration": 2.259999999999991,
      "text": "因为美国在卡我们的脖子"
    },
    {
      "id": 146,
      "start": 800.88,
      "end": 808.34,
      "duration": 7.460000000000036,
      "text": "我们的国家在这个赛道上 必须要走在前面 不能受制于人 我是交大之学子"
    },
    {
      "id": 147,
      "start": 808.34,
      "end": 814.8,
      "duration": 6.459999999999923,
      "text": "我要为解决这个问题 做出我应有的贡献 那个采访者由衷地感叹"
    },
    {
      "id": 148,
      "start": 814.8,
      "end": 821.72,
      "duration": 6.920000000000073,
      "text": "说这是交大学子 他不是为自己学习 他在为国家学习 为民族学习"
    },
    {
      "id": 149,
      "start": 824.64,
      "end": 826.08,
      "duration": 1.4400000000000546,
      "text": "所以想想这一切"
    },
    {
      "id": 150,
      "start": 827.1,
      "end": 830.84,
      "duration": 3.740000000000009,
      "text": "你会感觉到 今天我们的老师"
    },
    {
      "id": 151,
      "start": 831.48,
      "end": 837.22,
      "duration": 5.740000000000009,
      "text": "我们的校友学长 我们的领导书记 给大家的寄语"
    },
    {
      "id": 152,
      "start": 837.22,
      "end": 841.08,
      "duration": 3.8600000000000136,
      "text": "都深深地包含着 这种深层次的含义"
    },
    {
      "id": 153,
      "start": 841.76,
      "end": 849.22,
      "duration": 7.460000000000036,
      "text": "但是能否变为你的内在潜质 需要你们去思考 去感悟 去实践"
    },
    {
      "id": 154,
      "start": 849.22,
      "end": 852.54,
      "duration": 3.3199999999999363,
      "text": "去碰撞 去探索 去创新"
    },
    {
      "id": 155,
      "start": 852.54,
      "end": 859.52,
      "duration": 6.980000000000018,
      "text": "一个良好的信仰 一个家国情怀"
    },
    {
      "id": 156,
      "start": 859.52,
      "end": 864.92,
      "duration": 5.399999999999977,
      "text": "一个坚定不拔的毅力 一个勇于探索的精神"
    },
    {
      "id": 157,
      "start": 864.92,
      "end": 868.42,
      "duration": 3.5,
      "text": "将构成一个人完美的品格"
    },
    {
      "id": 158,
      "start": 869.58,
      "end": 873.02,
      "duration": 3.439999999999941,
      "text": "它将在你的内心深处"
    },
    {
      "id": 159,
      "start": 874.12,
      "end": 877.92,
      "duration": 3.7999999999999545,
      "text": "照亮你未来人生前进的道路"
    },
    {
      "id": 160,
      "start": 878.66,
      "end": 884.5,
      "duration": 5.840000000000032,
      "text": "品格就像一束光 深深地埋在你的心灵深处"
    },
    {
      "id": 161,
      "start": 885.14,
      "end": 891.96,
      "duration": 6.82000000000005,
      "text": "无论它大与小 强与弱 都可以 但唯独不能熄灭"
    },
    {
      "id": 162,
      "start": 892.72,
      "end": 894.24,
      "duration": 1.5199999999999818,
      "text": "因为这是灵魂"
    },
    {
      "id": 163,
      "start": 895.14,
      "end": 896.98,
      "duration": 1.8400000000000318,
      "text": "当你具备了情怀"
    },
    {
      "id": 164,
      "start": 897.78,
      "end": 903.78,
      "duration": 6.0,
      "text": "具备了毅力 具备了敢闯敢试的精神 在实践当中"
    },
    {
      "id": 165,
      "start": 903.78,
      "end": 905.86,
      "duration": 2.080000000000041,
      "text": "你将无往而不胜"
    },
    {
      "id": 166,
      "start": 906.92,
      "end": 914.46,
      "duration": 7.540000000000077,
      "text": "我看到了若干我们交大的学子 在社会各界 无论职务高低 无论岗位如何"
    },
    {
      "id": 167,
      "start": 914.46,
      "end": 917.58,
      "duration": 3.1200000000000045,
      "text": "他们都做出了非常优秀的业绩"
    },
    {
      "id": 168,
      "start": 918.18,
      "end": 925.64,
      "duration": 7.460000000000036,
      "text": "我说平凡人也有伟大的人格 伟大的人也有品格之缺陷"
    },
    {
      "id": 169,
      "start": 925.64,
      "end": 931.62,
      "duration": 5.980000000000018,
      "text": "在这个问题上 道德不分高低贵贱 贫富寡廉"
    },
    {
      "id": 170,
      "start": 931.62,
      "end": 937.88,
      "duration": 6.259999999999991,
      "text": "从这个角度讲 我希望大家 做一个真正的交大人"
    },
    {
      "id": 171,
      "start": 938.88,
      "end": 945.98,
      "duration": 7.100000000000023,
      "text": "做一个精神上 家国情怀 能够与我们国家之命运"
    },
    {
      "id": 172,
      "start": 945.98,
      "end": 953.16,
      "duration": 7.17999999999995,
      "text": "紧密相关的人 做一个博大胸怀的人 能够包容你身边的朋友 同事"
    },
    {
      "id": 173,
      "start": 953.16,
      "end": 954.84,
      "duration": 1.6800000000000637,
      "text": "甚至包容整个世界"
    },
    {
      "id": 174,
      "start": 956.02,
      "end": 961.72,
      "duration": 5.7000000000000455,
      "text": "我们校歌当中有一句话 叫为世界之光 让我感触万千"
    },
    {
      "id": 175,
      "start": 962.72,
      "end": 965.4,
      "duration": 2.67999999999995,
      "text": "我希望同学们永远记住"
    },
    {
      "id": 176,
      "start": 966.88,
      "end": 968.16,
      "duration": 1.2799999999999727,
      "text": "家国情怀"
    },
    {
      "id": 177,
      "start": 969.1,
      "end": 970.82,
      "duration": 1.7200000000000273,
      "text": "坚韧不拔的毅力"
    },
    {
      "id": 178,
      "start": 971.44,
      "end": 973.22,
      "duration": 1.7799999999999727,
      "text": "改革创新的精神"
    },
    {
      "id": 179,
      "start": 973.74,
      "end": 975.56,
      "duration": 1.8199999999999363,
      "text": "将会伴随你们一生"
    },
    {
      "id": 180,
      "start": 976.1,
      "end": 983.62,
      "duration": 7.519999999999982,
      "text": "它是你们的精神财富 是埋藏在你们心目当中 内心深处那一束光"
    },
    {
      "id": 181,
      "start": 983.62,
      "end": 989.42,
      "duration": 5.7999999999999545,
      "text": "祂将照亮你们的人生 让你们成为天地之间"
    },
    {
      "id": 182,
      "start": 989.42,
      "end": 996.5,
      "duration": 7.080000000000041,
      "text": "顶天立地的民族之脊梁 让你们成为世界之光"
    },
    {
      "id": 183,
      "start": 996.5,
      "end": 999.36,
      "duration": 2.8600000000000136,
      "text": "由衷地祝福大家 祝福同学们！"
    }
  ]
}