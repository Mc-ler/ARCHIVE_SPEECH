{
  "source": "..\\output\\2023年研究生毕业演讲.srt",
  "segments": [
    {
      "id": 1,
      "start": 0.75,
      "end": 3.19,
      "duration": 2.44,
      "text": "亲爱的同学们大家好"
    },
    {
      "id": 2,
      "start": 5.13,
      "end": 9.19,
      "duration": 4.06,
      "text": "这是我们第一次在风雨中"
    },
    {
      "id": 3,
      "start": 10.19,
      "end": 14.05,
      "duration": 3.860000000000001,
      "text": "来例行我们的毕业典礼"
    },
    {
      "id": 4,
      "start": 14.97,
      "end": 16.45,
      "duration": 1.4799999999999986,
      "text": "我真的很高兴"
    },
    {
      "id": 5,
      "start": 17.03,
      "end": 19.43,
      "duration": 2.3999999999999986,
      "text": "让暴风雨来得更猛烈些吧"
    },
    {
      "id": 6,
      "start": 24.32,
      "end": 27.9,
      "duration": 3.5799999999999983,
      "text": "尽管我们经历着风雨"
    },
    {
      "id": 7,
      "start": 28.74,
      "end": 36.14,
      "duration": 7.400000000000002,
      "text": "但是我真的不想把我想跟大家说的话留在以后"
    },
    {
      "id": 8,
      "start": 36.14,
      "end": 40.14,
      "duration": 4.0,
      "text": "因为这个太重要了"
    },
    {
      "id": 9,
      "start": 41.22,
      "end": 43.62,
      "duration": 2.3999999999999986,
      "text": "需要我们大家达成共识"
    },
    {
      "id": 10,
      "start": 45.16,
      "end": 47.44,
      "duration": 2.280000000000001,
      "text": "刚才我们的老师代表"
    },
    {
      "id": 11,
      "start": 48.18,
      "end": 49.9,
      "duration": 1.7199999999999989,
      "text": "我们的校友代表"
    },
    {
      "id": 12,
      "start": 50.84,
      "end": 52.5,
      "duration": 1.6599999999999966,
      "text": "我们的学校书记"
    },
    {
      "id": 13,
      "start": 53.32,
      "end": 57.12,
      "duration": 3.799999999999997,
      "text": "都对大家寄予了深切的期望"
    },
    {
      "id": 14,
      "start": 57.12,
      "end": 65.0,
      "duration": 7.880000000000003,
      "text": "阐释了他们对你们未来人生道路所感言感悟"
    },
    {
      "id": 15,
      "start": 65.74,
      "end": 68.58,
      "duration": 2.8400000000000034,
      "text": "但是今天我想跟大家说的是"
    },
    {
      "id": 16,
      "start": 69.48,
      "end": 74.08,
      "duration": 4.599999999999994,
      "text": "在我们这个新的时代我们当如何去做"
    },
    {
      "id": 17,
      "start": 74.08,
      "end": 77.82,
      "duration": 3.739999999999995,
      "text": "所以我想今天跟大家讲三个词"
    },
    {
      "id": 18,
      "start": 78.92,
      "end": 80.38,
      "duration": 1.4599999999999937,
      "text": "新时代"
    },
    {
      "id": 19,
      "start": 81.66,
      "end": 83.06,
      "duration": 1.4000000000000057,
      "text": "新赛道"
    },
    {
      "id": 20,
      "start": 84.08,
      "end": 85.56,
      "duration": 1.480000000000004,
      "text": "新征程"
    },
    {
      "id": 21,
      "start": 88.92,
      "end": 93.69,
      "duration": 4.769999999999996,
      "text": "所以在这样一个新的时代"
    },
    {
      "id": 22,
      "start": 94.19,
      "end": 99.7,
      "duration": 5.510000000000005,
      "text": "何谓新时代第四次工业革命之来临"
    },
    {
      "id": 23,
      "start": 100.58,
      "end": 103.78,
      "duration": 3.200000000000003,
      "text": "将会彻底改变整个世界"
    },
    {
      "id": 24,
      "start": 105.0,
      "end": 106.54,
      "duration": 1.5400000000000063,
      "text": "你们是研究生"
    },
    {
      "id": 25,
      "start": 108.08,
      "end": 115.84,
      "duration": 7.760000000000005,
      "text": "你们经历了研究阶段的学习和训练你们走向社 会将会承担更重要的责任"
    },
    {
      "id": 26,
      "start": 115.84,
      "end": 120.9,
      "duration": 5.060000000000002,
      "text": "而这个新的时代将会改变人类社会未来发展的 进程"
    },
    {
      "id": 27,
      "start": 120.9,
      "end": 124.16,
      "duration": 3.259999999999991,
      "text": "而你们将会有无限的发展空间"
    },
    {
      "id": 28,
      "start": 125.84,
      "end": 130.08,
      "duration": 4.240000000000009,
      "text": "为什么说第四次工业革命将会改变人类社会的 未来进程"
    },
    {
      "id": 29,
      "start": 130.76,
      "end": 135.38,
      "duration": 4.6200000000000045,
      "text": "因为第一次工业革命第二次工业革命第三次工 业革命"
    },
    {
      "id": 30,
      "start": 135.38,
      "end": 143.34,
      "duration": 7.960000000000008,
      "text": "仅仅是在某个单向领域之进展进而带动社会的 发展而第四次工业革命"
    },
    {
      "id": 31,
      "start": 143.34,
      "end": 147.46121212121213,
      "duration": 4.121212121212125,
      "text": "是一个全方位的爆发它是一个质的跃升"
    },
    {
      "id": 32,
      "start": 147.46121212121213,
      "end": 151.34,
      "duration": 3.8787878787878753,
      "text": "是人类社会发展进程当中的一个拐点"
    },
    {
      "id": 33,
      "start": 152.24,
      "end": 158.08,
      "duration": 5.840000000000003,
      "text": "所以我说当你们走向社会的时候你们正经历这 样一个巨变"
    },
    {
      "id": 34,
      "start": 158.08,
      "end": 161.88,
      "duration": 3.799999999999983,
      "text": "而这个巨变将会给你们提供一个大的舞台"
    },
    {
      "id": 35,
      "start": 163.38,
      "end": 164.26,
      "duration": 0.8799999999999955,
      "text": "第二点"
    },
    {
      "id": 36,
      "start": 164.98,
      "end": 166.1,
      "duration": 1.1200000000000045,
      "text": "新赛道"
    },
    {
      "id": 37,
      "start": 167.32,
      "end": 173.4,
      "duration": 6.0800000000000125,
      "text": "新技术的诞生数字技术的涌现各项新技术层出 不穷"
    },
    {
      "id": 38,
      "start": 173.4,
      "end": 175.82,
      "duration": 2.4199999999999875,
      "text": "出现了若干新赛道"
    },
    {
      "id": 39,
      "start": 176.62,
      "end": 183.8,
      "duration": 7.180000000000007,
      "text": "原有的赛道不适用了新的赛道将决定着一个国 家一个民族"
    },
    {
      "id": 40,
      "start": 183.8,
      "end": 191.04,
      "duration": 7.239999999999981,
      "text": "在整个这个时代它的发展进程而恰逢我们国家 民族复兴之大业"
    },
    {
      "id": 41,
      "start": 191.04,
      "end": 197.5,
      "duration": 6.460000000000008,
      "text": "与此同步所以在这个历史进程当中你们能否开 辟新赛道"
    },
    {
      "id": 42,
      "start": 197.5,
      "end": 205.46,
      "duration": 7.960000000000008,
      "text": "能否引领新赛道在这个时代进程当中做时代的 弄潮儿这将考验着我们每一个"
    },
    {
      "id": 43,
      "start": 205.46,
      "end": 207.74,
      "duration": 2.280000000000001,
      "text": "有志于报效国家的人"
    },
    {
      "id": 44,
      "start": 208.24,
      "end": 213.78,
      "duration": 5.539999999999992,
      "text": "而我们是谁我们是西迁精神之传人我们是交大 人"
    },
    {
      "id": 45,
      "start": 214.72,
      "end": 222.06,
      "duration": 7.340000000000003,
      "text": "我们从诞生那一天开始我们学校就把家国心怀 国家兴亡寄予一身"
    },
    {
      "id": 46,
      "start": 222.8,
      "end": 230.62,
      "duration": 7.819999999999993,
      "text": "我们在承担着国家之使命所以在这个新的时代 我们要勇于开辟新赛道要在新赛道上"
    },
    {
      "id": 47,
      "start": 230.62,
      "end": 233.24,
      "duration": 2.6200000000000045,
      "text": "做时代之弄潮儿第三"
    },
    {
      "id": 48,
      "start": 234.28,
      "end": 235.24,
      "duration": 0.960000000000008,
      "text": "新征程"
    },
    {
      "id": 49,
      "start": 236.12,
      "end": 238.92,
      "duration": 2.799999999999983,
      "text": "民族之复兴谈何容易"
    },
    {
      "id": 50,
      "start": 239.76,
      "end": 243.06,
      "duration": 3.3000000000000114,
      "text": "大国博弈区域地缘政治"
    },
    {
      "id": 51,
      "start": 244.1,
      "end": 251.74,
      "duration": 7.640000000000015,
      "text": "技术封锁给我们带来了那么多的干扰但是我们 不能停下脚步"
    },
    {
      "id": 52,
      "start": 252.66,
      "end": 254.56,
      "duration": 1.9000000000000057,
      "text": "我们没有别的路可走"
    },
    {
      "id": 53,
      "start": 255.48,
      "end": 259.7,
      "duration": 4.219999999999999,
      "text": "我们只有大胆的前行就像今天这场风雨一样"
    },
    {
      "id": 54,
      "start": 260.4,
      "end": 262.36,
      "duration": 1.9600000000000364,
      "text": "来吧无所谓"
    },
    {
      "id": 55,
      "start": 262.92,
      "end": 269.56,
      "duration": 6.639999999999986,
      "text": "我们仍然在前进的道路上来例行我们的职责展 示交大人之风采"
    },
    {
      "id": 56,
      "start": 270.26,
      "end": 271.96,
      "duration": 1.6999999999999886,
      "text": "所以新征程"
    },
    {
      "id": 57,
      "start": 272.5,
      "end": 278.5,
      "duration": 6.0,
      "text": "需要我们的不仅仅是勇气需要我们的胆识需要 我们科学的思维"
    },
    {
      "id": 58,
      "start": 278.5,
      "end": 286.26,
      "duration": 7.759999999999991,
      "text": "需要我们超前的思维需要我们去规划未来需要 我们脚踏实地做好当下的工作"
    },
    {
      "id": 59,
      "start": 286.94,
      "end": 292.62,
      "duration": 5.680000000000007,
      "text": "当你们走向社会面临着若干机遇但面临着更大 的挑战"
    },
    {
      "id": 60,
      "start": 292.62,
      "end": 293.087,
      "duration": 0.46699999999998454,
      "text": "很多问题等待着你们去解决，很多赛道等待着 你们去开启，未来的发展之潮流，"
    },
    {
      "id": 61,
      "start": 293.087,
      "end": 293.3601707317073,
      "duration": 0.273170731707296,
      "text": "你们应该是弄潮儿。我由衷的祝福大家，祝愿"
    },
    {
      "id": 62,
      "start": 293.3601707317073,
      "end": 293.647,
      "duration": 0.2868292682927063,
      "text": "同学们，在这个新的时代，在这个新的征程上，"
    },
    {
      "id": 63,
      "start": 293.647,
      "end": 294.447,
      "duration": 0.8000000000000114,
      "text": "再展交大人之风采，让交大人为世界之光。祝 福大家。"
    }
  ]
}