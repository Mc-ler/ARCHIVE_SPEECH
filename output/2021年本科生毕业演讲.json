{
  "source": "output\\2021年本科生毕业演讲.srt",
  "segments": [
    {
      "id": 1,
      "start": 1.1400000000000001,
      "end": 4.5600000000000005,
      "duration": 3.4200000000000004,
      "text": "家长朋友们、各位老师、各位来宾大家好"
    },
    {
      "id": 2,
      "start": 14.26,
      "end": 19.28,
      "duration": 5.020000000000001,
      "text": "这是我第一次没有穿学位服"
    },
    {
      "id": 3,
      "start": 20.8,
      "end": 25.72,
      "duration": 4.919999999999998,
      "text": "来面对所有的毕业生做毕业致辞"
    },
    {
      "id": 4,
      "start": 29.54,
      "end": 30.34,
      "duration": 0.8000000000000007,
      "text": "为什么"
    },
    {
      "id": 5,
      "start": 34.1,
      "end": 36.36,
      "duration": 2.259999999999998,
      "text": "因为今年是一个特殊的时期"
    },
    {
      "id": 6,
      "start": 38.61,
      "end": 42.89,
      "duration": 4.280000000000001,
      "text": "今年是中国共产党建党百年"
    },
    {
      "id": 7,
      "start": 46.83,
      "end": 48.61,
      "duration": 1.7800000000000011,
      "text": "习近平总书记"
    },
    {
      "id": 8,
      "start": 49.67,
      "end": 52.45,
      "duration": 2.780000000000001,
      "text": "在建党百年庆典上"
    },
    {
      "id": 9,
      "start": 53.11,
      "end": 58.31,
      "duration": 5.200000000000003,
      "text": "向全球发表了重要的讲话，昭示"
    },
    {
      "id": 10,
      "start": 58.91,
      "end": 65.03,
      "duration": 6.1200000000000045,
      "text": "中华民族将向民族复兴之百年目标"
    },
    {
      "id": 11,
      "start": 66.13,
      "end": 70.86,
      "duration": 4.730000000000004,
      "text": "征程前进 一个庄严的宣告"
    },
    {
      "id": 12,
      "start": 70.86,
      "end": 74.61,
      "duration": 3.75,
      "text": "百年征程"
    },
    {
      "id": 13,
      "start": 76.03,
      "end": 78.93,
      "duration": 2.9000000000000057,
      "text": "中华民族走过了艰辛的历程"
    },
    {
      "id": 14,
      "start": 79.93,
      "end": 81.81,
      "duration": 1.8799999999999955,
      "text": "取得了今日之辉煌"
    },
    {
      "id": 15,
      "start": 85.84,
      "end": 87.02,
      "duration": 1.1799999999999926,
      "text": "第二点"
    },
    {
      "id": 16,
      "start": 88.6,
      "end": 89.78,
      "duration": 1.1800000000000068,
      "text": "当今世界"
    },
    {
      "id": 17,
      "start": 91.1,
      "end": 92.26,
      "duration": 1.1600000000000108,
      "text": "风云变幻"
    },
    {
      "id": 18,
      "start": 93.96,
      "end": 97.02,
      "duration": 3.0600000000000023,
      "text": "我们正处在一个百年未雨之大变局"
    },
    {
      "id": 19,
      "start": 97.52,
      "end": 98.9,
      "duration": 1.3800000000000097,
      "text": "这样一个变动之中"
    },
    {
      "id": 20,
      "start": 100.89,
      "end": 102.65,
      "duration": 1.7600000000000051,
      "text": "新的技术革命来临"
    },
    {
      "id": 21,
      "start": 103.73,
      "end": 106.03,
      "duration": 2.299999999999997,
      "text": "在深刻地改变这个世界"
    },
    {
      "id": 22,
      "start": 108.78,
      "end": 114.62,
      "duration": 5.840000000000003,
      "text": "在这两个大局的背景下 而你们，恰恰在这个最关键的时间节点"
    },
    {
      "id": 23,
      "start": 115.66,
      "end": 117.14,
      "duration": 1.480000000000004,
      "text": "完成了你们的学业"
    },
    {
      "id": 24,
      "start": 118.48,
      "end": 124.73,
      "duration": 6.25,
      "text": "即将踏上新的征程 所以我更愿意以素装"
    },
    {
      "id": 25,
      "start": 125.93,
      "end": 127.09,
      "duration": 1.1599999999999966,
      "text": "来面对大家"
    },
    {
      "id": 26,
      "start": 128.01,
      "end": 130.63,
      "duration": 2.6200000000000045,
      "text": "让我们记住这个时刻"
    },
    {
      "id": 27,
      "start": 130.63,
      "end": 134.95999999999998,
      "duration": 4.329999999999984,
      "text": "同学们一"
    },
    {
      "id": 28,
      "start": 134.95999999999998,
      "end": 139.29,
      "duration": 4.3300000000000125,
      "text": "定要记住"
    },
    {
      "id": 29,
      "start": 139.29,
      "end": 140.83,
      "duration": 1.5400000000000205,
      "text": "2021年"
    },
    {
      "id": 30,
      "start": 143.78,
      "end": 145.3,
      "duration": 1.5200000000000102,
      "text": "这是一个伟大的时刻"
    },
    {
      "id": 31,
      "start": 147.89,
      "end": 150.61,
      "duration": 2.7200000000000273,
      "text": "当你们在经过十年、二十年"
    },
    {
      "id": 32,
      "start": 151.41,
      "end": 156.17,
      "duration": 4.759999999999991,
      "text": "在回首往事的时候 你们一定会为此感到自豪"
    },
    {
      "id": 33,
      "start": 163.97,
      "end": 166.31,
      "duration": 2.3400000000000034,
      "text": "2021年，无论对中国对世界"
    },
    {
      "id": 34,
      "start": 167.91,
      "end": 169.83,
      "duration": 1.920000000000016,
      "text": "都是一个值得纪念的时刻"
    },
    {
      "id": 35,
      "start": 171.11,
      "end": 173.39,
      "duration": 2.2799999999999727,
      "text": "它预示着一个新的时代的开始"
    },
    {
      "id": 36,
      "start": 175.81,
      "end": 177.77,
      "duration": 1.960000000000008,
      "text": "整个世界在进行重构"
    },
    {
      "id": 37,
      "start": 179.33,
      "end": 182.79,
      "duration": 3.4599999999999795,
      "text": "中华民族在奔向民族复兴之伟大目标"
    },
    {
      "id": 38,
      "start": 184.37,
      "end": 187.25,
      "duration": 2.8799999999999955,
      "text": "全世界将塑造一种新的世界文明"
    },
    {
      "id": 39,
      "start": 188.53,
      "end": 192.53,
      "duration": 4.0,
      "text": "第四次工业革命冲击 一定会深刻地改变世界"
    },
    {
      "id": 40,
      "start": 193.77,
      "end": 197.15,
      "duration": 3.3799999999999955,
      "text": "在这样一个时代背景下 你们启航了"
    },
    {
      "id": 41,
      "start": 198.65,
      "end": 200.49,
      "duration": 1.8400000000000034,
      "text": "你们将奔向新的政策"
    },
    {
      "id": 42,
      "start": 201.49,
      "end": 206.78,
      "duration": 5.289999999999992,
      "text": "未来当如何去做 前面我们的老师"
    },
    {
      "id": 43,
      "start": 207.92,
      "end": 209.4,
      "duration": 1.4800000000000182,
      "text": "我们的学生家长"
    },
    {
      "id": 44,
      "start": 210.08,
      "end": 211.44,
      "duration": 1.3599999999999852,
      "text": "我们的校友代表"
    },
    {
      "id": 45,
      "start": 212.62,
      "end": 215.3,
      "duration": 2.680000000000007,
      "text": "都把他们的肺腑之言 真知灼见"
    },
    {
      "id": 46,
      "start": 215.8,
      "end": 218.34,
      "duration": 2.539999999999992,
      "text": "毫无保留地奉献给大家"
    },
    {
      "id": 47,
      "start": 221.7,
      "end": 223.86,
      "duration": 2.160000000000025,
      "text": "在他们所谈的内容之外"
    },
    {
      "id": 48,
      "start": 224.72,
      "end": 229.88,
      "duration": 5.159999999999997,
      "text": "我更想聚焦于总书记在七一庆典大会上"
    },
    {
      "id": 49,
      "start": 229.88,
      "end": 233.26,
      "duration": 3.3799999999999955,
      "text": "所谈到的对青年的期待"
    },
    {
      "id": 50,
      "start": 233.26,
      "end": 239.78,
      "duration": 6.52000000000001,
      "text": "那就是志气、骨气和底气"
    },
    {
      "id": 51,
      "start": 239.78,
      "end": 247.48,
      "duration": 7.699999999999989,
      "text": "何谓志气 志气来源于情怀"
    },
    {
      "id": 52,
      "start": 248.66,
      "end": 254.95,
      "duration": 6.289999999999992,
      "text": "一个没有家国情怀的人谈不上志气 青年毛泽东"
    },
    {
      "id": 53,
      "start": 255.77,
      "end": 257.87,
      "duration": 2.0999999999999943,
      "text": "26岁1919年"
    },
    {
      "id": 54,
      "start": 258.77,
      "end": 262.15,
      "duration": 3.3799999999999955,
      "text": "在他创刊的 《湘江评论》创刊号上"
    },
    {
      "id": 55,
      "start": 263.01,
      "end": 264.49,
      "duration": 1.4800000000000182,
      "text": "大声呼吁"
    },
    {
      "id": 56,
      "start": 265.97,
      "end": 267.09,
      "duration": 1.1199999999999477,
      "text": "天下者"
    },
    {
      "id": 57,
      "start": 267.67,
      "end": 268.97,
      "duration": 1.3000000000000114,
      "text": "我们的天下"
    },
    {
      "id": 58,
      "start": 269.81,
      "end": 275.35,
      "duration": 5.5400000000000205,
      "text": "国家者 我们的国家 社会者 我们的社会"
    },
    {
      "id": 59,
      "start": 276.11,
      "end": 280.15,
      "duration": 4.039999999999964,
      "text": "我们不说 谁说 我们不干 谁干"
    },
    {
      "id": 60,
      "start": 281.41,
      "end": 285.79,
      "duration": 4.3799999999999955,
      "text": "一个年轻人 一个年仅26岁的年轻人"
    },
    {
      "id": 61,
      "start": 286.41,
      "end": 288.67,
      "duration": 2.259999999999991,
      "text": "能发出这样的豪言壮语"
    },
    {
      "id": 62,
      "start": 289.69,
      "end": 292.65,
      "duration": 2.9599999999999795,
      "text": "他心中有民族 心中有国家"
    },
    {
      "id": 63,
      "start": 293.71,
      "end": 296.29,
      "duration": 2.580000000000041,
      "text": "他看到了国家身处危亡之中"
    },
    {
      "id": 64,
      "start": 297.17,
      "end": 301.43,
      "duration": 4.259999999999991,
      "text": "发自内心的呐喊 正就国家与民族与危亡之中"
    },
    {
      "id": 65,
      "start": 303.01,
      "end": 309.35,
      "duration": 6.340000000000032,
      "text": "由此出现了 陈独秀、李大钊 一批早期的共产党人 创办了中国共产党"
    },
    {
      "id": 66,
      "start": 310.39,
      "end": 315.05,
      "duration": 4.660000000000025,
      "text": "才有了我们中国共产党 和我们全国人民 百年的辉煌历史"
    },
    {
      "id": 67,
      "start": 315.05,
      "end": 319.39,
      "duration": 4.339999999999975,
      "text": "志气是什么"
    },
    {
      "id": 68,
      "start": 319.39,
      "end": 325.66,
      "duration": 6.270000000000039,
      "text": "志气是对国家 对民族的忠诚"
    },
    {
      "id": 69,
      "start": 328.28,
      "end": 329.64,
      "duration": 1.3600000000000136,
      "text": "大家都知道"
    },
    {
      "id": 70,
      "start": 330.6,
      "end": 338.0,
      "duration": 7.399999999999977,
      "text": "陈独秀两个儿子 都成为我们党早期的英烈 为了党的事业 抛弃了生命"
    },
    {
      "id": 71,
      "start": 338.0,
      "end": 341.16,
      "duration": 3.160000000000025,
      "text": "陈乔年"
    },
    {
      "id": 72,
      "start": 342.58,
      "end": 345.92,
      "duration": 3.340000000000032,
      "text": "当走上刑场的时候 他大义凛然"
    },
    {
      "id": 73,
      "start": 346.84,
      "end": 347.98,
      "duration": 1.1400000000000432,
      "text": "毫无惧色"
    },
    {
      "id": 74,
      "start": 349.44,
      "end": 350.76,
      "duration": 1.3199999999999932,
      "text": "他说的是什么"
    },
    {
      "id": 75,
      "start": 351.92,
      "end": 357.38,
      "duration": 5.4599999999999795,
      "text": "让我们前辈的披荆斩棘 能换来我们后代子孙的幸福生活"
    },
    {
      "id": 76,
      "start": 360.97,
      "end": 366.39,
      "duration": 5.419999999999959,
      "text": "这是志气 心中有家国 心中有人民"
    },
    {
      "id": 77,
      "start": 369.62,
      "end": 370.42,
      "duration": 0.8000000000000114,
      "text": "志气是什么"
    },
    {
      "id": 78,
      "start": 371.94,
      "end": 373.3,
      "duration": 1.3600000000000136,
      "text": "志气是贡献"
    },
    {
      "id": 79,
      "start": 375.89,
      "end": 377.55,
      "duration": 1.660000000000025,
      "text": "他们脚踏实地的"
    },
    {
      "id": 80,
      "start": 378.11,
      "end": 382.35,
      "duration": 4.240000000000009,
      "text": "为了这个国家 为了这个民族 不惜抛头颅洒热血"
    },
    {
      "id": 81,
      "start": 384.89,
      "end": 386.83,
      "duration": 1.9399999999999977,
      "text": "我们身边何尝不是如此"
    },
    {
      "id": 82,
      "start": 388.33,
      "end": 389.85,
      "duration": 1.5200000000000387,
      "text": "我们西迁的老一辈"
    },
    {
      "id": 83,
      "start": 390.89,
      "end": 393.11,
      "duration": 2.2200000000000273,
      "text": "从繁华的黄埔江畔"
    },
    {
      "id": 84,
      "start": 393.69,
      "end": 395.33,
      "duration": 1.6399999999999864,
      "text": "响应国家之号召"
    },
    {
      "id": 85,
      "start": 396.19,
      "end": 397.57,
      "duration": 1.3799999999999955,
      "text": "来到了渭水之滨"
    },
    {
      "id": 86,
      "start": 399.01,
      "end": 400.43,
      "duration": 1.420000000000016,
      "text": "他们想到了自己吗"
    },
    {
      "id": 87,
      "start": 401.05,
      "end": 401.85,
      "duration": 0.8000000000000114,
      "text": "没有"
    },
    {
      "id": 88,
      "start": 402.33,
      "end": 404.21,
      "duration": 1.8799999999999955,
      "text": "他们想的是国家、是民族"
    },
    {
      "id": 89,
      "start": 404.93,
      "end": 411.19,
      "duration": 6.259999999999991,
      "text": "我是民族一份子 我应该为这个国家 为民族之未来 做出我们应有的贡献"
    },
    {
      "id": 90,
      "start": 413.64,
      "end": 414.82,
      "duration": 1.1800000000000068,
      "text": "在他们心中"
    },
    {
      "id": 91,
      "start": 415.7,
      "end": 417.22,
      "duration": 1.5200000000000387,
      "text": "国家民族至上"
    },
    {
      "id": 92,
      "start": 417.76,
      "end": 419.1,
      "duration": 1.3400000000000318,
      "text": "人民的利益至上"
    },
    {
      "id": 93,
      "start": 420.54,
      "end": 421.8,
      "duration": 1.259999999999991,
      "text": "这才叫志气"
    },
    {
      "id": 94,
      "start": 423.78,
      "end": 424.8,
      "duration": 1.0200000000000387,
      "text": "骨气是什么"
    },
    {
      "id": 95,
      "start": 426.1,
      "end": 427.16,
      "duration": 1.0600000000000023,
      "text": "骨气是自信"
    },
    {
      "id": 96,
      "start": 430.22,
      "end": 432.8,
      "duration": 2.579999999999984,
      "text": "一个没有自信的人 没有骨气"
    },
    {
      "id": 97,
      "start": 434.18,
      "end": 440.96,
      "duration": 6.779999999999973,
      "text": "软骨头 永远挺不起民族之脊梁 自信何来"
    },
    {
      "id": 98,
      "start": 440.96,
      "end": 445.96,
      "duration": 5.0,
      "text": "自信源于我们中华民族 五千年的文明"
    },
    {
      "id": 99,
      "start": 447.1,
      "end": 448.52,
      "duration": 1.419999999999959,
      "text": "源于党的领导"
    },
    {
      "id": 100,
      "start": 449.02,
      "end": 453.42,
      "duration": 4.400000000000034,
      "text": "源于我们百年的艰苦奋斗 源于今天的建设成就"
    },
    {
      "id": 101,
      "start": 453.42,
      "end": 459.38,
      "duration": 5.9599999999999795,
      "text": "我们不能没有骨气"
    },
    {
      "id": 102,
      "start": 459.38,
      "end": 464.15,
      "duration": 4.769999999999982,
      "text": "若干年我们受帝国列强之欺辱"
    },
    {
      "id": 103,
      "start": 465.65,
      "end": 469.13,
      "duration": 3.480000000000018,
      "text": "今天我们将走向强盛 走向民族之复兴"
    },
    {
      "id": 104,
      "start": 470.33,
      "end": 474.27,
      "duration": 3.9399999999999977,
      "text": "你们作为这个时代的年轻人 未来属于你们"
    },
    {
      "id": 105,
      "start": 475.61,
      "end": 476.89,
      "duration": 1.2799999999999727,
      "text": "2050年"
    },
    {
      "id": 106,
      "start": 477.77,
      "end": 483.85,
      "duration": 6.080000000000041,
      "text": "当我们建国百年的时候 民族复兴之大业将在你们手中建成"
    },
    {
      "id": 107,
      "start": 484.81,
      "end": 487.23,
      "duration": 2.420000000000016,
      "text": "你们是这个伟大时代的参与者"
    },
    {
      "id": 108,
      "start": 487.97,
      "end": 488.89,
      "duration": 0.9199999999999591,
      "text": "贡献者"
    },
    {
      "id": 109,
      "start": 489.61,
      "end": 495.05,
      "duration": 5.439999999999998,
      "text": "你们应该为此感到自豪 没有骨气玩不成这样伟大的事业"
    },
    {
      "id": 110,
      "start": 497.22,
      "end": 498.18,
      "duration": 0.9599999999999795,
      "text": "骨气是什么"
    },
    {
      "id": 111,
      "start": 499.28,
      "end": 506.09,
      "duration": 6.810000000000002,
      "text": "骨气是贡献 多少人 为了今天的奋斗目标"
    },
    {
      "id": 112,
      "start": 506.09,
      "end": 508.39,
      "duration": 2.3000000000000114,
      "text": "为了今天目标的实现"
    },
    {
      "id": 113,
      "start": 508.95,
      "end": 510.45,
      "duration": 1.5,
      "text": "奉献了他们的一生"
    },
    {
      "id": 114,
      "start": 511.89,
      "end": 513.41,
      "duration": 1.5199999999999818,
      "text": "默默无闻也罢"
    },
    {
      "id": 115,
      "start": 513.95,
      "end": 515.67,
      "duration": 1.7199999999999136,
      "text": "隐姓埋名也罢"
    },
    {
      "id": 116,
      "start": 516.17,
      "end": 522.13,
      "duration": 5.960000000000036,
      "text": "在一个小的岗位上 在一个不起眼的地方 奉献了他光辉的一生"
    },
    {
      "id": 117,
      "start": 522.13,
      "end": 527.85,
      "duration": 5.720000000000027,
      "text": "展现出光芒才华 这一切一切 都是我们身边的英雄人物"
    },
    {
      "id": 118,
      "start": 529.11,
      "end": 531.23,
      "duration": 2.1200000000000045,
      "text": "他们是我们这个民族的代表"
    },
    {
      "id": 119,
      "start": 532.21,
      "end": 535.01,
      "duration": 2.7999999999999545,
      "text": "他们身上有我们民族的骨气"
    },
    {
      "id": 120,
      "start": 539.55,
      "end": 540.75,
      "duration": 1.2000000000000455,
      "text": "第三个是底气"
    },
    {
      "id": 121,
      "start": 543.2,
      "end": 549.56,
      "duration": 6.3599999999999,
      "text": "怎么能够做到有底气 底气来源于能力"
    },
    {
      "id": 122,
      "start": 551.78,
      "end": 553.54,
      "duration": 1.759999999999991,
      "text": "你没有真才实学"
    },
    {
      "id": 123,
      "start": 554.9,
      "end": 558.82,
      "duration": 3.9200000000000728,
      "text": "你不能为这个社会的进步做出贡献 何来底气之说"
    },
    {
      "id": 124,
      "start": 561.84,
      "end": 565.14,
      "duration": 3.2999999999999545,
      "text": "第四次工业革命的来临 如此之激烈"
    },
    {
      "id": 125,
      "start": 567.74,
      "end": 572.34,
      "duration": 4.600000000000023,
      "text": "还有很多未来的科学技术之发现 有待于你们去完成"
    },
    {
      "id": 126,
      "start": 574.81,
      "end": 578.69,
      "duration": 3.880000000000109,
      "text": "如果我们不能深刻地把握 时代发展的规律"
    },
    {
      "id": 127,
      "start": 579.91,
      "end": 582.07,
      "duration": 2.160000000000082,
      "text": "不能把握科学发展的规律"
    },
    {
      "id": 128,
      "start": 584.02,
      "end": 585.06,
      "duration": 1.0399999999999636,
      "text": "不能为此"
    },
    {
      "id": 129,
      "start": 585.54,
      "end": 590.82,
      "duration": 5.280000000000086,
      "text": "在这个发展之中 贡献我们的聪明才智 何来底气之说"
    },
    {
      "id": 130,
      "start": 593.86,
      "end": 596.2,
      "duration": 2.340000000000032,
      "text": "有底气的人都是有能力的人"
    },
    {
      "id": 131,
      "start": 597.32,
      "end": 603.7,
      "duration": 6.3799999999999955,
      "text": "有底气的人都是有贡献的人 有底气的人都是有作为的人 无论他在什么岗位上"
    },
    {
      "id": 132,
      "start": 604.4,
      "end": 610.52,
      "duration": 6.1200000000000045,
      "text": "哪怕他是一个小小的职员 哪怕他是一个普通的工人 哪怕他是一个农民"
    },
    {
      "id": 133,
      "start": 610.52,
      "end": 615.08,
      "duration": 4.560000000000059,
      "text": "只要他有这份理想 有这份信念 有这份追求"
    },
    {
      "id": 134,
      "start": 615.58,
      "end": 620.56,
      "duration": 4.9799999999999045,
      "text": "他所在的那个岗位 他所做的贡献 一定是一个大舞台"
    },
    {
      "id": 135,
      "start": 620.56,
      "end": 624.64,
      "duration": 4.080000000000041,
      "text": "大家看到了这次七一表彰"
    },
    {
      "id": 136,
      "start": 625.26,
      "end": 628.6,
      "duration": 3.340000000000032,
      "text": "有一位来自于山区的教师 张老师"
    },
    {
      "id": 137,
      "start": 630.53,
      "end": 632.19,
      "duration": 1.6600000000000819,
      "text": "培养了那么多的女孩子"
    },
    {
      "id": 138,
      "start": 633.25,
      "end": 635.39,
      "duration": 2.1399999999999864,
      "text": "她心中有梦想、有追求"
    },
    {
      "id": 139,
      "start": 636.13,
      "end": 643.43,
      "duration": 7.2999999999999545,
      "text": "她知道他所做的一切 正是为了我们这个民族未来的复兴 他知道中国的孩子们"
    },
    {
      "id": 140,
      "start": 643.43,
      "end": 645.13,
      "duration": 1.7000000000000455,
      "text": "不能没有知识 没有文化"
    },
    {
      "id": 141,
      "start": 646.45,
      "end": 649.67,
      "duration": 3.2199999999999136,
      "text": "一个浅显的道理 铸就了辉煌的一生"
    },
    {
      "id": 142,
      "start": 651.71,
      "end": 653.67,
      "duration": 1.9599999999999227,
      "text": "这是他做人的底气所在"
    },
    {
      "id": 143,
      "start": 656.28,
      "end": 659.32,
      "duration": 3.0400000000000773,
      "text": "所以总书记讲 我们年轻人"
    },
    {
      "id": 144,
      "start": 659.82,
      "end": 660.86,
      "duration": 1.0399999999999636,
      "text": "要有骨气"
    },
    {
      "id": 145,
      "start": 661.4,
      "end": 667.05,
      "duration": 5.649999999999977,
      "text": "要有志气 要有底气 做不到这三点"
    },
    {
      "id": 146,
      "start": 667.57,
      "end": 668.87,
      "duration": 1.2999999999999545,
      "text": "谈何接班人"
    },
    {
      "id": 147,
      "start": 670.23,
      "end": 673.75,
      "duration": 3.519999999999982,
      "text": "做不到这一点 谈何国家民族之脊梁"
    },
    {
      "id": 148,
      "start": 675.91,
      "end": 677.05,
      "duration": 1.1399999999999864,
      "text": "我们是交大人"
    },
    {
      "id": 149,
      "start": 678.07,
      "end": 679.85,
      "duration": 1.7799999999999727,
      "text": "我们有着光荣的传统"
    },
    {
      "id": 150,
      "start": 680.59,
      "end": 683.33,
      "duration": 2.740000000000009,
      "text": "西迁精神总书记给了精辟的解释"
    },
    {
      "id": 151,
      "start": 683.77,
      "end": 691.23,
      "duration": 7.460000000000036,
      "text": "西迁精神的核心是爱国主义 精髓是听党指挥跟党走 与党和国家民族与人民"
    },
    {
      "id": 152,
      "start": 691.23,
      "end": 692.67,
      "duration": 1.4399999999999409,
      "text": "同呼吸共命运"
    },
    {
      "id": 153,
      "start": 693.81,
      "end": 696.73,
      "duration": 2.9200000000000728,
      "text": "一个伟大的时代 从今日之开始"
    },
    {
      "id": 154,
      "start": 697.71,
      "end": 701.89,
      "duration": 4.17999999999995,
      "text": "而你们就是在这个关键的时刻 踏上了新的征程"
    },
    {
      "id": 155,
      "start": 701.89,
      "end": 707.76,
      "duration": 5.8700000000000045,
      "text": "当你们回首往事的时候 你们一定会感慨"
    },
    {
      "id": 156,
      "start": 708.68,
      "end": 715.66,
      "duration": 6.980000000000018,
      "text": "我们是这个时代的奉献者 我们是这个时代的参与者 在这个时代的进程当中"
    },
    {
      "id": 157,
      "start": 715.66,
      "end": 722.18,
      "duration": 6.519999999999982,
      "text": "有我们的汗水 有我们的脚印 有我们的贡献 我们无愧于中华民族之传人"
    },
    {
      "id": 158,
      "start": 722.18,
      "end": 724.0,
      "duration": 1.82000000000005,
      "text": "我们无愧于交大人"
    },
    {
      "id": 159,
      "start": 730.22,
      "end": 731.26,
      "duration": 1.0399999999999636,
      "text": "所以同学们"
    },
    {
      "id": 160,
      "start": 732.46,
      "end": 733.94,
      "duration": 1.4800000000000182,
      "text": "在这个伟大时代"
    },
    {
      "id": 161,
      "start": 734.68,
      "end": 736.74,
      "duration": 2.060000000000059,
      "text": "在这个时代的重要时刻"
    },
    {
      "id": 162,
      "start": 737.78,
      "end": 739.8,
      "duration": 2.019999999999982,
      "text": "我向大家说出这些话"
    },
    {
      "id": 163,
      "start": 740.3,
      "end": 744.04,
      "duration": 3.740000000000009,
      "text": "你们可能不知道 昨夜我一夜未眠"
    },
    {
      "id": 164,
      "start": 747.5,
      "end": 753.28,
      "duration": 5.779999999999973,
      "text": "面对这样一个关键的时刻 面对你们在这个关键时刻 即将出征的交大人"
    },
    {
      "id": 165,
      "start": 755.27,
      "end": 756.73,
      "duration": 1.4600000000000364,
      "text": "我反复地思考"
    },
    {
      "id": 166,
      "start": 758.08,
      "end": 759.94,
      "duration": 1.8600000000000136,
      "text": "不知道从何谈起"
    },
    {
      "id": 167,
      "start": 763.26,
      "end": 764.82,
      "duration": 1.5600000000000591,
      "text": "一夜的思考归来"
    },
    {
      "id": 168,
      "start": 765.86,
      "end": 769.28,
      "duration": 3.419999999999959,
      "text": "志气、骨气、底气三个字 三个词"
    },
    {
      "id": 169,
      "start": 770.64,
      "end": 771.78,
      "duration": 1.1399999999999864,
      "text": "让我找到了"
    },
    {
      "id": 170,
      "start": 772.78,
      "end": 774.48,
      "duration": 1.7000000000000455,
      "text": "今天致辞的落脚点"
    },
    {
      "id": 171,
      "start": 775.58,
      "end": 776.9,
      "duration": 1.3199999999999363,
      "text": "也是我们共勉"
    },
    {
      "id": 172,
      "start": 779.69,
      "end": 780.85,
      "duration": 1.1599999999999682,
      "text": "毛泽东同志"
    },
    {
      "id": 173,
      "start": 782.07,
      "end": 783.59,
      "duration": 1.5199999999999818,
      "text": "在莫斯科大学"
    },
    {
      "id": 174,
      "start": 784.09,
      "end": 789.39,
      "duration": 5.2999999999999545,
      "text": "向中国留学生 所讲的那段话 激励了一代又一代的人"
    },
    {
      "id": 175,
      "start": 790.29,
      "end": 792.07,
      "duration": 1.7800000000000864,
      "text": "他讲世界是你们的"
    },
    {
      "id": 176,
      "start": 792.83,
      "end": 793.87,
      "duration": 1.0399999999999636,
      "text": "也是我们的"
    },
    {
      "id": 177,
      "start": 794.47,
      "end": 796.43,
      "duration": 1.9599999999999227,
      "text": "但归根结底是你们的"
    },
    {
      "id": 178,
      "start": 797.03,
      "end": 801.19,
      "duration": 4.160000000000082,
      "text": "你们青年人朝气蓬勃 就像早晨八九点钟的太阳"
    },
    {
      "id": 179,
      "start": 802.07,
      "end": 803.93,
      "duration": 1.8599999999999,
      "text": "希望寄托在你们身上"
    },
    {
      "id": 180,
      "start": 806.46,
      "end": 809.36,
      "duration": 2.8999999999999773,
      "text": "现在回想起领袖毛泽东所说的这些话"
    },
    {
      "id": 181,
      "start": 810.34,
      "end": 812.84,
      "duration": 2.5,
      "text": "仍然对今天对你们的未来"
    },
    {
      "id": 182,
      "start": 813.36,
      "end": 814.84,
      "duration": 1.4800000000000182,
      "text": "具有重要的意义"
    },
    {
      "id": 183,
      "start": 816.21,
      "end": 818.49,
      "duration": 2.2799999999999727,
      "text": "你们是民族未来之希望"
    },
    {
      "id": 184,
      "start": 819.53,
      "end": 821.17,
      "duration": 1.6399999999999864,
      "text": "是民族之传承者"
    },
    {
      "id": 185,
      "start": 822.29,
      "end": 825.45,
      "duration": 3.160000000000082,
      "text": "你们踏上这个伟大的征程 面临着很多挑战"
    },
    {
      "id": 186,
      "start": 826.79,
      "end": 828.17,
      "duration": 1.3799999999999955,
      "text": "你们将如何面对"
    },
    {
      "id": 187,
      "start": 829.37,
      "end": 834.37,
      "duration": 5.0,
      "text": "没有志气 没有骨气 没有底气 无法应对这个变化"
    },
    {
      "id": 188,
      "start": 835.19,
      "end": 837.09,
      "duration": 1.8999999999999773,
      "text": "莫测的这样一个世界格局"
    },
    {
      "id": 189,
      "start": 837.59,
      "end": 842.83,
      "duration": 5.240000000000009,
      "text": "无法面对新的技术革命 所带来的挑战 但是我相信、我坚信"
    },
    {
      "id": 190,
      "start": 843.81,
      "end": 845.15,
      "duration": 1.3400000000000318,
      "text": "你们有这种能力"
    },
    {
      "id": 191,
      "start": 845.91,
      "end": 847.97,
      "duration": 2.060000000000059,
      "text": "因为你们的表现已经证明"
    },
    {
      "id": 192,
      "start": 848.53,
      "end": 854.13,
      "duration": 5.600000000000023,
      "text": "爱国情怀、西迁精神 已经在你们心中 深深地扎下了根"
    },
    {
      "id": 193,
      "start": 855.27,
      "end": 857.37,
      "duration": 2.1000000000000227,
      "text": "有了这种情怀 有了这种追求"
    },
    {
      "id": 194,
      "start": 857.83,
      "end": 859.19,
      "duration": 1.3600000000000136,
      "text": "你们将无往而不胜"
    },
    {
      "id": 195,
      "start": 859.67,
      "end": 866.35,
      "duration": 6.680000000000064,
      "text": "无论在什么岗位上 都会看到焦大人的风采 无论在什么岗位上 大家都会说交大人"
    },
    {
      "id": 196,
      "start": 866.35,
      "end": 869.05,
      "duration": 2.699999999999932,
      "text": "是我们国家之希望 民族之脊梁"
    },
    {
      "id": 197,
      "start": 874.25,
      "end": 875.05,
      "duration": 0.7999999999999545,
      "text": "同学们"
    },
    {
      "id": 198,
      "start": 877.58,
      "end": 878.38,
      "duration": 0.7999999999999545,
      "text": "我们今天的"
    },
    {
      "id": 199,
      "start": 880.24,
      "end": 881.5,
      "duration": 1.259999999999991,
      "text": "所考虑的问题"
    },
    {
      "id": 200,
      "start": 882.22,
      "end": 884.04,
      "duration": 1.8199999999999363,
      "text": "不仅仅局限于中国"
    },
    {
      "id": 201,
      "start": 885.86,
      "end": 889.66,
      "duration": 3.7999999999999545,
      "text": "21世纪 整个世界要发生剧烈的改变"
    },
    {
      "id": 202,
      "start": 890.92,
      "end": 896.24,
      "duration": 5.32000000000005,
      "text": "总书记提出了 人类命运共同体的价值理念 这是一种新的文明"
    },
    {
      "id": 203,
      "start": 899.13,
      "end": 904.05,
      "duration": 4.919999999999959,
      "text": "国外政党如何评价中国共产党 说中国共产党不是一个党"
    },
    {
      "id": 204,
      "start": 904.67,
      "end": 906.01,
      "duration": 1.3400000000000318,
      "text": "是一种文明"
    },
    {
      "id": 205,
      "start": 908.68,
      "end": 912.78,
      "duration": 4.100000000000023,
      "text": "所以当我们真正实现民族之富相 走向世界舞台中心的时候"
    },
    {
      "id": 206,
      "start": 913.6,
      "end": 920.3,
      "duration": 6.699999999999932,
      "text": "我们将承担着一个更大的重任 那就是要引领全球 走向一个更文明"
    },
    {
      "id": 207,
      "start": 920.3,
      "end": 921.72,
      "duration": 1.4200000000000728,
      "text": "更辉煌的未来"
    },
    {
      "id": 208,
      "start": 922.64,
      "end": 928.2,
      "duration": 5.560000000000059,
      "text": "要让全世界所有的民众 都能够在一个更美好的未来 去生活、去工作"
    },
    {
      "id": 209,
      "start": 930.07,
      "end": 932.27,
      "duration": 2.199999999999932,
      "text": "前提是我们要做强自己"
    },
    {
      "id": 210,
      "start": 933.45,
      "end": 934.65,
      "duration": 1.1999999999999318,
      "text": "没有这份底气"
    },
    {
      "id": 211,
      "start": 935.25,
      "end": 938.83,
      "duration": 3.580000000000041,
      "text": "我们不足以承担这个重任 完不成这样一个使命和目标"
    },
    {
      "id": 212,
      "start": 939.97,
      "end": 940.93,
      "duration": 0.9599999999999227,
      "text": "而这一切"
    },
    {
      "id": 213,
      "start": 941.57,
      "end": 945.35,
      "duration": 3.7799999999999727,
      "text": "都在你们未来的工作 和实践当中得以实现"
    },
    {
      "id": 214,
      "start": 946.57,
      "end": 948.49,
      "duration": 1.919999999999959,
      "text": "所以我由衷地期待着大家"
    },
    {
      "id": 215,
      "start": 949.27,
      "end": 950.35,
      "duration": 1.080000000000041,
      "text": "不要忘记今天"
    },
    {
      "id": 216,
      "start": 950.95,
      "end": 952.81,
      "duration": 1.8599999999999,
      "text": "不要忘记这个伟大的时代"
    },
    {
      "id": 217,
      "start": 953.33,
      "end": 954.67,
      "duration": 1.3399999999999181,
      "text": "面向未来"
    },
    {
      "id": 218,
      "start": 955.37,
      "end": 956.61,
      "duration": 1.240000000000009,
      "text": "以史为鉴"
    },
    {
      "id": 219,
      "start": 957.21,
      "end": 960.13,
      "duration": 2.919999999999959,
      "text": "去做出交大人应有的贡献"
    },
    {
      "id": 220,
      "start": 963.42,
      "end": 964.3,
      "duration": 0.8799999999999955,
      "text": "俄罗斯"
    },
    {
      "id": 221,
      "start": 964.88,
      "end": 965.82,
      "duration": 0.9400000000000546,
      "text": "前苏联"
    },
    {
      "id": 222,
      "start": 967.62,
      "end": 970.42,
      "duration": 2.7999999999999545,
      "text": "奥斯陀罗夫斯基 写过一本书"
    },
    {
      "id": 223,
      "start": 971.28,
      "end": 973.2,
      "duration": 1.9200000000000728,
      "text": "叫《钢铁是怎样炼成的》"
    },
    {
      "id": 224,
      "start": 973.96,
      "end": 976.9,
      "duration": 2.939999999999941,
      "text": "他在这个书页的匪页上 有一段话"
    },
    {
      "id": 225,
      "start": 977.9,
      "end": 979.58,
      "duration": 1.6800000000000637,
      "text": "激励了很多年轻人"
    },
    {
      "id": 226,
      "start": 980.24,
      "end": 981.34,
      "duration": 1.1000000000000227,
      "text": "他是这样讲的"
    },
    {
      "id": 227,
      "start": 982.66,
      "end": 984.52,
      "duration": 1.8600000000000136,
      "text": "人的一生应该这样度过"
    },
    {
      "id": 228,
      "start": 985.2,
      "end": 986.86,
      "duration": 1.6599999999999682,
      "text": "当你回首往事的时候"
    },
    {
      "id": 229,
      "start": 987.54,
      "end": 989.72,
      "duration": 2.1800000000000637,
      "text": "不因虚度年华而悔恨"
    },
    {
      "id": 230,
      "start": 990.16,
      "end": 992.06,
      "duration": 1.8999999999999773,
      "text": "不因碌碌无为而羞耻"
    },
    {
      "id": 231,
      "start": 992.68,
      "end": 994.4,
      "duration": 1.7200000000000273,
      "text": "这样你就可以自豪地说"
    },
    {
      "id": 232,
      "start": 994.92,
      "end": 999.1,
      "duration": 4.180000000000064,
      "text": "我把我的一生 献给了人类最壮丽的事业"
    },
    {
      "id": 233,
      "start": 1000.54,
      "end": 1002.32,
      "duration": 1.7800000000000864,
      "text": "他是一个革命者"
    },
    {
      "id": 234,
      "start": 1003.9,
      "end": 1007.32,
      "duration": 3.4200000000000728,
      "text": "一个身残志坚的革命者 他把他的一生"
    },
    {
      "id": 235,
      "start": 1007.88,
      "end": 1009.76,
      "duration": 1.8799999999999955,
      "text": "献给了苏联的解放事业"
    },
    {
      "id": 236,
      "start": 1010.66,
      "end": 1016.34,
      "duration": 5.680000000000064,
      "text": "像这样的示例 在我们中国先辈当中 先烈当中 比比皆是"
    },
    {
      "id": 237,
      "start": 1017.6,
      "end": 1024.08,
      "duration": 6.4799999999999045,
      "text": "我希望大家记住 记住我们西迁的老前辈 记住我们党的前辈 记住那些"
    },
    {
      "id": 238,
      "start": 1024.08,
      "end": 1027.16,
      "duration": 3.0800000000001546,
      "text": "为我们今天的幸福生活 牺牲生命的先烈"
    },
    {
      "id": 239,
      "start": 1028.04,
      "end": 1029.32,
      "duration": 1.2799999999999727,
      "text": "接过他们的班"
    },
    {
      "id": 240,
      "start": 1030.08,
      "end": 1036.54,
      "duration": 6.460000000000036,
      "text": "骨气 志气 底气 在未来的事业当中 将伴随你们一生"
    },
    {
      "id": 241,
      "start": 1037.5,
      "end": 1043.2,
      "duration": 5.7000000000000455,
      "text": "牢牢记住我们的校训 牢牢记住总书记的嘱托"
    },
    {
      "id": 242,
      "start": 1043.2,
      "end": 1050.5,
      "duration": 7.2999999999999545,
      "text": "牢牢记住家国情怀 未来属于你们 我由衷地祝福大家"
    },
    {
      "id": 243,
      "start": 1050.5,
      "end": 1051.36,
      "duration": 0.8599999999999,
      "text": "谢谢各位！"
    }
  ]
}